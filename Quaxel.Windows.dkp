version = 1
references = ["Quaxel.dkp"]

[project]
name = "QuaxelWindows"
kind = "library"
build_dir = ".duck/build/windows"

[modules.quaxel_platform]
sources = ["Source/Platform/Api/**/*.dk", "Tests/Windows.dk"]
depends = ["quaxel_platform_backend"]

[modules.quaxel_engine]
sources = ["Source/Engine/**/*.dk", "Tests/EffectGpu.dk"]
depends = ["quaxel_core", "quaxel_platform"]

[modules.quaxel_platform_backend]
sources = ["Source/Platform/Windows/**/*.dk", "Tests/VoxelGpu.dk"]
libraries = ["Kernel32", "User32", ".duck/vulkan/vulkan-1.lib"]
