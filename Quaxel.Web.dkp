version = 1

[project]
name = "QuaxelWeb"
kind = "library"
build_dir = ".duck/build/web"

[modules.quaxel_platform]
sources = ["Source/Platform/Api/**/*.dk"]
depends = ["quaxel_platform_backend"]

[modules.quaxel_engine]
sources = ["Source/Engine/**/*.dk"]
depends = ["quaxel_core", "quaxel_platform"]

[modules.quaxel_platform_backend]
sources = ["Source/Platform/Web/Backend/*.dk"]
libraries = ["Source/Platform/Web/Browser.c"]

[modules.quaxel_core]
sources = ["Source/Core/**/*.dk", "Source/Platform/Web/Files.dk"]
