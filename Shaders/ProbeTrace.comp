#version 450
#extension GL_GOOGLE_include_directive : require
#define PROBE_TRACE
#include "VoxelShadowCommon.glsl"
#include "ProbeField.glsl"
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Frame { uint frame[]; };
layout(push_constant) uniform Params {
    mat4 worldFromClip;
    ivec2 extent;
    int uniformUpdates;
    int selecting;
    int casters;
    int lights;
    int tick;
} pc;
shared int candidates[64];
shared uint casterMask[8];
shared vec3 directions[64], radiance[64];
shared float distances[64];
uint hash(uint n) {
    n ^= n >> 16; n *= 0x7feb352du; n ^= n >> 15; n *= 0x846ca68bu; return n ^ (n >> 16);
}
int selectProbe(uint group) {
    uint seed = hash(group + uint(pc.tick)*64u);
    if (pc.uniformUpdates != 0) {
        int count = 0;
        for (int s=0; s<ROOTS; ++s) count += (roots[s].w & 1023);
        if (count == 0) return -1;
        int rank = int(seed % uint(count));
        for (int s=0; s<ROOTS; ++s) {
            if (rank < (roots[s].w & 1023)) return s*512 + rank;
            rank -= (roots[s].w & 1023);
        }
    }
    // Reserve eight of the existing batches for roots an actor entered or left.
    if (group < 8u) {
        for (int k=0; k<ROOTS; ++k) {
            int s = (int(seed & 511u) + k) & 511;
            if ((roots[s].w & 1024) != 0)
                return s*512 + int(hash(seed+1u)%uint(roots[s].w & 1023));
        }
    }
    // Sample the current G-buffer: larger visible surfaces receive more batches.
    int visible = -1;
    if (group < 56u) for (uint k=0u; k<8u; ++k) {
        uint h = hash(seed + k);
        ivec2 p = ivec2(h % uint(pc.extent.x), hash(h) % uint(pc.extent.y));
        int pixels = pc.extent.x * pc.extent.y, i = p.x + p.y * pc.extent.x;
        float z = uintBitsToFloat(frame[pixels+i]);
        if (z >= 1.0) continue;
        vec3 n = unpackSnorm4x8(frame[2*pixels+i]).xyz;
        vec2 xy = (vec2(p)+0.5)*2.0/vec2(pc.extent)-1.0;
        vec3 pos = (pc.worldFromClip*vec4(xy,z,1)).xyz;
        // Sample the same trilinear neighborhood as indirectLight.
        int level = float(hash(h+3u)&65535u)/65536.0 < lodWeight(pos,1.0) ? 0 : 1;
        float scale = level == 0 ? 1.0 : 4.0;
        vec3 grid = (pos + n*(0.16*scale))*(2.0/scale) - 0.5;
        uint bits = hash(h + 2u);
        vec3 jitter = vec3(bits & 1023u, (bits >> 10) & 1023u, (bits >> 20) & 1023u) / 1024.0;
        vec3 corner = step(jitter, fract(grid));
        int id = probeAt((floor(grid) + corner + 0.5)*(0.5*scale),level);
        if (id < 0) continue;
        visible = id;
        // Sixteen batches preferentially initialize visible probes with no history.
        if (group < 40u || floatBitsToUint(history[historySlot(id)*6].w) == 0u) return id;
    }
    if (visible >= 0) return visible;
    // Eight rotating groups cover every resident root in 64 frames.
    uint first = group >= 56u ? uint(pc.tick)*8u + group-56u : seed;
    for (int k=0; k<ROOTS; ++k) {
        int slot = (int(first & 511u) + k) & 511;
        if ((roots[slot].w & 1023) > 0) {
            uint ordinal = group >= 56u ? uint(pc.tick)/64u + hash(uint(slot)) : hash(seed+1u);
            return slot*512 + int(ordinal%uint((roots[slot].w & 1023)));
        }
    }
    return -1;
}
float firstHit(int g, vec3 start, vec3 dir, float limit) {
    vec3 normal,color;
    return probeHit(g,start,dir,limit,normal,color);
}
#include "SunVisibility.glsl"

vec3 shadeHit(vec3 p, vec3 n, vec3 color) {
    vec3 sun = sunDirection.xyz;
    vec3 start = p + n*SHADOW_OFFSET;
    float lit = max(dot(n,sun),0.0);
    if (lit > 0.0 && sunBlocked(start,sun,pc.casters)) lit=0.0;
    vec3 light = sunColor.rgb*lit;
    for (int i=0; i<pc.lights; ++i) {
        vec3 delta = lights[i].positionRadius.xyz - start;
        float d = length(delta), r=lights[i].positionRadius.w;
        if (d >= r || d < 0.001) continue;
        vec3 dir = -delta/d;
        if (lights[i].color.w > 0.0 && pc.casters > 0) {
            vec2 uv=abs(dir.xz)/dot(abs(dir),vec3(1));
            if (dir.y<0.0) uv=1.0-uv.yx;
            int wedge=(dir.x<0.0?1:0)+(dir.z<0.0?2:0);
            if (d > depthAtlas[shadowTexel(i,wedge,min(ivec2(uv*WEDGE_SIZE),ivec2(WEDGE_SIZE-1)))]+0.04) continue;
        }
        float edge=1.0-d*d/(r*r);
        light += lights[i].color.rgb*(max(dot(n,-dir),0.0)*edge*edge/(1.0+d*d));
    }
    return color*light;
}
void main() {
    int lane=int(gl_LocalInvocationID.x), group=int(gl_WorkGroupID.x);
    if (pc.selecting != 0) {
        int id = selectProbe(uint(lane));
        candidates[lane] = id;
        barrier();
        for (int i=0; i<lane; ++i) {
            if (candidates[i] == id) { id = -1; break; }
        }
        batches[lane].target.x = id;
        return;
    }
    int selected = batches[group].target.x;
    if (selected < 0) return;
    vec3 start = positions[selected].xyz;
    if (lane < 8) casterMask[lane] = 0u;
    barrier();
    for (int g=lane; g<pc.casters; g+=64) {
        int b=g*6;
        vec3 center=vec3(casterBounds[b],casterBounds[b+1],casterBounds[b+2]);
        vec3 halfSize=vec3(casterBounds[b+3],casterBounds[b+4],casterBounds[b+5]);
        vec3 gap=max(abs(start-center)-halfSize,vec3(0));
        if (halfSize.x < 0.0 || dot(gap,gap) <= 256.0)
            atomicOr(casterMask[g>>5],1u << (g&31));
    }
    barrier();
    // Deterministic quadrature at each world-space probe. A stationary scene
    // returns the same irradiance whenever the scheduler revisits this probe.
    ivec3 key = ivec3(round(positions[selected].xyz * 8.0));
    uint seed = hash(uint(key.x) ^ hash(uint(key.y)) ^ hash(uint(key.z) + 1u));
    float y=1.0-2.0*(float(lane)+0.5)/64.0;
    float phi=2.39996323*float(lane)+6.2831853*(float(seed&65535u)/65536.0);
    float radius=sqrt(max(0.0,1.0-y*y));
    vec3 dir=vec3(radius*cos(phi),y,radius*sin(phi));
    if ((seed&65536u)!=0u) dir=dir.yzx;
    // A character crossing a probe can cover its entire hemisphere for one
    // update. That sample would darken every receiver sharing the probe.
    float spacing = selected < 256*512 ? 0.5 : 2.0;
    float actorGuard = max(spacing,0.5*positions[selected].w);
    float nearest=16.0;
    vec3 normal=vec3(0), color=vec3(0);
    for (int word=0; word*32<pc.casters; ++word) {
        uint mask = casterMask[word];
        while (mask != 0u) {
            int g = word*32+findLSB(mask);
            vec3 n,c;
            float t=probeHit(g,start,dir,nearest,n,c);
            if (t < nearest && (casters[g].info.y == 0 || t >= actorGuard)) {
                nearest=t; normal=n; color=c;
            }
            mask &= mask-1u;
        }
    }
    directions[lane]=dir; distances[lane]=nearest;
    radiance[lane]=nearest<16.0 ? shadeHit(start+nearest*dir,normal,color) : mix(groundColor.rgb,skyColor.rgb,dir.y*0.5+0.5);
    barrier();
    if(lane<6) {
        vec3 sum=vec3(0); vec2 m=vec2(0); float w=0.0, wm=0.0;
        for(int k=0;k<64;++k) {
            float c=max(dot(faceDir(lane),directions[k]),0.0);
            sum+=c*radiance[k]; w+=c;
            float v=c*c*c*c, d=distances[k]; m+=v*vec2(d,d*d); wm+=v;
        }
        // Rays from inside an occupied voxel all hit at zero distance.
        batches[group].faces[lane]=m.y == 0.0 ? vec4(0) : vec4(sum/w,packMoments(m/wm));
    }
}
