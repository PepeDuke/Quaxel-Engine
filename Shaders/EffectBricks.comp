#version 450
#extension GL_GOOGLE_include_directive : require
// Rebuilds one effect's brick directory after drawing: a brick with any voxel
// points at its fixed payload, an empty one is 0 so the trace skips it.
layout(local_size_x=64) in;
#include "EffectCommon.glsl"

shared int occupied;

void main() {
    int brick = int(gl_WorkGroupID.x);
    if (gl_LocalInvocationID.x == 0) occupied = 0;
    barrier();
    int first = pc.base + BRICKS + brick * 512 + int(gl_LocalInvocationID.x) * 8;
    for (int i = 0; i < 8; ++i) {
        if (words[first + i] != 0) { atomicOr(occupied, 1); break; }
    }
    barrier();
    if (gl_LocalInvocationID.x == 0) words[pc.base + DIRECTORY + brick] = occupied != 0 ? BRICKS + brick * 512 : 0;
}
