#version 450
#extension GL_GOOGLE_include_directive : require
#include "ProbeField.glsl"
layout(local_size_x=6) in;
void main() {
    int g=int(gl_WorkGroupID.x), f=int(gl_LocalInvocationID.x), id=batches[g].target.x;
    if(id<0) return;
    int at=historySlot(id)*6+f;
    vec4 sampleFace=batches[g].faces[f];
    vec4 old=history[at];
    if (floatBitsToUint(old.w)==0u || floatBitsToUint(sampleFace.w)==0u) {
        history[at]=sampleFace;
        return;
    }
    history[at]=vec4(mix(old.rgb,sampleFace.rgb,0.18),
                     packMoments(mix(moments(old),moments(sampleFace),0.18)));
}
