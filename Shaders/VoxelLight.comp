#version 450
// Lights the frame that Voxel.comp traced. Each pixel holds albedo with
// ambient occlusion, depth and a world normal. Sunlight is tested with a
// shadow ray through every caster volume; ambient light blends from ground
// to sky with the normal and is darkened by the occlusion.
layout(local_size_x=8,local_size_y=8) in;
layout(push_constant) uniform Params {
    mat4 worldFromClip;
    ivec2 extent;
    int srgb;
    int bgra;
    int casters;  // Number of volumes that cast shadows; 0 turns shadows off.
} pc;
layout(set=0,binding=0,std430) buffer Output { uint frame[]; };
struct Caster {
    mat4 boxFromWorld;  // World to the volume's unit box, centred on 0.
    ivec4 info;         // x: first word of the volume in its buffer.
};
layout(set=1,binding=0,std430) readonly buffer Scene {
    vec4 sunDirection;  // Toward the sun, unit length.
    vec4 sunColor;
    vec4 skyColor;
    vec4 groundColor;
    Caster casters[];
};
const int MAX_CASTERS = 256;
layout(set=2,binding=0,std430) readonly buffer Grid { int words[]; } grids[MAX_CASTERS];

const int MASK_WORDS = 16;
const float FAR = 1e30;
// World units the shadow ray starts in front of the surface.
const float SHADOW_OFFSET = 0.002;
// Bounds the walk if rounding ever stalls it.
const int MAX_STEPS = 1024;

int mortonCell(ivec3 p) {
    ivec3 bits = (p & 1) | ((p & 2) << 2) | ((p & 4) << 4);
    return bits.x | (bits.y << 1) | (bits.z << 2);
}

ivec3 enteringCell(vec3 position, vec3 direction) {
    return ivec3(mix(floor(position), ceil(position) - 1.0, lessThan(direction, vec3(0))));
}

// True when the ray from `start` along `toward` meets a solid cell of caster g.
// The index is the same for every invocation that reaches a call, so it is
// dynamically uniform.
bool blocked(int g, vec3 start, vec3 toward) {
    int base = casters[g].info.x;
    ivec3 dims = ivec3(grids[g].words[base], grids[g].words[base + 1], grids[g].words[base + 2]);
    ivec3 bricks = (dims + 7) / 8;
    mat4 boxFromWorld = casters[g].boxFromWorld;
    vec3 origin = ((boxFromWorld * vec4(start, 1.0)).xyz + 0.5) * vec3(dims);
    vec3 dir = (mat3(boxFromWorld) * toward) * vec3(dims);
    ivec3 stepDir = ivec3(sign(dir));
    bvec3 parallel = equal(stepDir, ivec3(0));
    vec3 invDir = 1.0 / mix(dir, vec3(1.0), parallel);
    ivec3 positive = max(stepDir, ivec3(0));
    float t = 0.0, end = FAR;
    for (int a = 0; a < 3; ++a) {
        if (stepDir[a] == 0) {
            if (origin[a] < 0.0 || origin[a] >= float(dims[a])) return false;
        } else {
            float t0 = -origin[a] * invDir[a], t1 = (float(dims[a]) - origin[a]) * invDir[a];
            t = max(t, min(t0, t1));
            end = min(end, max(t0, t1));
        }
    }
    if (t >= end) return false;
    ivec3 cell = clamp(enteringCell(origin + t * dir, dir), ivec3(0), dims - 1);
    int steps = 0;
    while (all(greaterThanEqual(cell, ivec3(0))) && all(lessThan(cell, dims)) && steps < MAX_STEPS) {
        ivec3 brick = cell >> 3;
        int offset = grids[g].words[base + 3 + brick.x + bricks.x * (brick.y + bricks.y * brick.z)];
        ivec3 low = brick * 8;
        ivec3 edge = low + positive * 8;
        vec3 next = mix((vec3(edge) - origin) * invDir, vec3(FAR), parallel);
        float brickExit = min(next.x, min(next.y, next.z));
        if (offset != 0) {
            int at = base + offset;
            float stop = min(end, brickExit);
            vec3 tDelta = abs(invDir);
            vec3 tMax = mix((vec3(cell + positive) - origin) * invDir, vec3(FAR), parallel);
            ivec3 local = cell - low;
            while (all(greaterThanEqual(local, ivec3(0))) && all(lessThan(local, ivec3(8))) && steps < MAX_STEPS) {
                ++steps;
                int m = mortonCell(local);
                int word = grids[g].words[at + (m >> 5)];
                if (((word >> (m & 31)) & 1) != 0) return true;
                int size = 1;
                if (((word >> (m & 24)) & 255) == 0)
                    size = (word | grids[g].words[at + ((m >> 5) ^ 1)]) == 0 ? 4 : 2;
                if (size > 1) {
                    ivec3 blockLow = low + (local & ~(size - 1));
                    ivec3 blockEdge = blockLow + positive * size;
                    vec3 exits = mix((vec3(blockEdge) - origin) * invDir, vec3(FAR), parallel);
                    t = min(exits.x, min(exits.y, exits.z));
                    if (t >= stop) break;
                    ivec3 entered = clamp(enteringCell(origin + t * dir, dir), blockLow, blockLow + size - 1);
                    entered = mix(entered, blockEdge + min(stepDir, ivec3(0)), equal(exits, vec3(t)));
                    local = entered - low;
                    tMax = mix((vec3(entered + positive) - origin) * invDir, vec3(FAR), parallel);
                    continue;
                }
                t = min(tMax.x, min(tMax.y, tMax.z));
                if (t >= stop) break;
                bvec3 crossedCell = equal(tMax, vec3(t));
                local += mix(ivec3(0), stepDir, crossedCell);
                tMax += mix(vec3(0.0), tDelta, crossedCell);
            }
        }
        ++steps;
        t = brickExit;
        if (t >= end) break;
        cell = clamp(enteringCell(origin + t * dir, dir), low, low + 7);
        cell = mix(cell, edge + min(stepDir, ivec3(0)), equal(next, vec3(t)));
    }
    return false;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, pc.extent))) return;
    int pixels = pc.extent.x * pc.extent.y;
    int index = pixel.x + pc.extent.x * pixel.y;
    float depth = uintBitsToFloat(frame[index + pixels]);
    if (depth >= 1.0) return;  // Background keeps its clear color.
    uint packed = frame[index];
    vec3 albedo = vec3((packed >> 16) & 255u, (packed >> 8) & 255u, packed & 255u) / 255.0;
    float ao = float(packed >> 24) / 255.0;
    vec3 n = unpackSnorm4x8(frame[index + 2 * pixels]).xyz;
    n = dot(n, n) > 0.01 ? normalize(n) : vec3(0.0, 1.0, 0.0);
    vec2 xy = (vec2(pixel) + 0.5) * (2.0 / vec2(pc.extent)) - 1.0;
    vec3 world = (pc.worldFromClip * vec4(xy, depth, 1.0)).xyz;

    vec3 sun = sunDirection.xyz;
    float lambert = max(dot(n, sun), 0.0);
    float lit = 0.0;
    if (lambert > 0.0) {
        lit = 1.0;
        vec3 start = world + n * SHADOW_OFFSET;
        for (int g = 0; g < pc.casters; ++g) {
            if (blocked(g, start, sun)) { lit = 0.0; break; }
        }
    }
    vec3 ambient = mix(groundColor.rgb, skyColor.rgb, n.y * 0.5 + 0.5);
    vec3 light = sunColor.rgb * (lambert * lit * mix(1.0, ao, 0.35)) + ambient * ao;
    vec3 linear = clamp(albedo * light, 0.0, 1.0);
    vec3 encoded = linear;
    if (pc.srgb != 0)
        encoded = mix(12.92 * linear, 1.055 * pow(linear, vec3(1.0/2.4)) - 0.055,
                      greaterThan(linear, vec3(0.0031308)));
    frame[index] = packUnorm4x8(vec4(pc.bgra != 0 ? encoded.bgr : encoded, 1));
}
