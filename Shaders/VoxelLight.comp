#version 450
#extension GL_GOOGLE_include_directive : require
// Lights the frame that Voxel.comp traced. Each pixel holds albedo with
// ambient occlusion, depth and a world normal. Sunlight uses world-chunk shadow depths; ambient light blends from ground
// to sky with the normal and is darkened by the occlusion.
layout(local_size_x=8,local_size_y=8) in;
layout(push_constant) uniform Params {
    mat4 worldFromClip;
    ivec2 extent;
    int srgb;
    int bgra;
    int casters;  // Number of volumes that cast shadows; 0 turns shadows off.
    int lights;
    int gi;
} pc;
layout(set=0,binding=0,std430) buffer Output { uint frame[]; };
#include "VoxelShadowCommon.glsl"
#include "ProbeField.glsl"
#include "SunVisibility.glsl"
#include "ProbeMarkers.glsl"

vec4 gatherIndirect(vec3 p,vec3 n,int level) {
    float scale = level == 0 ? 1.0 : 4.0;
    vec3 samplePos=p+n*(0.16*scale), total=vec3(0);
    float weights=0.0, support=0.0;
    // Gather neighboring adaptive leaves around the surface. Angular moments
    // reduce the contribution of probes separated from the receiver by geometry.
    vec3 grid=samplePos*(2.0/scale)-0.5, blend=fract(grid);
    for(int i=0;i<8;++i) {
        vec3 corner=vec3(i&1,(i>>1)&1,(i>>2)&1);
        vec3 tent=mix(1.0-blend,blend,corner);
        int id=probeAt((floor(grid)+corner+0.5)*(0.5*scale),level);
        if(id<0) continue;
        vec3 d=p-positions[id].xyz; float dist=max(length(d),0.001); vec3 dir=d/dist;
        int base=historySlot(id)*6;
        vec3 light=vec3(0); vec2 m=vec2(0); float sum=0.0;
        for(int k=0;k<3;++k) {
            vec4 v=history[base+k*2+(n[k]<0.0?1:0)];
            if(floatBitsToUint(v.w)==0u) continue;
            light+=v.rgb*n[k]*n[k]; sum+=n[k]*n[k];
            m+=moments(history[base+k*2+(dir[k]<0.0?1:0)])*dir[k]*dir[k];
        }
        if(sum<0.5) continue;
        float variance=max(m.y-m.x*m.x,0.0025);
        float error=max(dist-m.x-0.04,0.0);
        float vis=variance/(variance+error*error);
        float facing=max(dot(-dir,n),0.0);
        float cornerWeight=tent.x*tent.y*tent.z;
        // Fade to the next level as the last usable corners leave the footprint.
        support+=cornerWeight*smoothstep(0.0,0.1,facing)*smoothstep(0.0,0.1,vis);
        float w=cornerWeight*vis*vis*vis*facing/(0.1+dist*dist/(scale*scale));
        total+=w*light;weights+=w;
    }
    // Visibility ranks contributing probes. A weak weight alone is not sky exposure.
    if (weights <= 0.0) return vec4(0);
    return vec4(total/weights,smoothstep(0.0,0.25,support));
}

vec3 indirectLight(vec3 p,vec3 n,vec3 ambient,out vec3 weights) {
    float nearWeight = lodWeight(p,1.0);
    vec4 fine = vec4(0);
    if (nearWeight > 0.0) fine = gatherIndirect(p,n,0);
    float fineWeight = nearWeight*fine.a;
    float farWeight = lodWeight(p,4.0);
    weights = vec3(fineWeight,0,1.0-fineWeight);
    if (fineWeight < 1.0 && farWeight > 0.0) {
        vec4 coarse = gatherIndirect(p,n,1);
        float coarseWeight = farWeight*coarse.a;
        ambient = mix(ambient,coarse.rgb,coarseWeight);
        weights.y = (1.0-fineWeight)*coarseWeight;
        weights.z *= 1.0-coarseWeight;
    }
    return mix(ambient,fine.rgb,fineWeight);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, pc.extent))) return;
    int pixels = pc.extent.x * pc.extent.y;
    int index = pixel.x + pc.extent.x * pixel.y;
    float depth = uintBitsToFloat(frame[index + pixels]);
    vec2 xy = (vec2(pixel) + 0.5) * (2.0 / vec2(pc.extent)) - 1.0;
    if (pc.gi != 0 && focus.w == 2.0) {
        vec3 origin = (pc.worldFromClip * vec4(xy,0,1)).xyz;
        vec3 ray = pc.worldFromClip[2].xyz;
        float closest = depth*length(ray);
        vec3 direction = normalize(ray);
        bool fine = probeMarker(origin,direction,0,closest);
        bool coarse = probeMarker(origin,direction,1,closest);
        if (fine || coarse) {
            vec3 color = coarse ? vec3(1.0,0.55,0.06) : vec3(0.1,0.95,1.0);
            frame[index] = packUnorm4x8(vec4(pc.bgra != 0 ? color.bgr : color,1));
            return;
        }
    }
    if (depth >= 1.0) return;  // Background keeps its clear color.
    uint packed = frame[index];
    vec3 albedo = vec3((packed >> 16) & 255u, (packed >> 8) & 255u, packed & 255u) / 255.0;
    float ao = float(packed >> 24) / 255.0;
    vec3 n = unpackSnorm4x8(frame[index + 2 * pixels]).xyz;
    n = dot(n, n) > 0.01 ? normalize(n) : vec3(0.0, 1.0, 0.0);
    vec3 world = (pc.worldFromClip * vec4(xy, depth, 1.0)).xyz;

    vec3 sun = sunDirection.xyz;
    float lambert = max(dot(n, sun), 0.0);
    float lit = 0.0;
    if (lambert > 0.0) {
        lit = 1.0;
        vec3 start = world + n * SHADOW_OFFSET;
        if (sunBlocked(start, sun, pc.casters)) lit = 0.0;
    }
    vec3 ambient = mix(groundColor.rgb, skyColor.rgb, n.y * 0.5 + 0.5);
    if (pc.gi != 0) {
        if (lambert > 0.0 && lit == 0.0) ambient = min(groundColor.rgb,ambient);
        vec3 weights;
        ambient = indirectLight(world,n,ambient,weights);
        if (focus.w == 1.0 || focus.w == 3.0) {
            vec3 debugColor = focus.w == 1.0 ? vec3(weights.z) :
                weights.x*vec3(0.1,0.95,1.0) + weights.y*vec3(1.0,0.55,0.06) + weights.z*vec3(0.8,0.05,0.65);
            frame[index] = packUnorm4x8(vec4(pc.bgra != 0 ? debugColor.bgr : debugColor,1));
            return;
        }
    }
    vec3 light = sunColor.rgb * (lambert * lit * mix(1.0, ao, 0.35)) + ambient * ao;
    for (int i = 0; i < pc.lights; ++i) {
        vec3 delta = lights[i].positionRadius.xyz - world;
        float radius = lights[i].positionRadius.w;
        float d2 = dot(delta, delta);
        if (d2 >= radius * radius) continue;
        float edge = 1.0 - d2 / (radius * radius);
        float facing = max(dot(n, delta), 0.0) * inversesqrt(max(d2, 0.0001));
        if (facing <= 0.0) continue;
        if (lights[i].color.w > 0.0 && pc.casters > 0) {
            // Parameterize the segment so t=1 reaches the emitter exactly.
            vec3 start = world + n * SHADOW_OFFSET;
            vec3 segment = lights[i].positionRadius.xyz - start;
            bool shadow = false;
            if (dot(segment, n) > 0.0) {
                vec3 fromLight = -segment;
                vec2 uv = abs(fromLight.xz) / dot(abs(fromLight), vec3(1.0));
                if (fromLight.y < 0.0) uv = 1.0 - uv.yx;
                int wedge = (fromLight.x < 0.0 ? 1 : 0) + (fromLight.z < 0.0 ? 2 : 0);
                vec2 center = uv * WEDGE_SIZE - 0.5;
                ivec2 p = ivec2(floor(center));
                float distance = length(segment);
                // At wedge seams, silhouettes and near-coincident surfaces resolve the actual segment.
                bool resolve = any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, ivec2(WEDGE_SIZE - 1)));
                if (!resolve) {
                    int at = shadowTexel(i, wedge, p);
                    vec2 a = vec2(depthAtlas[at], depthAtlas[at + 1]);
                    vec2 b = vec2(depthAtlas[at + WEDGE_SIZE], depthAtlas[at + WEDGE_SIZE + 1]);
                    float closest = min(min(a.x, a.y), min(b.x, b.y));
                    float farthest = max(max(a.x, a.y), max(b.x, b.y));
                    float tolerance = distance * (4.0 / WEDGE_SIZE) + SHADOW_OFFSET;
                    resolve = distance >= closest - tolerance && distance <= farthest + tolerance;
                    shadow = distance > farthest;
                }
                if (resolve) {
                    shadow = false;
                    for (int w = 0; w * 32 < pc.casters && !shadow; ++w) {
                        uint mask = lights[i].casterMask[w >> 2][w & 3];
                        while (mask != 0u) {
                            int g = w * 32 + findLSB(mask);
                            if (firstHit(g, start, segment, 1.0) < 1.0) { shadow = true; break; }
                            mask &= mask - 1u;
                        }
                    }
                }
            }
            if (shadow) continue;
        }
        light += lights[i].color.rgb * (facing * edge * edge / (1.0 + d2));
    }
    vec3 linear = clamp(albedo * light, 0.0, 1.0);
    vec3 encoded = linear;
    if (pc.srgb != 0)
        encoded = mix(12.92 * linear, 1.055 * pow(linear, vec3(1.0/2.4)) - 0.055,
                      greaterThan(linear, vec3(0.0031308)));
    frame[index] = packUnorm4x8(vec4(pc.bgra != 0 ? encoded.bgr : encoded, 1));
}
