QuaxelPlatform
#{
    // Reports whether a key is held. Key codes use QuaxelKey values. Held keys
    // are cleared when the window loses focus. Headless builds report none held.
    bool IsKeyDown(int key)
    {
        return key >= 0 && key < 256 && QuaxelPlatformBackend.IsKeyDown(key)
    }

    // Reads the last mouse position in client pixels. Clears both on failure.
    bool GetMousePosition(int& x, int& y) { return QuaxelPlatformBackend.GetMousePosition(x, y) }

    // Reports the left button, which is released when the window loses focus.
    bool IsMouseButtonDown() { return QuaxelPlatformBackend.IsMouseButtonDown() }

    // Reports the right button, which is also released when the window loses focus.
    bool IsRightMouseButtonDown() { return QuaxelPlatformBackend.IsRightMouseButtonDown() }
}
