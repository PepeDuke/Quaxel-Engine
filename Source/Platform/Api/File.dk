QuaxelPlatform
#{
    // Opens a file for reading. Returns null if it cannot be opened.
    void* OpenFile(string path) { return QuaxelPlatformBackend.OpenFile(path) }

    // Reads up to byteCount bytes. Returns how many arrived, or 0 at the end.
    int ReadFile(void* file, void* buffer, int byteCount)
    {
        return QuaxelPlatformBackend.ReadFile(file, buffer, byteCount)
    }

    CloseFile(void* file) { QuaxelPlatformBackend.CloseFile(file) }
}
