QuaxelRenderer
#{
    bool Start() { return QuaxelPlatformBackend.StartRenderer() }

    // Upload before opening the frame. Pass -1 for new storage or a handle to replace.
    // Unmap before dispatch. All handles expire when the renderer stops.
    int MapVolume(int previous, int words, void*& mapped) { return QuaxelPlatformBackend.MapVolume(previous, words, mapped) }
    UnmapVolume(int handle) { QuaxelPlatformBackend.UnmapVolume(handle) }
    bool BeginVoxelFrame() { return QuaxelPlatformBackend.BeginVoxelFrame() }
    // The light values are the brightness of faces along the volume's X, Y and Z axes.
    bool TraceVolume(int handle, void* boxFromClip, float left, float top, float right, float bottom, float lightX, float lightY, float lightZ)
    {
        return QuaxelPlatformBackend.TraceVolume(handle, boxFromClip, left, top, right, bottom, lightX, lightY, lightZ)
    }

    // GPU effects. Each effect owns a slot in a persistent page buffer of eight
    // slots. Create pages before opening the frame; the rest is recorded into
    // the open frame, in the order Reset (once), WriteParams, Bake (once per
    // overlapping volume), Simulate (once per fixed step), Draw, Trace.
    bool EnsureEffectPages(int pages) { return QuaxelPlatformBackend.EnsureEffectPages(pages) }
    bool ResetEffect(int slot) { return QuaxelPlatformBackend.ResetEffect(slot) }
    bool WriteEffectParams(int slot, void* data, int bytes) { return QuaxelPlatformBackend.WriteEffectParams(slot, data, bytes) }
    // Matrix maps slot cell coordinates to the volume's grid coordinates.
    bool BakeEffect(int slot, int volume, void* matrix, int cellsX, int cellsY, int cellsZ)
    {
        return QuaxelPlatformBackend.BakeEffect(slot, volume, matrix, cellsX, cellsY, cellsZ)
    }
    bool SimulateEffect(int slot, int step, float seconds) { return QuaxelPlatformBackend.SimulateEffect(slot, step, seconds) }
    bool DrawEffect(int slot, int tick) { return QuaxelPlatformBackend.DrawEffect(slot, tick) }
    bool TraceEffect(int slot, void* boxFromClip, float left, float top, float right, float bottom, float lightX, float lightY, float lightZ)
    {
        return QuaxelPlatformBackend.TraceEffect(slot, boxFromClip, left, top, right, bottom, lightX, lightY, lightZ)
    }
    // Waits for the GPU and copies a slot's first words out. For tests; call
    // outside a frame.
    bool ReadEffectSlot(int slot, int words, void* destination) { return QuaxelPlatformBackend.ReadEffectSlot(slot, words, destination) }

    // Blends a rectangle over the frame, after its volumes. Color is 0xAARRGGBB
    // in display values. With a positive cell, draws a 5 x 7 glyph at that pixel
    // scale: glyphFirst holds columns 0..3, one byte each, and glyphLast column 4.
    // With a negative cell, draws an atlas sprite at that pixel scale: glyphFirst
    // is the sprite's first texel and glyphLast the atlas width.
    bool DrawUi(int x, int y, int width, int height, uint color, uint glyphFirst, uint glyphLast, int cell)
    {
        return QuaxelPlatformBackend.DrawUi(x, y, width, height, color, glyphFirst, glyphLast, cell)
    }

    // Replaces the sprite atlas. Upload before opening the frame, and unmap before drawing.
    bool MapUiAtlas(int words, void*& mapped) { return QuaxelPlatformBackend.MapUiAtlas(words, mapped) }
    UnmapUiAtlas() { QuaxelPlatformBackend.UnmapUiAtlas() }

    // Low-level graphics API for callers submitting explicit triangle geometry.
    int CreateMesh(void* vertices, int vertexCount, void* indices, int indexCount)
    {
        return QuaxelPlatformBackend.CreateMesh(vertices, vertexCount, indices, indexCount)
    }

    // Matrices point at 16 column-major floats and are read during the call.
    // A frame that cannot be presented yet is skipped: every call still succeeds.
    bool BeginFrame(void* viewProjection) { return QuaxelPlatformBackend.BeginFrame(viewProjection) }
    bool DrawMesh(int mesh, void* model) { return QuaxelPlatformBackend.DrawMesh(mesh, model) }
    bool EndFrame() { return QuaxelPlatformBackend.EndFrame() }

    Stop() { QuaxelPlatformBackend.StopRenderer() }
}
