// Public, platform-neutral services. Native types and declarations stay in backends.
QuaxelPlatform
#{
    bool SupportsWindowing()
    {
        return QuaxelPlatformBackend.SupportsWindowing()
    }

    // Failure always returns zero so callers cannot reuse stale clock values.
    bool GetClockFrequency(long& frequency)
    {
        long value = 0
        bool valid = QuaxelPlatformBackend.GetClockFrequency(value) && value > 0
        frequency = valid ? value | 0
        return valid
    }

    bool ReadClock(long& ticks)
    {
        long value = 0
        bool valid = QuaxelPlatformBackend.ReadClock(value) && value >= 0
        ticks = valid ? value | 0
        return valid
    }
}
