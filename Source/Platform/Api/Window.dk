QuaxelPlatform
#{
    // One main window per process. Call all window services on its owning thread.
    bool OpenWindow(string title, int width, int height, bool visible)
    {
        return QuaxelPlatformBackend.OpenWindow(title, width, height, visible)
    }

    bool GetWindowSize(int& width, int& height)
    {
        return QuaxelPlatformBackend.GetWindowSize(width, height)
    }

    bool ResizeWindow(int width, int height)
    {
        return QuaxelPlatformBackend.ResizeWindow(width, height)
    }

    // Wait for input when idle, or poll without blocking during simulation.
    // Returns false once the window has closed.
    bool PumpWindow(bool wait)
    {
        return QuaxelPlatformBackend.PumpWindow(wait)
    }

    // Called from inside PumpWindow when the window needs a new frame during a
    // live resize, while the normal loop is blocked.
    SetRedrawHandler(func () handler) { QuaxelPlatformBackend.SetRedrawHandler(handler) }
    ClearRedrawHandler() { QuaxelPlatformBackend.ClearRedrawHandler() }

    // True once after the window blocked the loop, such as a border drag.
    // Elapsed time across that gap should not be simulated.
    bool ConsumeWindowStall() { return QuaxelPlatformBackend.ConsumeWindowStall() }

    bool RequestWindowClose() { return QuaxelPlatformBackend.RequestWindowClose() }
    CloseWindow() { QuaxelPlatformBackend.CloseWindow() }
}
