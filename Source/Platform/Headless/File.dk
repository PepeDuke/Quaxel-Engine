// Standard C file access, so assets load in any build that has a C runtime.
QuaxelPlatformBackend
#{
    extern "C" void* fopen(name path, name mode)
    extern "C" long fread(void* buffer, long itemSize, long itemCount, void* file)
    extern "C" int fclose(void* file)

    void* OpenFile(string path) { return fopen((name)path, "rb") }

    int ReadFile(void* file, void* buffer, int byteCount)
    {
        return (int)fread(buffer, 1, (long)byteCount, file)
    }

    CloseFile(void* file) { fclose(file) }
}
