QuaxelVulkan
#{
    -ReleaseTargets()
    {
        int i = 0
        while i < ImageCount {
            Vk.DestroyFramebuffer(Device, Images.Targets[i], null)
            Vk.DestroyImageView(Device, Images.Views[i], null)
            Vk.DestroySemaphore(Device, Images.Finished[i], null)
            Images.Targets[i] = 0
            Images.Views[i] = 0
            Images.Finished[i] = 0
            i++
        }
        Vk.DestroyPipeline(Device, Pipeline, null)
        Vk.DestroyPipelineLayout(Device, Layout, null)
        Vk.DestroyRenderPass(Device, Pass, null)
        Vk.DestroySwapchainKHR(Device, Chain, null)
        Pipeline = 0
        Layout = 0
        Pass = 0
        Chain = 0
        ImageCount = 0
    }

    -bool SelectFormat(VkSurfaceFormatKHR& selected)
    {
        VkSurfaceFormatKHR [128] formats
        int count = (int)formats.Len
        int result = Vk.GetPhysicalDeviceSurfaceFormatsKHR(Physical, Surface, &count, &formats[0])
        if count == 0 || (result != 0 && result != 5) { return false }
        selected = formats[0]
        for i : 0...count-1 {
            if formats[i].vkFormat == 50 && formats[i].colorSpace == 0 { // BGRA8_SRGB
                selected = formats[i]
                break
            }
        }
        if selected.vkFormat == 0 { selected.vkFormat = 50 } // VK_FORMAT_UNDEFINED
        return true
    }

    -bool CreateTargets(int width, int height)
    {
        VkSurfaceCapabilitiesKHR caps
        if Vk.GetPhysicalDeviceSurfaceCapabilitiesKHR(Physical, Surface, &caps) != 0 { return false }
        VkSurfaceFormatKHR selected
        if !SelectFormat(selected) { return false }
        Extent = caps.currentExtent
        if Extent.width == -1 {
            Extent.width = width
            Extent.height = height
            if width < caps.minImageExtent.width { Extent.width = caps.minImageExtent.width }
            if width > caps.maxImageExtent.width { Extent.width = caps.maxImageExtent.width }
            if height < caps.minImageExtent.height { Extent.height = caps.minImageExtent.height }
            if height > caps.maxImageExtent.height { Extent.height = caps.maxImageExtent.height }
        }
        if Extent.width == 0 || Extent.height == 0 { return true }
        Format = selected.vkFormat
        VkSwapchainCreateInfoKHR info
        info.surface = Surface
        info.minImageCount = caps.minImageCount + 1
        if caps.maxImageCount != 0 && info.minImageCount > caps.maxImageCount { info.minImageCount = caps.maxImageCount }
        info.imageFormat = Format
        info.imageColorSpace = selected.colorSpace
        info.imageExtent = Extent
        info.imageArrayLayers = 1
        info.imageUsage = 16 // COLOR_ATTACHMENT
        info.preTransform = caps.currentTransform
        info.compositeAlpha = caps.supportedCompositeAlpha & (0 - caps.supportedCompositeAlpha)
        info.presentMode = 2 // FIFO
        info.clipped = 1
        int result = Vk.CreateSwapchainKHR(Device, &info, null, &Chain)
        if result == -1000001004 { return true } // Surface changed again during resize.
        if result != 0 { return false }
        long [32] handles
        int count = (int)handles.Len
        if Vk.GetSwapchainImagesKHR(Device, Chain, &count, &handles[0]) != 0 || count == 0 { return false }
        ImageCount = count
        if !CreatePass() || !CreatePipeline() { return false }
        for i : 0...count-1 {
            VkImageViewCreateInfo view
            view.image = handles[i]
            view.viewType = 1 // 2D
            view.vkFormat = Format
            view.subresourceRange.aspectMask = 1
            view.subresourceRange.levelCount = 1
            view.subresourceRange.layerCount = 1
            if Vk.CreateImageView(Device, &view, null, &Images.Views[i]) != 0 { return false }
            VkFramebufferCreateInfo framebuffer
            framebuffer.renderPass = Pass
            framebuffer.attachmentCount = 1
            framebuffer.pAttachments = &Images.Views[i]
            framebuffer.width = Extent.width
            framebuffer.height = Extent.height
            framebuffer.layers = 1
            if Vk.CreateFramebuffer(Device, &framebuffer, null, &Images.Targets[i]) != 0 { return false }
            VkSemaphoreCreateInfo sem
            if Vk.CreateSemaphore(Device, &sem, null, &Images.Finished[i]) != 0 { return false }
        }
        return true
    }
}
