QuaxelVulkan
#{
    -bool CreatePass()
    {
        VkAttachmentDescription color
        color.vkFormat = Format
        color.samples = 1
        color.loadOp = 1 // CLEAR
        color.stencilLoadOp = 2 // DONT_CARE
        color.stencilStoreOp = 1
        color.finalLayout = 1000001002 // PRESENT_SRC_KHR
        VkAttachmentReference reference
        reference.vkLayout = 2 // COLOR_ATTACHMENT_OPTIMAL
        VkSubpassDescription subpass
        subpass.colorAttachmentCount = 1
        subpass.pColorAttachments = &reference

        VkSubpassDependency dependency
        dependency.srcSubpass = -1 // VK_SUBPASS_EXTERNAL
        dependency.srcStageMask = 0x400 // COLOR_ATTACHMENT_OUTPUT
        dependency.dstStageMask = 0x400
        dependency.dstAccessMask = 0x100 // COLOR_ATTACHMENT_WRITE
        VkRenderPassCreateInfo info
        info.attachmentCount = 1
        info.pAttachments = &color
        info.subpassCount = 1
        info.pSubpasses = &subpass
        info.dependencyCount = 1
        info.pDependencies = &dependency
        return Vk.CreateRenderPass(Device, &info, null, &Pass) == 0
    }

    -bool BuildPipeline(long vertexShader, long fragmentShader)
    {
        VkPipelineShaderStageCreateInfo [2] stages
        stages[0].vkStage = 1 // VERTEX
        stages[0].vkModule = vertexShader
        stages[0].pName = "main"
        stages[1].vkStage = 16 // FRAGMENT
        stages[1].vkModule = fragmentShader
        stages[1].pName = "main"
        VkPipelineVertexInputStateCreateInfo vertexInput
        VkPipelineInputAssemblyStateCreateInfo assembly
        assembly.topology = 3 // TRIANGLE_LIST
        VkViewport viewport
        viewport.width = (float)Extent.width
        viewport.height = (float)Extent.height
        viewport.maxDepth = 1.0
        VkRect2D scissor
        scissor.extent = Extent
        VkPipelineViewportStateCreateInfo viewportState
        viewportState.viewportCount = 1
        viewportState.pViewports = &viewport
        viewportState.scissorCount = 1
        viewportState.pScissors = &scissor
        VkPipelineRasterizationStateCreateInfo raster
        raster.lineWidth = 1.0
        VkPipelineMultisampleStateCreateInfo sampling
        sampling.rasterizationSamples = 1
        VkPipelineColorBlendAttachmentState attachment
        attachment.colorWriteMask = 15 // RGBA
        VkPipelineColorBlendStateCreateInfo blend
        blend.attachmentCount = 1
        blend.pAttachments = &attachment
        VkGraphicsPipelineCreateInfo info
        info.stageCount = 2
        info.pStages = &stages[0]
        info.pVertexInputState = &vertexInput
        info.pInputAssemblyState = &assembly
        info.pViewportState = &viewportState
        info.pRasterizationState = &raster
        info.pMultisampleState = &sampling
        info.pColorBlendState = &blend
        info.vkLayout = Layout
        info.renderPass = Pass
        return Vk.CreateGraphicsPipelines(Device, 0, 1, &info, null, &Pipeline) == 0
    }

    -bool CreatePipeline()
    {
        VkPipelineLayoutCreateInfo info
        if Vk.CreatePipelineLayout(Device, &info, null, &Layout) != 0 { return false }
        long vertex = TriangleShaders.Vertex(Device)
        long fragment = TriangleShaders.Fragment(Device)
        bool ready = vertex != 0 && fragment != 0 && BuildPipeline(vertex, fragment)
        Vk.DestroyShaderModule(Device, fragment, null)
        Vk.DestroyShaderModule(Device, vertex, null)
        return ready
    }
}
