VkStorage
{
    long Buffer
    long Memory
    long Pool
    long Descriptor
}

VkVolumeBuffers
{
    VkStorage [4096] Items
    int Count
}

VkVoxelParams
{
    float [16] Matrix
    int Width
    int Height
    int StartX
    int StartY
    // First word of the volume in its buffer: 0, or an effect slot in a page.
    int Base
    // World normals of the box's +X, +Y and +Z faces.
    float [9] Axes
}

// Push constants of Shaders/VoxelLight.comp.
VkLightParams
{
    float [16] Matrix
    int Width
    int Height
    int Srgb
    int Bgra
    int Casters
}

// The Scene buffer of Shaders/VoxelLight.comp: 16 words of sun and sky
// colors, then 20 words per caster (its world-to-box matrix and first word).
VkLightScene
{
    int [5136] Words
}

VkUiParams
{
    int Width
    int Height
    int X
    int Y
    int RectWidth
    int RectHeight
    uint Color
    uint GlyphFirst
    uint GlyphLast
    int Cell
    int Bgra
}

QuaxelVulkan
#{
    -long StorageLayout
    -long ComputeLayout
    -long ComputePipeline
    -VkVolumeBuffers Volumes
    -VkStorage Output
    -bool ComputeFrame
    -long UiLayout
    -long UiPipeline
    -bool UiBound
    -VkStorage UiAtlas
    -long CasterLayout
    -long CasterPool
    -long CasterSet
    -long LightLayout
    -long LightPipeline
    -bool LightBound
    -VkStorage SceneStorage
    -VkLightScene Scene
    -long [256] CasterBuffers
    -int CasterCount
    #int MaxCasters = 256

    -bool CreateComputePipeline()
    {
        VkDescriptorSetLayoutBinding binding
        VkDescriptorSetLayoutCreateInfo descriptor
        descriptor.pBindings = &binding
        if Vk.CreateDescriptorSetLayout(Device, &descriptor, null, &StorageLayout) != 0 { return false }
        long [2] sets = {StorageLayout, StorageLayout}
        VkPushConstantRange params
        params.stageFlags = 32
        params.vkSize = 120
        VkPipelineLayoutCreateInfo layout
        layout.setLayoutCount = 2
        layout.pSetLayouts = &sets[0]
        layout.pushConstantRangeCount = 1
        layout.pPushConstantRanges = &params
        if Vk.CreatePipelineLayout(Device, &layout, null, &ComputeLayout) != 0 { return false }
        long shader = VoxelShaders.Compute(Device)
        if shader == 0 { return false }
        VkComputePipelineCreateInfo info
        info.vkStage.vkStage = 32
        info.vkStage.vkModule = shader
        info.vkStage.pName = "main"
        info.vkLayout = ComputeLayout
        int result = Vk.CreateComputePipelines(Device, 0, 1, &info, null, &ComputePipeline)
        Vk.DestroyShaderModule(Device, shader, null)
        return result == 0 && CreateUiPipeline() && CreateEffectPipelines() && CreateLightPipeline()
    }

    -bool CreateLightPipeline()
    {
        VkDescriptorSetLayoutBinding binding
        binding.descriptorCount = MaxCasters
        VkDescriptorSetLayoutCreateInfo descriptor
        descriptor.pBindings = &binding
        if Vk.CreateDescriptorSetLayout(Device, &descriptor, null, &CasterLayout) != 0 { return false }
        VkDescriptorPoolSize size
        size.descriptorCount = MaxCasters
        VkDescriptorPoolCreateInfo pool
        pool.pPoolSizes = &size
        if Vk.CreateDescriptorPool(Device, &pool, null, &CasterPool) != 0 { return false }
        VkDescriptorSetAllocateInfo setInfo
        setInfo.descriptorPool = CasterPool
        setInfo.pSetLayouts = &CasterLayout
        if Vk.AllocateDescriptorSets(Device, &setInfo, &CasterSet) != 0 { return false }
        // TRANSFER_DST, device local: rewritten by CmdUpdateBuffer each frame.
        VkStorage scene
        if !CreateStorage((long)Scene.Words.Len * 4, 2, 1, scene) { return false }
        SceneStorage = scene
        long [3] sets = {StorageLayout, StorageLayout, CasterLayout}
        VkPushConstantRange params
        params.stageFlags = 32
        params.vkSize = 84
        VkPipelineLayoutCreateInfo layout
        layout.setLayoutCount = 3
        layout.pSetLayouts = &sets[0]
        layout.pushConstantRangeCount = 1
        layout.pPushConstantRanges = &params
        if Vk.CreatePipelineLayout(Device, &layout, null, &LightLayout) != 0 { return false }
        long shader = VoxelLightShaders.Compute(Device)
        if shader == 0 { return false }
        VkComputePipelineCreateInfo info
        info.vkStage.vkStage = 32
        info.vkStage.vkModule = shader
        info.vkStage.pName = "main"
        info.vkLayout = LightLayout
        int result = Vk.CreateComputePipelines(Device, 0, 1, &info, null, &LightPipeline)
        Vk.DestroyShaderModule(Device, shader, null)
        return result == 0
    }

    -bool CreateUiPipeline()
    {
        VkPushConstantRange params
        params.stageFlags = 32
        params.vkSize = 44
        // One empty texel keeps the atlas set valid until a game uploads its own.
        VkStorage placeholder
        if !CreateStorage(4, 0, 6, placeholder) { return false }
        UiAtlas = placeholder
        long [2] sets = {StorageLayout, StorageLayout}
        VkPipelineLayoutCreateInfo layout
        layout.setLayoutCount = 2
        layout.pSetLayouts = &sets[0]
        layout.pushConstantRangeCount = 1
        layout.pPushConstantRanges = &params
        if Vk.CreatePipelineLayout(Device, &layout, null, &UiLayout) != 0 { return false }
        long shader = UiShaders.Compute(Device)
        if shader == 0 { return false }
        VkComputePipelineCreateInfo info
        info.vkStage.vkStage = 32
        info.vkStage.vkModule = shader
        info.vkStage.pName = "main"
        info.vkLayout = UiLayout
        int result = Vk.CreateComputePipelines(Device, 0, 1, &info, null, &UiPipeline)
        Vk.DestroyShaderModule(Device, shader, null)
        return result == 0
    }

    -ReleaseStorage(VkStorage& storage)
    {
        Vk.DestroyDescriptorPool(Device, storage.Pool, null)
        Vk.DestroyBuffer(Device, storage.Buffer, null)
        Vk.FreeMemory(Device, storage.Memory, null)
        VkStorage empty
        storage = empty
    }

    -ReleaseCompute()
    {
        ReleaseEffects()
        VkStorage scene = SceneStorage
        ReleaseStorage(scene)
        SceneStorage = scene
        Vk.DestroyPipeline(Device, LightPipeline, null)
        Vk.DestroyPipelineLayout(Device, LightLayout, null)
        Vk.DestroyDescriptorPool(Device, CasterPool, null)
        Vk.DestroyDescriptorSetLayout(Device, CasterLayout, null)
        LightPipeline = 0
        LightLayout = 0
        CasterPool = 0
        CasterSet = 0
        CasterLayout = 0
        CasterCount = 0
        for i : 0; i < Volumes.Count; i++ {
            VkStorage storage = Volumes.Items[i]
            ReleaseStorage(storage)
        }
        Volumes.Count = 0
        VkStorage atlas = UiAtlas
        ReleaseStorage(atlas)
        UiAtlas = atlas
        Vk.DestroyPipeline(Device, UiPipeline, null)
        Vk.DestroyPipelineLayout(Device, UiLayout, null)
        UiPipeline = 0
        UiLayout = 0
        Vk.DestroyPipeline(Device, ComputePipeline, null)
        Vk.DestroyPipelineLayout(Device, ComputeLayout, null)
        Vk.DestroyDescriptorSetLayout(Device, StorageLayout, null)
        ComputePipeline = 0
        ComputeLayout = 0
        StorageLayout = 0
    }

    -bool CreateStorage(long bytes, int usage, int flags, VkStorage& storage)
    {
        if bytes <= 0 || bytes > 134217728 { return false }
        VkBufferCreateInfo buffer
        buffer.vkSize = bytes
        buffer.usage = usage | 32 // STORAGE_BUFFER
        if Vk.CreateBuffer(Device, &buffer, null, &storage.Buffer) != 0 { return false }
        VkMemoryRequirements requirements
        Vk.GetBufferMemoryRequirements(Device, storage.Buffer, &requirements)
        VkMemoryAllocateInfo alloc
        alloc.memoryTypeIndex = FindMemoryType(requirements.memoryTypeBits, flags)
        alloc.allocationSize = requirements.vkSize
        if alloc.memoryTypeIndex < 0 || Vk.AllocateMemory(Device, &alloc, null, &storage.Memory) != 0 { return false }
        if Vk.BindBufferMemory(Device, storage.Buffer, storage.Memory, 0) != 0 { return false }
        VkDescriptorPoolSize size
        VkDescriptorPoolCreateInfo pool
        pool.pPoolSizes = &size
        if Vk.CreateDescriptorPool(Device, &pool, null, &storage.Pool) != 0 { return false }
        VkDescriptorSetAllocateInfo setInfo
        setInfo.descriptorPool = storage.Pool
        setInfo.pSetLayouts = &StorageLayout
        if Vk.AllocateDescriptorSets(Device, &setInfo, &storage.Descriptor) != 0 { return false }
        VkDescriptorBufferInfo data
        data.buffer = storage.Buffer
        data.range = bytes
        VkWriteDescriptorSet write
        write.dstSet = storage.Descriptor
        write.pBufferInfo = &data
        Vk.UpdateDescriptorSets(Device, 1, &write, 0, null)
        return true
    }

    // Called before recording a frame. Replace a published buffer only after
    // the previous frame has finished using its descriptor and storage.
    int MapVolume(int previous, int words, void*& mapped)
    {
        if Device == 0 || previous < -1 || previous >= Volumes.Count { return -1 }
        if previous >= 0 && Vk.WaitForFences(Device, 1, &FrameFence, 1, -1) != 0 { return -1 }
        if previous < 0 && Volumes.Count >= 4096 { return -1 }
        VkStorage storage
        long bytes = (long)words * 4
        if !CreateStorage(bytes, 0, 6, storage) || Vk.MapMemory(Device, storage.Memory, 0, bytes, 0, &mapped) != 0 {
            ReleaseStorage(storage)
            return -1
        }
        if previous < 0 {
            Volumes.Items[Volumes.Count] = storage
            Volumes.Count++
            return (int)Volumes.Count - 1
        }
        VkStorage old = Volumes.Items[previous]
        ReleaseStorage(old)
        Volumes.Items[previous] = storage
        return previous
    }

    UnmapVolume(int handle) { Vk.UnmapMemory(Device, Volumes.Items[handle].Memory) }

    // Called before recording a frame. Replaces the atlas once the previous
    // frame has finished reading it.
    bool MapUiAtlas(int words, void*& mapped)
    {
        if Device == 0 || Vk.WaitForFences(Device, 1, &FrameFence, 1, -1) != 0 { return false }
        VkStorage storage
        long bytes = (long)words * 4
        if !CreateStorage(bytes, 0, 6, storage) || Vk.MapMemory(Device, storage.Memory, 0, bytes, 0, &mapped) != 0 {
            ReleaseStorage(storage)
            return false
        }
        VkStorage old = UiAtlas
        ReleaseStorage(old)
        UiAtlas = storage
        return true
    }

    UnmapUiAtlas() { Vk.UnmapMemory(Device, UiAtlas.Memory) }

    -MemoryBarrier(int srcStage, int srcAccess, int dstStage, int dstAccess)
    {
        VkMemoryBarrier barrier
        barrier.srcAccessMask = srcAccess
        barrier.dstAccessMask = dstAccess
        Vk.CmdPipelineBarrier(Command, srcStage, dstStage, 0, 1, &barrier, 0, null, 0, null)
    }

    -ClearVoxelFrame()
    {
        long bytes = (long)Extent.width * Extent.height * 4
        Vk.CmdFillBuffer(Command, Output.Buffer, 0, bytes, (int)0xff182030)
        Vk.CmdFillBuffer(Command, Output.Buffer, bytes, bytes, 0x3f800000) // far depth = 1
        MemoryBarrier(0x1000, 0x1000, 0x800, 0x60) // transfer write -> compute read/write
        UiBound = false
        EffectBound = false
        LightBound = false
        CasterCount = 0
        Vk.CmdBindPipeline(Command, 1, ComputePipeline)
        Vk.CmdBindDescriptorSets(Command, 1, ComputeLayout, 0, 1, &Output.Descriptor, 0, null)
    }

    // Axes points at 9 floats: the world normals of the box's +X, +Y and +Z faces.
    bool TraceVolume(int handle, void* matrix, float left, float top, float right, float bottom, void* axes)
    {
        if !FrameOpen { return Device != 0 }
        if !ComputeFrame || handle < 0 || handle >= Volumes.Count { return false }
        VkStorage storage = Volumes.Items[handle]
        return Trace(storage.Descriptor, 0, matrix, left, top, right, bottom, axes)
    }

    // Traces one volume that starts at word `base` of the buffer behind descriptor.
    -bool Trace(long descriptor, int base, void* matrix, float left, float top, float right, float bottom, void* axes)
    {
        VkVoxelParams params
        memcpy(&params.Matrix[0], matrix, 64)
        params.Width = Extent.width
        params.Height = Extent.height
        params.StartX = (int)(left * (float)Extent.width)
        params.StartY = (int)(top * (float)Extent.height)
        int endX = (int)(right * (float)Extent.width) + 1
        int endY = (int)(bottom * (float)Extent.height) + 1
        params.Base = base
        memcpy(&params.Axes[0], axes, 36)
        if UiBound || EffectBound || LightBound {
            UiBound = false
            EffectBound = false
            LightBound = false
            Vk.CmdBindPipeline(Command, 1, ComputePipeline)
            Vk.CmdBindDescriptorSets(Command, 1, ComputeLayout, 0, 1, &Output.Descriptor, 0, null)
        }
        Vk.CmdBindDescriptorSets(Command, 1, ComputeLayout, 1, 1, &descriptor, 0, null)
        Vk.CmdPushConstants(Command, ComputeLayout, 32, 0, 120, &params)
        Vk.CmdDispatch(Command, (endX - params.StartX + 7) / 8, (endY - params.StartY + 7) / 8, 1)
        MemoryBarrier(0x800, 0x40, 0x800, 0x60) // following volume compares against this depth
        return true
    }

    // Adds a volume whose voxels block sunlight in this frame's LightVoxels.
    // BoxFromWorld points at 16 floats mapping world positions to the
    // volume's unit box. Casters past MaxCasters are ignored.
    bool AddShadowCaster(int handle, void* boxFromWorld)
    {
        if !FrameOpen { return Device != 0 }
        if !ComputeFrame || handle < 0 || handle >= Volumes.Count { return false }
        if CasterCount >= MaxCasters { return true }
        int at = 16 + CasterCount * 20
        memcpy(&Scene.Words[at], boxFromWorld, 64)
        for i : 16; i < 20; i++ { Scene.Words[at + i] = 0 }
        CasterBuffers[CasterCount] = Volumes.Items[handle].Buffer
        CasterCount++
        return true
    }

    // Turns the traced albedo, occlusion, depth and normals into lit color.
    // WorldFromClip points at 16 floats. Lighting points at 16 floats: the
    // direction toward the sun, then sun, sky and ground colors, each padded
    // to four. Clears the casters.
    bool LightVoxels(void* worldFromClip, void* lighting)
    {
        if !FrameOpen { return Device != 0 }
        if !ComputeFrame { return false }
        memcpy(&Scene.Words[0], lighting, 64)
        // Unused array entries must still name a valid buffer.
        VkDescriptorBufferInfo [256] infos
        for i : 0; i < MaxCasters; i++ {
            infos[i].buffer = i < CasterCount ? CasterBuffers[i] | Output.Buffer
            infos[i].range = -1 // VK_WHOLE_SIZE
        }
        VkWriteDescriptorSet write
        write.dstSet = CasterSet
        write.descriptorCount = MaxCasters
        write.pBufferInfo = &infos[0]
        Vk.UpdateDescriptorSets(Device, 1, &write, 0, null)
        Vk.CmdUpdateBuffer(Command, SceneStorage.Buffer, 0, (long)(16 + CasterCount * 20) * 4, &Scene.Words[0])
        MemoryBarrier(0x1000, 0x1000, 0x800, 0x20) // transfer write -> compute read
        VkLightParams params
        memcpy(&params.Matrix[0], worldFromClip, 64)
        params.Width = Extent.width
        params.Height = Extent.height
        params.Srgb = Format == 50 || Format == 43 ? 1 | 0
        params.Bgra = Format == 50 || Format == 44 ? 1 | 0
        params.Casters = CasterCount
        UiBound = false
        EffectBound = false
        LightBound = true
        Vk.CmdBindPipeline(Command, 1, LightPipeline)
        long [3] sets = {Output.Descriptor, SceneStorage.Descriptor, CasterSet}
        Vk.CmdBindDescriptorSets(Command, 1, LightLayout, 0, 3, &sets[0], 0, null)
        Vk.CmdPushConstants(Command, LightLayout, 32, 0, 84, &params)
        Vk.CmdDispatch(Command, (Extent.width + 7) / 8, (Extent.height + 7) / 8, 1)
        MemoryBarrier(0x800, 0x40, 0x800, 0x60) // UI blends over the lit frame
        CasterCount = 0
        return true
    }

    bool DrawUi(int x, int y, int width, int height, uint color, uint glyphFirst, uint glyphLast, int cell)
    {
        if !FrameOpen { return Device != 0 }
        if !ComputeFrame { return false }
        if width <= 0 || height <= 0 || x >= Extent.width || y >= Extent.height { return true }
        if (long)x + width <= 0 || (long)y + height <= 0 { return true }
        if !UiBound {
            UiBound = true
            Vk.CmdBindPipeline(Command, 1, UiPipeline)
            Vk.CmdBindDescriptorSets(Command, 1, UiLayout, 0, 1, &Output.Descriptor, 0, null)
            Vk.CmdBindDescriptorSets(Command, 1, UiLayout, 1, 1, &UiAtlas.Descriptor, 0, null)
        }
        VkUiParams params
        params.Width = Extent.width
        params.Height = Extent.height
        params.X = x
        params.Y = y
        params.RectWidth = width
        params.RectHeight = height
        params.Color = color
        params.GlyphFirst = glyphFirst
        params.GlyphLast = glyphLast
        params.Cell = cell
        params.Bgra = Format == 50 || Format == 44 ? 1 | 0
        Vk.CmdPushConstants(Command, UiLayout, 32, 0, 44, &params)
        Vk.CmdDispatch(Command, (width + 7) / 8, (height + 7) / 8, 1)
        MemoryBarrier(0x800, 0x40, 0x800, 0x60) // the next element blends over this one
        return true
    }

    -CopyVoxelFrame()
    {
        MemoryBarrier(0x1800, 0x1040, 0x1000, 0x800)
        VkImageMemoryBarrier image
        image.image = Images.Handles[FrameImage]
        image.subresourceRange.aspectMask = 1
        image.subresourceRange.levelCount = 1
        image.subresourceRange.layerCount = 1
        image.newLayout = 7 // TRANSFER_DST_OPTIMAL
        image.dstAccessMask = 0x1000
        Vk.CmdPipelineBarrier(Command, 0x1000, 0x1000, 0, 0, null, 0, null, 1, &image)
        VkBufferImageCopy region
        region.imageExtent.width = Extent.width
        region.imageExtent.height = Extent.height
        region.imageExtent.depth = 1
        Vk.CmdCopyBufferToImage(Command, Output.Buffer, image.image, 7, 1, &region)
        image.oldLayout = 7
        image.newLayout = 1000001002 // PRESENT_SRC_KHR
        image.srcAccessMask = 0x1000
        image.dstAccessMask = 0
        Vk.CmdPipelineBarrier(Command, 0x1000, 0x2000, 0, 0, null, 0, null, 1, &image)
    }
}




