QuaxelVulkan
#{
    -int TimestampBits
    -float TimestampPeriod
    -long TimingPool
    -bool TimingPending
    -bool LightingTimed
    -double LightingTotal
    -int LightingSamples
    double MeanLightingMs() { return LightingSamples > 0 ? LightingTotal / (double)LightingSamples | 0.0 }
    -double [] GpuTimes

    bool StartGpuTiming()
    {
        if Device == 0 || FrameOpen || TimingPool != 0 || TimestampBits == 0 { return false }
        VkTimestampProperties properties
        Vk.GetPhysicalDeviceProperties(Physical, &properties)
        TimestampPeriod = properties.timestampPeriod
        VkQueryPoolCreateInfo info
        info.queryCount = 4
        LightingTotal = 0.0
        LightingSamples = 0
        GpuTimes.Clear()
        return Vk.CreateQueryPool(Device, &info, null, &TimingPool) == 0
    }

    // Called after the ordinary frame fence. Only the last sample needs a drain.
    -bool CollectGpuTime()
    {
        long [4] ticks
        int count = LightingTimed ? 4 | 2
        if Vk.GetQueryPoolResults(Device, TimingPool, 0, count, 32, &ticks[0], 8, 1) != 0 { return false }
        GpuTimes += TimestampMs(ticks[1] - ticks[0])
        if LightingTimed {
            LightingTotal += TimestampMs(ticks[3] - ticks[2])
            LightingSamples++
        }
        TimingPending = false
        return true
    }

    -double TimestampMs(long delta)
    {
        if TimestampBits < 64 { delta = delta & (((long)1 << TimestampBits) - 1) }
        return (double)delta * (double)TimestampPeriod / 1000000.0
    }

    bool FinishGpuTiming(double []& samples)
    {
        if TimingPool == 0 || FrameOpen { return false }
        if TimingPending {
            if Vk.WaitForFences(Device, 1, &FrameFence, 1, -1) != 0 || !CollectGpuTime() { return false }
        }
        for ms : GpuTimes { samples += ms }
        Vk.DestroyQueryPool(Device, TimingPool, null)
        TimingPool = 0
        return true
    }
}
