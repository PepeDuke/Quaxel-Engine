    void* pPushConstantRanges
}

VkGraphicsPipelineCreateInfo
{
    int sType = 28 // VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO
    void* pNext
    int vkFlags
    int stageCount
    void* pStages
    void* pVertexInputState
    void* pInputAssemblyState
    void* pTessellationState
    void* pViewportState
    void* pRasterizationState
    void* pMultisampleState
    void* pDepthStencilState
    void* pColorBlendState
    void* pDynamicState
    long vkLayout
    long renderPass
    int subpass
    long basePipelineHandle
    int basePipelineIndex
}

VkCommandPoolCreateInfo
{
    int sType = 39 // VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO
    void* pNext
    int vkFlags
    int queueFamilyIndex
}

VkCommandBufferAllocateInfo
{
    int sType = 40 // VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO
    void* pNext
    long commandPool
    int level
    int commandBufferCount
}

VkCommandBufferBeginInfo
{
    int sType = 42 // VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO
    void* pNext
    int vkFlags
    void* pInheritanceInfo
}

VkRenderPassBeginInfo
{
    int sType = 43 // VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO
    void* pNext
    long renderPass
    long framebuffer
    VkRect2D renderArea
    int clearValueCount
    void* pClearValues
}

VkSemaphoreCreateInfo
{
    int sType = 9 // VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO
    void* pNext
    int vkFlags
}

VkSubmitInfo
{
    int sType = 4 // VK_STRUCTURE_TYPE_SUBMIT_INFO
    void* pNext
    int waitSemaphoreCount
    void* pWaitSemaphores
    void* pWaitDstStageMask
    int commandBufferCount
    void* pCommandBuffers
    int signalSemaphoreCount
    void* pSignalSemaphores
}

VkPresentInfoKHR
{
    int sType = 1000001001 // VK_STRUCTURE_TYPE_PRESENT_INFO_KHR
    void* pNext
    int waitSemaphoreCount
    void* pWaitSemaphores
    int swapchainCount
    void* pSwapchains
    void* pImageIndices
    void* pResults
}

VkFenceCreateInfo
{
    int sType = 8 // VK_STRUCTURE_TYPE_FENCE_CREATE_INFO
    void* pNext
    int vkFlags
}

VkFormatProperties
{
    int linearTilingFeatures
    int optimalTilingFeatures
    int bufferFeatures
}

VkMemoryType
{
    int propertyFlags
    int heapIndex
}

VkMemoryHeap
{
    long vkSize
    int heapFlags
}

VkPhysicalDeviceMemoryProperties
{
    int memoryTypeCount
    VkMemoryType [32] memoryTypes
    int memoryHeapCount
    VkMemoryHeap [16] memoryHeaps
}

VkMemoryRequirements
{
    long vkSize
    long alignment
    int memoryTypeBits
}

VkMemoryAllocateInfo
{
    int sType = 5 // VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO
    void* pNext
    long allocationSize
    int memoryTypeIndex
}

VkBufferCreateInfo
{
    int sType = 12 // VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO
    void* pNext
    int vkFlags
    long vkSize
    int usage
    int sharingMode
    int queueFamilyIndexCount
    void* pQueueFamilyIndices
}

VkImageCreateInfo
{
    int sType = 14 // VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO
    void* pNext
    int vkFlags
    int imageType
    int vkFormat
    VkExtent3D extent
    int mipLevels
    int arrayLayers
    int samples
    int tiling
    int usage
    int sharingMode
    int queueFamilyIndexCount
    void* pQueueFamilyIndices
    int initialLayout
}

VkVertexInputBindingDescription
{
    int binding
    int stride
    int inputRate
}

VkVertexInputAttributeDescription
{
    int location
    int binding
    int vkFormat
    int vkOffset
}

VkPushConstantRange
{
    int stageFlags
    int vkOffset
    int vkSize
}

VkStencilOpState
{
    int failOp
    int passOp
    int depthFailOp
    int compareOp
    int compareMask
    int writeMask
    int reference
}

VkPipelineDepthStencilStateCreateInfo
{
    int sType = 25 // VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO
    void* pNext
    int vkFlags
    int depthTestEnable
    int depthWriteEnable
    int depthCompareOp
    int depthBoundsTestEnable
    int stencilTestEnable
    VkStencilOpState front
    VkStencilOpState back
    float minDepthBounds
    float maxDepthBounds
}

Vk
#{
    extern "C" int CreateInstance(void* pCreateInfo, void* pAllocator, void* pInstance) = "vkCreateInstance"
    extern "C" DestroyInstance(long instance, void* pAllocator) = "vkDestroyInstance"
    extern "C" int CreateWin32SurfaceKHR(long instance, void* pCreateInfo, void* pAllocator, void* pSurface) = "vkCreateWin32SurfaceKHR"
    extern "C" DestroySurfaceKHR(long instance, long surface, void* pAllocator) = "vkDestroySurfaceKHR"
    extern "C" int EnumeratePhysicalDevices(long instance, void* pPhysicalDeviceCount, void* pPhysicalDevices) = "vkEnumeratePhysicalDevices"
    extern "C" GetPhysicalDeviceQueueFamilyProperties(long physicalDevice, void* pQueueFamilyPropertyCount, void* pQueueFamilyProperties) = "vkGetPhysicalDeviceQueueFamilyProperties"
    extern "C" int GetPhysicalDeviceSurfaceSupportKHR(long physicalDevice, int queueFamilyIndex, long surface, void* pSupported) = "vkGetPhysicalDeviceSurfaceSupportKHR"
    extern "C" int GetPhysicalDeviceSurfaceCapabilitiesKHR(long physicalDevice, long surface, void* pSurfaceCapabilities) = "vkGetPhysicalDeviceSurfaceCapabilitiesKHR"
    extern "C" int GetPhysicalDeviceSurfaceFormatsKHR(long physicalDevice, long surface, void* pSurfaceFormatCount, void* pSurfaceFormats) = "vkGetPhysicalDeviceSurfaceFormatsKHR"
    extern "C" int CreateDevice(long physicalDevice, void* pCreateInfo, void* pAllocator, void* pDevice) = "vkCreateDevice"
    extern "C" DestroyDevice(long device, void* pAllocator) = "vkDestroyDevice"
    extern "C" GetDeviceQueue(long device, int queueFamilyIndex, int queueIndex, void* pQueue) = "vkGetDeviceQueue"
    extern "C" int CreateSwapchainKHR(long device, void* pCreateInfo, void* pAllocator, void* pSwapchain) = "vkCreateSwapchainKHR"
    extern "C" DestroySwapchainKHR(long device, long swapchain, void* pAllocator) = "vkDestroySwapchainKHR"
    extern "C" int GetSwapchainImagesKHR(long device, long swapchain, void* pSwapchainImageCount, void* pSwapchainImages) = "vkGetSwapchainImagesKHR"
    extern "C" int CreateImageView(long device, void* pCreateInfo, void* pAllocator, void* pView) = "vkCreateImageView"
    extern "C" DestroyImageView(long device, long imageView, void* pAllocator) = "vkDestroyImageView"
    extern "C" int CreateRenderPass(long device, void* pCreateInfo, void* pAllocator, void* pRenderPass) = "vkCreateRenderPass"
    extern "C" DestroyRenderPass(long device, long renderPass, void* pAllocator) = "vkDestroyRenderPass"
    extern "C" int CreateFramebuffer(long device, void* pCreateInfo, void* pAllocator, void* pFramebuffer) = "vkCreateFramebuffer"
    extern "C" DestroyFramebuffer(long device, long framebuffer, void* pAllocator) = "vkDestroyFramebuffer"
    extern "C" int CreateShaderModule(long device, void* pCreateInfo, void* pAllocator, void* pShaderModule) = "vkCreateShaderModule"
    extern "C" DestroyShaderModule(long device, long shaderModule, void* pAllocator) = "vkDestroyShaderModule"
    extern "C" int CreatePipelineLayout(long device, void* pCreateInfo, void* pAllocator, void* pPipelineLayout) = "vkCreatePipelineLayout"
    extern "C" DestroyPipelineLayout(long device, long pipelineLayout, void* pAllocator) = "vkDestroyPipelineLayout"
    extern "C" int CreateGraphicsPipelines(long device, long pipelineCache, int createInfoCount, void* pCreateInfos, void* pAllocator, void* pPipelines) = "vkCreateGraphicsPipelines"
    extern "C" DestroyPipeline(long device, long pipeline, void* pAllocator) = "vkDestroyPipeline"
    extern "C" int CreateCommandPool(long device, void* pCreateInfo, void* pAllocator, void* pCommandPool) = "vkCreateCommandPool"
    extern "C" DestroyCommandPool(long device, long commandPool, void* pAllocator) = "vkDestroyCommandPool"
    extern "C" int AllocateCommandBuffers(long device, void* pAllocateInfo, void* pCommandBuffers) = "vkAllocateCommandBuffers"
    extern "C" int ResetCommandBuffer(long commandBuffer, int vkFlags) = "vkResetCommandBuffer"
    extern "C" int BeginCommandBuffer(long commandBuffer, void* pBeginInfo) = "vkBeginCommandBuffer"
    extern "C" int EndCommandBuffer(long commandBuffer) = "vkEndCommandBuffer"
    extern "C" CmdBeginRenderPass(long commandBuffer, void* pRenderPassBegin, int contents) = "vkCmdBeginRenderPass"
    extern "C" CmdBindPipeline(long commandBuffer, int pipelineBindPoint, long pipeline) = "vkCmdBindPipeline"
    extern "C" GetPhysicalDeviceFormatProperties(long physicalDevice, int vkFormat, void* pFormatProperties) = "vkGetPhysicalDeviceFormatProperties"
    extern "C" GetPhysicalDeviceMemoryProperties(long physicalDevice, void* pMemoryProperties) = "vkGetPhysicalDeviceMemoryProperties"
    // Fills 55 VkBool32 values in VkPhysicalDeviceFeatures order.
    extern "C" GetPhysicalDeviceFeatures(long physicalDevice, void* pFeatures) = "vkGetPhysicalDeviceFeatures"
    extern "C" int AllocateMemory(long device, void* pAllocateInfo, void* pAllocator, void* pMemory) = "vkAllocateMemory"
    extern "C" FreeMemory(long device, long memory, void* pAllocator) = "vkFreeMemory"
    extern "C" int MapMemory(long device, long memory, long vkOffset, long vkSize, int vkFlags, void* ppData) = "vkMapMemory"
