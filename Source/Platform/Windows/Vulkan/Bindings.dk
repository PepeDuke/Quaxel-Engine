}

VkPipelineColorBlendAttachmentState
{
    int blendEnable
    int srcColorBlendFactor
    int dstColorBlendFactor
    int colorBlendOp
    int srcAlphaBlendFactor
    int dstAlphaBlendFactor
    int alphaBlendOp
    int colorWriteMask
