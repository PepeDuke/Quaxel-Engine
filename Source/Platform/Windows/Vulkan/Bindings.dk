    extern "C" CmdDrawIndexed(long commandBuffer, int indexCount, int instanceCount, int firstIndex, int vertexOffset, int firstInstance) = "vkCmdDrawIndexed"
    extern "C" CmdEndRenderPass(long commandBuffer) = "vkCmdEndRenderPass"
    extern "C" int CreateSemaphore(long device, void* pCreateInfo, void* pAllocator, void* pSemaphore) = "vkCreateSemaphore"
    extern "C" DestroySemaphore(long device, long semaphore, void* pAllocator) = "vkDestroySemaphore"
    extern "C" int CreateFence(long device, void* pCreateInfo, void* pAllocator, void* pFence) = "vkCreateFence"
    extern "C" DestroyFence(long device, long fence, void* pAllocator) = "vkDestroyFence"
    extern "C" int WaitForFences(long device, int fenceCount, void* pFences, int waitAll, long timeout) = "vkWaitForFences"
    extern "C" int ResetFences(long device, int fenceCount, void* pFences) = "vkResetFences"
    extern "C" int AcquireNextImageKHR(long device, long swapchain, long timeout, long semaphore, long fence, void* pImageIndex) = "vkAcquireNextImageKHR"
    extern "C" int QueueSubmit(long vkQueue, int submitCount, void* pSubmits, long fence) = "vkQueueSubmit"
    extern "C" int QueuePresentKHR(long vkQueue, void* pPresentInfo) = "vkQueuePresentKHR"
    extern "C" int DeviceWaitIdle(long device) = "vkDeviceWaitIdle"
}
