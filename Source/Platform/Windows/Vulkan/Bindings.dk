// Vulkan C ABI subset for Windows x64. Handles occupy one 64-bit word.
// Pointer members borrow native-layout storage for the duration of a Vulkan call.

VkExtent2D
{
    int width
    int height
}

VkExtent3D
{
    int width
    int height
    int depth
}

VkOffset2D
{
    int x
    int y
}

VkRect2D
{
    VkOffset2D vkOffset
    VkExtent2D extent
}

VkSurfaceCapabilitiesKHR
{
    int minImageCount
    int maxImageCount
    VkExtent2D currentExtent
    VkExtent2D minImageExtent
    VkExtent2D maxImageExtent
    int maxImageArrayLayers
    int supportedTransforms
    int currentTransform
    int supportedCompositeAlpha
    int supportedUsageFlags
}

VkSurfaceFormatKHR
{
    int vkFormat
    int colorSpace
}

VkQueueFamilyProperties
{
    int queueFlags
    int queueCount
    int timestampValidBits
    VkExtent3D minImageTransferGranularity
}

VkInstanceCreateInfo
{
    int sType = 1 // VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
    void* pNext
    int vkFlags
    void* pApplicationInfo
    int enabledLayerCount
    void* ppEnabledLayerNames
    int enabledExtensionCount
    void* ppEnabledExtensionNames
}

VkWin32SurfaceCreateInfoKHR
{
    int sType = 1000009000 // VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR
    void* pNext
    int vkFlags
    void* hinstance
    void* hwnd
}

VkDeviceQueueCreateInfo
{
    int sType = 2 // VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO
    void* pNext
    int vkFlags
    int queueFamilyIndex
    int queueCount
    void* pQueuePriorities
}

VkDeviceCreateInfo
{
    int sType = 3 // VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO
    void* pNext
    int vkFlags
    int queueCreateInfoCount
    void* pQueueCreateInfos
    int enabledLayerCount
    void* ppEnabledLayerNames
    int enabledExtensionCount
    void* ppEnabledExtensionNames
    void* pEnabledFeatures
}

VkSwapchainCreateInfoKHR
{
    int sType = 1000001000 // VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR
    void* pNext
    int vkFlags
    long surface
    int minImageCount
    int imageFormat
    int imageColorSpace
    VkExtent2D imageExtent
    int imageArrayLayers
    int imageUsage
    int imageSharingMode
    int queueFamilyIndexCount
    void* pQueueFamilyIndices
    int preTransform
    int compositeAlpha
    int presentMode
    int clipped
    long oldSwapchain
}

VkComponentMapping
{
    int r
    int g
    int b
    int a
}

VkImageSubresourceRange
{
    int aspectMask
    int baseMipLevel
    int levelCount
    int baseArrayLayer
    int layerCount
}

VkImageViewCreateInfo
{
    int sType = 15 // VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO
    void* pNext
    int vkFlags
    long image
    int viewType
    int vkFormat
    VkComponentMapping components
    VkImageSubresourceRange subresourceRange
}

VkAttachmentDescription
{
    int vkFlags
    int vkFormat
    int samples
    int loadOp
    int storeOp
    int stencilLoadOp
    int stencilStoreOp
    int initialLayout
    int finalLayout
}

VkAttachmentReference
{
    int attachment
    int vkLayout
}

VkSubpassDescription
{
    int vkFlags
    int pipelineBindPoint
    int inputAttachmentCount
    void* pInputAttachments
    int colorAttachmentCount
    void* pColorAttachments
    void* pResolveAttachments
    void* pDepthStencilAttachment
    int preserveAttachmentCount
    void* pPreserveAttachments
}

VkSubpassDependency
{
    int srcSubpass
    int dstSubpass
    int srcStageMask
    int dstStageMask
    int srcAccessMask
    int dstAccessMask
    int dependencyFlags
}

VkRenderPassCreateInfo
{
    int sType = 38 // VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO
    void* pNext
    int vkFlags
    int attachmentCount
    void* pAttachments
    int subpassCount
    void* pSubpasses
    int dependencyCount
    void* pDependencies
}

VkFramebufferCreateInfo
{
    int sType = 37 // VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO
    void* pNext
    int vkFlags
    long renderPass
    int attachmentCount
    void* pAttachments
    int width
    int height
    int layers
}

VkShaderModuleCreateInfo
{
    int sType = 16 // VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO
    void* pNext
    int vkFlags
    long codeSize
    void* pCode
}

VkPipelineShaderStageCreateInfo
{
    int sType = 18 // VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO
    void* pNext
    int vkFlags
    int vkStage
    long vkModule
    cstring pName
    void* pSpecializationInfo
