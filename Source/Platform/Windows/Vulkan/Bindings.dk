{
    int sType = 20 // VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO
    void* pNext
    int vkFlags
    int topology
    int primitiveRestartEnable
}

VkViewport
{
    float x
    float y
    float width
    float height
    float minDepth
    float maxDepth
}

