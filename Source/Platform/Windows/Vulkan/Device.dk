// Vulkan 1.0 with shaderStorageBufferArrayDynamicIndexing, two frames in flight, and one graphics queue with presentation support.
VkInstanceExtensions
{
    cstring surface = "VK_KHR_surface"
    cstring win32 = "VK_KHR_win32_surface"
}

VkTargets
{
    long [32] Handles
    long [32] Views
    long [32] Targets
    long [32] Finished
}

QuaxelVulkan
#{
    -long Instance
    -long Surface
    -long Physical
    -long Device
    -long GraphicsQueue
    -int Family
    -long Pool
    // The current frame context's command buffer, acquire semaphore and fence.
    // SelectFrameSlot switches all three, with the context's UI elements and
    // caster set. Frame N records while the GPU still runs frame N-1.
    #int FramesInFlight = 2
    -long Command
    -long Acquired
    -long FrameFence
    -int FrameSlot
    -long [2] Commands
    -long [2] AcquiredSlots
    -long [2] Fences
    -long Chain
    -long Pass
    -long Layout
    -long Pipeline
    -VkExtent2D Extent
    -int Format
    -int ImageCount
    -VkTargets Images
    -long DepthImage
    -long DepthMemory
    -long DepthView
    -int DepthFormat
    -int MeshCount
    -VkMeshes Meshes
    -bool FrameOpen
    -int FrameImage
    -int FrameAcquireResult

    -bool SelectDevice()
    {
        long [32] adapters
        int count = (int)adapters.Len
        int result = Vk.EnumeratePhysicalDevices(Instance, &count, &adapters[0])
        if result != 0 && result != 5 { return false } // VK_INCOMPLETE
        if count == 0 { return false }
        for i : 0...count-1 {
            VkQueueFamilyProperties [64] families
            int familyCount = (int)families.Len
            Vk.GetPhysicalDeviceQueueFamilyProperties(adapters[i], &familyCount, &families[0])
            if familyCount == 0 { continue }
            for j : 0...familyCount-1 {
                int present = 0
                if (families[j].queueFlags & 3) == 3 && Vk.GetPhysicalDeviceSurfaceSupportKHR(adapters[i], j, Surface, &present) == 0 && present != 0 {
                    float priority = 1.0
                    VkDeviceQueueCreateInfo queueInfo
                    queueInfo.queueFamilyIndex = j
                    queueInfo.queueCount = 1
                    queueInfo.pQueuePriorities = &priority
                    cstring extension = "VK_KHR_swapchain"
                    // VkPhysicalDeviceFeatures: 55 VkBool32. Index 35 is
                    // shaderStorageBufferArrayDynamicIndexing.
                    int [55] supported
                    Vk.GetPhysicalDeviceFeatures(adapters[i], &supported[0])
                    // The shadow pass indexes an array of volume buffers.
                    if supported[35] == 0 { continue }
                    int [55] enabled
                    enabled[35] = 1
                    VkDeviceCreateInfo info
                    info.pEnabledFeatures = &enabled[0]
                    info.queueCreateInfoCount = 1
                    info.pQueueCreateInfos = &queueInfo
                    info.enabledExtensionCount = 1
                    info.ppEnabledExtensionNames = &extension
                    if Vk.CreateDevice(adapters[i], &info, null, &Device) == 0 {
                        Physical = adapters[i]
                        TimestampBits = families[j].timestampValidBits
                        Family = j
                        Vk.GetDeviceQueue(Device, Family, 0, &GraphicsQueue)
                        return true
                    }
                }
            }
        }
        return false
    }

    -bool Initialize(void* moduleHandle, void* windowHandle)
    {
        VkInstanceExtensions extensions
        VkInstanceCreateInfo info
        info.enabledExtensionCount = 2
        info.ppEnabledExtensionNames = &extensions
        if Vk.CreateInstance(&info, null, &Instance) != 0 { return false }
        VkWin32SurfaceCreateInfoKHR surfaceInfo
        surfaceInfo.hinstance = moduleHandle
        surfaceInfo.hwnd = windowHandle
        if Vk.CreateWin32SurfaceKHR(Instance, &surfaceInfo, null, &Surface) != 0 { return false }
        if !SelectDevice() { return false }
        if !CreateComputePipeline() || !SelectDepthFormat() { return false }
        VkCommandPoolCreateInfo poolInfo
        poolInfo.queueFamilyIndex = Family
        poolInfo.vkFlags = 2 // RESET_COMMAND_BUFFER
        if Vk.CreateCommandPool(Device, &poolInfo, null, &Pool) != 0 { return false }
        VkCommandBufferAllocateInfo allocation
        allocation.commandPool = Pool
        allocation.commandBufferCount = FramesInFlight
        if Vk.AllocateCommandBuffers(Device, &allocation, &Commands[0]) != 0 { return false }
        for slot : 0; slot < FramesInFlight; slot++ {
            VkSemaphoreCreateInfo sem
            if Vk.CreateSemaphore(Device, &sem, null, &AcquiredSlots[slot]) != 0 { return false }
            VkFenceCreateInfo fenceInfo
            fenceInfo.vkFlags = 1 // initially signaled
            if Vk.CreateFence(Device, &fenceInfo, null, &Fences[slot]) != 0 { return false }
        }
        SelectFrameSlot(0)
        return true
    }

    // Makes slot the context that the next frame records into. Call only
    // once its fence has signaled or before waiting on it.
    -SelectFrameSlot(int slot)
    {
        FrameSlot = slot
        Command = Commands[slot]
        Acquired = AcquiredSlots[slot]
        FrameFence = Fences[slot]
        UiElements = UiElementSlots.Items[slot]
        UiMapped = UiElementSlots.Mapped(slot)
        CasterSet = CasterSets[slot]
    }

    // Waits for the slot's last submission and frees what it was the last to use.
    -bool WaitFrameSlot(int slot)
    {
        if Vk.WaitForFences(Device, 1, &Fences[slot], 1, -1) != 0 { return false }
        CompletedSerial = Math.Max(CompletedSerial, SlotSerial[slot])
        ReleaseRetired(false)
        return true
    }

    // Waits until the GPU has finished every submitted frame.
    -bool WaitAllFrames()
    {
        for slot : 0; slot < FramesInFlight; slot++ {
            if !WaitFrameSlot(slot) { return false }
        }
        return true
    }

    // Storage that a submitted frame may still read is released only once
    // that frame completes, so replacing it never waits for the GPU.
    -VkStorage [256] Retired
    -long [256] RetiredSerial
    -int RetiredCount
    -long SubmitSerial
    -long CompletedSerial
    -long [2] SlotSerial

    -RetireStorage(VkStorage& storage)
    {
        if RetiredCount == Retired.Len && !WaitAllFrames() { return }
        // The frame being recorded will take the next serial.
        long serial = SubmitSerial + (FrameOpen ? 1 | 0)
        if serial <= CompletedSerial || RetiredCount == Retired.Len {
            ReleaseStorage(storage)
            return
        }
        Retired[RetiredCount] = storage
        RetiredSerial[RetiredCount] = serial
        RetiredCount++
        VkStorage empty
        storage = empty
    }

    // Releases retired storage whose frames are done, or all of it.
    -ReleaseRetired(bool all)
    {
        int kept = 0
        for i : 0; i < RetiredCount; i++ {
            if all || RetiredSerial[i] <= CompletedSerial {
                VkStorage storage = Retired[i]
                ReleaseStorage(storage)
            } else {
                Retired[kept] = Retired[i]
                RetiredSerial[kept] = RetiredSerial[i]
                kept++
            }
        }
        RetiredCount = kept
    }

    bool IsStarted() { return Device != 0 }

    bool Start(void* moduleHandle, void* windowHandle)
    {
        if Instance != 0 || windowHandle == null { return false }
        if Initialize(moduleHandle, windowHandle) { return true }
        Stop()
        return false
    }

    Stop()
    {
        if Device != 0 {
            Vk.DeviceWaitIdle(Device)
            if TimingPool != 0 { Vk.DestroyQueryPool(Device, TimingPool, null) }
            TimingPool = 0
            for slot : 0; slot < FramesInFlight; slot++ { TimingPending[slot] = false }
            ReleaseRetired(true)
            ReleaseMeshes()
            ReleaseTargets()
            ReleaseCompute()
            for slot : 0; slot < FramesInFlight; slot++ {
                Vk.DestroyFence(Device, Fences[slot], null)
                Vk.DestroySemaphore(Device, AcquiredSlots[slot], null)
                Fences[slot] = 0
                AcquiredSlots[slot] = 0
                Commands[slot] = 0
            }
            Vk.DestroyCommandPool(Device, Pool, null)
            Vk.DestroyDevice(Device, null)
        }
        if Instance != 0 {
            Vk.DestroySurfaceKHR(Instance, Surface, null)
            Vk.DestroyInstance(Instance, null)
        }
        FrameOpen = false
        PreferImmediate = false
        DepthFormat = 0
        FrameFence = 0
        Acquired = 0
        Command = 0
        FrameSlot = 0
        SubmitSerial = 0
        CompletedSerial = 0
        for slot : 0; slot < FramesInFlight; slot++ { SlotSerial[slot] = 0 }
        Pool = 0
        Device = 0
        Surface = 0
        Instance = 0
    }
}
