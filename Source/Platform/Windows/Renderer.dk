QuaxelPlatformBackend
#{
    bool StartRenderer() { return QuaxelVulkan.Start(Instance, Window) }

    int MapVolume(int previous, int words, void*& mapped) { return QuaxelVulkan.MapVolume(previous, words, mapped) }
    UnmapVolume(int handle) { QuaxelVulkan.UnmapVolume(handle) }
    bool BeginVoxelFrame() { return BeginFrame(null) }
    bool TraceVolume(int handle, void* boxFromClip, float left, float top, float right, float bottom)
    {
        return QuaxelVulkan.TraceVolume(handle, boxFromClip, left, top, right, bottom)
    }

    bool DrawUi(int x, int y, int width, int height, uint color, uint glyphFirst, uint glyphLast, int cell)
    {
        return QuaxelVulkan.DrawUi(x, y, width, height, color, glyphFirst, glyphLast, cell)
    }

    int CreateMesh(void* vertices, int vertexCount, void* indices, int indexCount)
    {
        return QuaxelVulkan.CreateMesh(vertices, vertexCount, indices, indexCount)
    }

    // A failed submit can leave the frame fence unsignaled. Release the device
    // before callers retry, including after a partial swapchain rebuild.
    bool BeginFrame(void* viewProjection)
    {
        int width = 0
        int height = 0
        if !GetWindowSize(width, height) { return false }
        if QuaxelVulkan.BeginFrame(width, height, viewProjection) { return true }
        StopRenderer()
        return false
    }

    bool DrawMesh(int mesh, void* model)
    {
        if QuaxelVulkan.DrawMesh(mesh, model) { return true }
        StopRenderer()
        return false
    }

    bool EndFrame()
    {
        if QuaxelVulkan.EndFrame() { return true }
        StopRenderer()
        return false
    }

    StopRenderer() { QuaxelVulkan.Stop() }
}
