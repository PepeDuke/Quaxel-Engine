QuaxelPlatformBackend
#{
    bool StartRenderer() { return QuaxelVulkan.Start(Instance, Window) }

    int MapVolume(int previous, int words, void*& mapped) { return QuaxelVulkan.MapVolume(previous, words, mapped) }
    UnmapVolume(int handle) { QuaxelVulkan.UnmapVolume(handle) }
    bool BeginVoxelFrame() { return BeginFrame(null) }
    bool TraceVolume(int handle, void* boxFromClip, float left, float top, float right, float bottom, float lightX, float lightY, float lightZ)
    {
        return QuaxelVulkan.TraceVolume(handle, boxFromClip, left, top, right, bottom, lightX, lightY, lightZ)
    }

    bool EnsureEffectPages(int pages) { return QuaxelVulkan.EnsureEffectPages(pages) }
    bool ResetEffect(int slot) { return QuaxelVulkan.ResetEffect(slot) }
    bool WriteEffectParams(int slot, void* data, int bytes) { return QuaxelVulkan.WriteEffectParams(slot, data, bytes) }
    bool BakeEffect(int slot, int volume, void* matrix, int cellsX, int cellsY, int cellsZ)
    {
        return QuaxelVulkan.BakeEffect(slot, volume, matrix, cellsX, cellsY, cellsZ)
    }
    bool SimulateEffect(int slot, int step, float seconds) { return QuaxelVulkan.SimulateEffect(slot, step, seconds) }
    bool DrawEffect(int slot, int tick) { return QuaxelVulkan.DrawEffect(slot, tick) }
    bool TraceEffect(int slot, void* boxFromClip, float left, float top, float right, float bottom, float lightX, float lightY, float lightZ)
    {
        return QuaxelVulkan.TraceEffect(slot, boxFromClip, left, top, right, bottom, lightX, lightY, lightZ)
    }
    bool ReadEffectSlot(int slot, int words, void* destination) { return QuaxelVulkan.ReadEffectSlot(slot, words, destination) }

    bool DrawUi(int x, int y, int width, int height, uint color, uint glyphFirst, uint glyphLast, int cell)
    {
        return QuaxelVulkan.DrawUi(x, y, width, height, color, glyphFirst, glyphLast, cell)
    }

    bool MapUiAtlas(int words, void*& mapped) { return QuaxelVulkan.MapUiAtlas(words, mapped) }
    UnmapUiAtlas() { QuaxelVulkan.UnmapUiAtlas() }

    int CreateMesh(void* vertices, int vertexCount, void* indices, int indexCount)
    {
        return QuaxelVulkan.CreateMesh(vertices, vertexCount, indices, indexCount)
    }

    // A failed submit can leave the frame fence unsignaled. Release the device
    // before callers retry, including after a partial swapchain rebuild.
    bool BeginFrame(void* viewProjection)
    {
        int width = 0
        int height = 0
        if !GetWindowSize(width, height) { return false }
        if QuaxelVulkan.BeginFrame(width, height, viewProjection) { return true }
        StopRenderer()
        return false
    }

    bool DrawMesh(int mesh, void* model)
    {
        if QuaxelVulkan.DrawMesh(mesh, model) { return true }
        StopRenderer()
        return false
    }

    bool EndFrame()
    {
        if QuaxelVulkan.EndFrame() { return true }
        StopRenderer()
        return false
    }

    StopRenderer() { QuaxelVulkan.Stop() }
}
