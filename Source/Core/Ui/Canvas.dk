// One filled rectangle, one glyph when Cell is positive, or one atlas sprite when
// Cell is negative. Color is 0xAARRGGBB.
QuaxelUiCommand
{
    int X
    int Y
    int Width
    int Height
    uint Color
    uint GlyphFirst
    uint GlyphLast
    int Cell
}

// Mouse state for one layout pass. Coordinates are client pixels.
QuaxelUiPointer
{
    int X
    int Y
    bool Pressed
    bool Released

    bool IsInside(int x, int y, int width, int height)
    {
        return X >= x && Y >= y && X < x + width && Y < y + height
    }
}

// Collects what one layout pass wants drawn, back to front, in UI pixels. One UI
// pixel is one pixel of the font, and QuaxelUi scales the finished list to the window.
QuaxelUiCanvas
{
    QuaxelUiCommand [] Commands
    QuaxelUiPointer Pointer

    Rect(int x, int y, int width, int height, uint color)
    {
        if width <= 0 || height <= 0 || (color >> 24) == (uint)0 { return }
        QuaxelUiCommand command
        command.X = x
        command.Y = y
        command.Width = width
        command.Height = height
        command.Color = color
        Commands += command
    }

    // Draws width * height atlas texels with the top-left at (x, y). A texel is one UI pixel.
    Sprite(int x, int y, int atlasX, int atlasY, int width, int height, int atlasWidth)
    {
        if width <= 0 || height <= 0 { return }
        QuaxelUiCommand command
        command.X = x
        command.Y = y
        command.Width = width
        command.Height = height
        command.Color = 0xFFFFFFFF
        command.Cell = -1
        command.GlyphFirst = (uint)(atlasY * atlasWidth + atlasX)
        command.GlyphLast = (uint)atlasWidth
        Commands += command
    }

    Text(int x, int y, string text, uint color)
    {
        if (color >> 24) == (uint)0 { return }
        long count = Length(text)
        for i : (long)0; i < count; i++ {
            uint codeUnit = CodeUnitAt(text, i)
            if codeUnit != (uint)32 {
                QuaxelUiCommand command
                command.X = x + (int)i * 6
                command.Y = y
                command.Width = 5
                command.Height = 7
                command.Color = color
                command.Cell = 1
                uint first = 0
                uint last = 0
                QuaxelUiFont.Glyph(codeUnit, first, last)
                command.GlyphFirst = first
                command.GlyphLast = last
                Commands += command
            }
        }
    }
}
T{
    InvisibleAndEmptyRectsAreSkipped()
    {
        QuaxelUiCanvas canvas
        canvas.Rect(0, 0, 10, 10, 0x00FFFFFF)
        canvas.Rect(0, 0, 0, 10, 0xFFFFFFFF)
        T.AreEqual(canvas.Commands.Len, 0)
        canvas.Rect(1, 2, 3, 4, 0x80FFFFFF)
        T.AreEqual(canvas.Commands.Len, 1)
        T.AreEqual(canvas.Commands[0].Height, 4)
    }

    TextEmitsOneCommandPerVisibleCharacter()
    {
        QuaxelUiCanvas canvas
        canvas.Text(10, 20, "A B", 0xFFFFFFFF)
        T.AreEqual(canvas.Commands.Len, 2)
        T.AreEqual(canvas.Commands[0].X, 10)
        T.AreEqual(canvas.Commands[1].X, 22)
        T.AreEqual(canvas.Commands[1].Width, 5)
        T.AreEqual(canvas.Commands[1].Cell, 1)
    }
}
