// Owns one tree of UI elements built with Duck markup and lays it out each frame.
QuaxelUi
{
    markup Content
    -QuaxelUiCanvas Canvas
    -int PointerX
    -int PointerY
    -bool PointerDown

    // Lays out the tree for a window size and new mouse state.
    Layout(int width, int height, int pointerX, int pointerY, bool pointerDown)
    {
        QuaxelUiPointer pointer
        pointer.X = pointerX
        pointer.Y = pointerY
        pointer.Pressed = pointerDown && !PointerDown
        pointer.Released = !pointerDown && PointerDown
        PointerX = pointerX
        PointerY = pointerY
        PointerDown = pointerDown
        Canvas = PlaceContent(pointer, width, height)
    }

    -QuaxelUiCanvas PlaceContent(QuaxelUiPointer pointer, int width, int height)
    {
        QuaxelUiCanvas canvas
        canvas.Pointer = pointer
        for child : Content {
            ?child..Place(canvas, 0, 0, width, height)
        }
        return canvas
    }

    // Lays out again for a new size. The mouse has not changed, so nothing clicks.
    Relayout(int width, int height) { Layout(width, height, PointerX, PointerY, PointerDown) }

    QuaxelUiCommand GetCommand(int index) { return Canvas.Commands[index] }

    -bool Send(QuaxelUiChange& change)
    {
        for child : Content {
            if ?child..Apply(change) { return true }
        }
        return false
    }

    // Each of these finds the element whose Id matches and returns false if none does.
    bool SetText(string id, string text)
    {
        QuaxelUiChange change
        change.Id = id
        change.Kind = QuaxelUiChangeKind.SetText
        change.Text = text
        return Send(change)
    }

    bool SetValue(string id, float value)
    {
        QuaxelUiChange change
        change.Id = id
        change.Kind = QuaxelUiChangeKind.SetValue
        change.Value = value
        return Send(change)
    }

    bool SetVisible(string id, bool visible)
    {
        QuaxelUiChange change
        change.Id = id
        change.Kind = QuaxelUiChangeKind.SetVisible
        change.Visible = visible
        return Send(change)
    }

    // True once for each completed click on the button.
    bool TakeClick(string id)
    {
        QuaxelUiChange change
        change.Id = id
        change.Kind = QuaxelUiChangeKind.TakeClick
        return Send(change) && change.Clicked
    }
}
@{
    CommandCount: (int)Canvas.Commands.Len
}
#{
    string FormatInt(int value)
    {
        long remaining = value < 0 ? -(long)value | (long)value
        string digits = ""
        do {
            digits = (string)char(48 + (int)(remaining % 10)) + digits
            remaining /= 10
        } while remaining > 0
        return value < 0 ? "-" + digits | digits
    }
}
T{
    FormatIntHandlesSignsAndLimits()
    {
        T.AreEqual(QuaxelUi.FormatInt(0), "0")
        T.AreEqual(QuaxelUi.FormatInt(-40), "-40")
        T.AreEqual(QuaxelUi.FormatInt(int.Min), "-2147483648")
    }

    AnchorsPlaceElementsAgainstTheWindow()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel Width=100 Height=40 Color=0xFF000000 AnchorX=1.0 AnchorY=0.5 X=-10/>
        }
        ui.Layout(800, 600, 0, 0, false)
        T.AreEqual(ui.CommandCount, 1)
        QuaxelUiCommand panel = ui.GetCommand(0)
        T.AreEqual(panel.X, 690)
        T.AreEqual(panel.Y, 280)
        ui.Relayout(400, 200)
        panel = ui.GetCommand(0)
        T.AreEqual(panel.X, 290)
        T.AreEqual(panel.Y, 80)
    }

    ColumnFitsAndStacksChildren()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel Flow=QuaxelUiFlow.Column Padding=4 Spacing=2 Color=0xFF000000>
                <QuaxelUiBar Width=50 Height=6 BackColor=0xFF111111/>
                <QuaxelUiBar Width=30 Height=10 BackColor=0xFF222222/>
            </QuaxelUiPanel>
        }
        ui.Layout(800, 600, 0, 0, false)
        T.AreEqual(ui.CommandCount, 3)
        QuaxelUiCommand panel = ui.GetCommand(0)
        T.AreEqual(panel.Width, 58)
        T.AreEqual(panel.Height, 26)
        QuaxelUiCommand second = ui.GetCommand(2)
        T.AreEqual(second.X, 4)
        T.AreEqual(second.Y, 12)
    }

    RowLaysChildrenSideBySide()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel Flow=QuaxelUiFlow.Row Spacing=3 Color=0xFF000000>
                <QuaxelUiBar Width=20 Height=6 BackColor=0xFF111111/>
                <QuaxelUiBar Width=30 Height=9 BackColor=0xFF222222/>
            </QuaxelUiPanel>
        }
        ui.Layout(800, 600, 0, 0, false)
        QuaxelUiCommand panel = ui.GetCommand(0)
        T.AreEqual(panel.Width, 53)
        T.AreEqual(panel.Height, 9)
        QuaxelUiCommand second = ui.GetCommand(2)
        T.AreEqual(second.X, 23)
    }

    NestedElementsAreFoundById()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel Flow=QuaxelUiFlow.Column>
                <QuaxelUiPanel Flow=QuaxelUiFlow.Row>
                    <QuaxelUiText Id="score" Text="A"/>
                </QuaxelUiPanel>
                <QuaxelUiBar Id="health" Width=100 Height=4 Color=0xFFFF0000 BackColor=0/>
            </QuaxelUiPanel>
        }
        T.IsTrue(ui.SetText("score", "ABC"))
        T.IsTrue(ui.SetValue("health", 0.25))
        T.IsFalse(ui.SetText("missing", "x"))
        ui.Layout(800, 600, 0, 0, false)
        T.AreEqual(ui.CommandCount, 4)
        QuaxelUiCommand bar = ui.GetCommand(3)
        T.AreEqual(bar.Width, 25)
    }

    HiddenElementsLeaveTheFlow()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel Flow=QuaxelUiFlow.Column Color=0xFF000000>
                <QuaxelUiBar Id="first" Width=10 Height=5 BackColor=0xFF111111/>
                <QuaxelUiBar Width=10 Height=7 BackColor=0xFF222222/>
            </QuaxelUiPanel>
        }
        T.IsTrue(ui.SetVisible("first", false))
        ui.Layout(800, 600, 0, 0, false)
        T.AreEqual(ui.CommandCount, 2)
        QuaxelUiCommand panel = ui.GetCommand(0)
        T.AreEqual(panel.Height, 7)
    }

    ButtonClicksOnPressAndReleaseInside()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiButton Id="go" Width=40 Height=20 Text="GO"/>
        }
        ui.Layout(800, 600, 10, 10, false)
        T.IsFalse(ui.TakeClick("go"))
        ui.Layout(800, 600, 10, 10, true)
        T.IsFalse(ui.TakeClick("go"))
        ui.Layout(800, 600, 12, 12, false)
        T.IsTrue(ui.TakeClick("go"))
        T.IsFalse(ui.TakeClick("go"))
    }

    ButtonIgnoresReleaseOutsideAndPressElsewhere()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiButton Id="go" Width=40 Height=20 Text="GO"/>
        }
        ui.Layout(800, 600, 10, 10, true)
        ui.Layout(800, 600, 200, 200, false)
        T.IsFalse(ui.TakeClick("go"))
        ui.Layout(800, 600, 200, 200, true)
        ui.Layout(800, 600, 10, 10, false)
        T.IsFalse(ui.TakeClick("go"))
    }

    RelayoutCannotClick()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiButton Id="go" Width=40 Height=20 Text="GO"/>
        }
        ui.Layout(800, 600, 10, 10, true)
        ui.Relayout(700, 500)
        ui.Relayout(700, 500)
        T.IsFalse(ui.TakeClick("go"))
    }

    EmptyUiDrawsNothing()
    {
        QuaxelUi ui()
        ui.Layout(800, 600, 0, 0, false)
        T.AreEqual(ui.CommandCount, 0)
    }
}
