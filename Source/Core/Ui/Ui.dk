// Owns one tree of UI elements built with Duck markup and lays it out each frame.
QuaxelUi
{
    markup Content
    -QuaxelUiCanvas Canvas
    -int PointerX
    -int PointerY
    -bool PointerDown
    -QuaxelUiCanvas Overlay
    -int [] AtlasTexels
    -int AtlasWidth
    -int AtlasHeight
    -bool AtlasChanged
    -int FitWidth
    -int FitHeight

    // Scales the whole UI so at least this many UI pixels fit the window, using
    // the largest whole-number scale. Every font pixel, sprite texel and rectangle
    // then lands on one grid. With no fit set, one UI pixel is one screen pixel.
    FitPixels(int width, int height)
    {
        FitWidth = width
        FitHeight = height
    }

    // Screen pixels per UI pixel for a window size.
    int ScaleFor(int width, int height)
    {
        if FitWidth <= 0 || FitHeight <= 0 { return 1 }
        return Math.Max(1, Math.Min(width / FitWidth, height / FitHeight))
    }

    // Sizes the sprite atlas and clears it to transparent.
    ConfigureAtlas(int width, int height)
    {
        AtlasTexels.Clear()
        AtlasWidth = width
        AtlasHeight = height
        for i : 0; i < width * height; i++ { AtlasTexels += 0 }
        AtlasChanged = true
    }

    // Color is 0xAARRGGBB in display values. Zero alpha stays transparent.
    SetAtlasTexel(int x, int y, uint color)
    {
        if x < 0 || y < 0 || x >= AtlasWidth || y >= AtlasHeight { return }
        AtlasTexels[y * AtlasWidth + x] = (int)color
        AtlasChanged = true
    }

    uint AtlasTexel(int x, int y) { return (uint)AtlasTexels[y * AtlasWidth + x] }

    CopyAtlas(void* destination)
    {
        QuaxelVoxelUpload* upload = (QuaxelVoxelUpload*)destination
        for i : 0; i < AtlasTexels.Len; i++ { upload.Words[i] = AtlasTexels[i] }
    }

    MarkAtlasUploaded() { AtlasChanged = false }

    // The overlay is drawn over the markup tree. A game rebuilds it each frame
    // in UpdateUi, for interfaces whose contents change with its state.
    ClearOverlay() { Overlay.Commands.Clear() }

    OverlayRect(int x, int y, int width, int height, uint color) { Overlay.Rect(x, y, width, height, color) }

    OverlayText(int x, int y, string text, uint color) { Overlay.Text(x, y, text, color) }

    OverlaySprite(int x, int y, int atlasX, int atlasY, int width, int height)
    {
        Overlay.Sprite(x, y, atlasX, atlasY, width, height, AtlasWidth)
    }

    // A sprite with a one-texel border in the outline color around its shapes.
    OverlayOutlinedSprite(int x, int y, int atlasX, int atlasY, int width, int height, uint outline)
    {
        Overlay.OutlinedSprite(x, y, atlasX, atlasY, width, height, AtlasWidth, outline)
    }

    // Lays out the tree for a window size and new mouse state.
    Layout(int width, int height, int pointerX, int pointerY, bool pointerDown)
    {
        int scale = ScaleFor(width, height)
        QuaxelUiPointer pointer
        pointer.X = pointerX / scale
        pointer.Y = pointerY / scale
        pointer.Pressed = pointerDown && !PointerDown
        pointer.Released = !pointerDown && PointerDown
        PointerX = pointerX
        PointerY = pointerY
        PointerDown = pointerDown
        Canvas = PlaceContent(pointer, width / scale, height / scale)
        for i : 0; i < Overlay.Commands.Len; i++ { Canvas.Commands += Overlay.Commands[i] }
        for i : 0; i < Canvas.Commands.Len; i++ {
            Canvas.Commands[i].X *= scale
            Canvas.Commands[i].Y *= scale
            Canvas.Commands[i].Width *= scale
            Canvas.Commands[i].Height *= scale
            Canvas.Commands[i].Cell *= scale
        }
    }

    -QuaxelUiCanvas PlaceContent(QuaxelUiPointer pointer, int width, int height)
    {
        QuaxelUiCanvas canvas
        canvas.Pointer = pointer
        for child : Content {
            ?child..Place(canvas, 0, 0, width, height)
        }
        return canvas
    }

    // Lays out again for a new size. The mouse has not changed, so nothing clicks.
    Relayout(int width, int height) { Layout(width, height, PointerX, PointerY, PointerDown) }

    QuaxelUiCommand GetCommand(int index) { return Canvas.Commands[index] }

    -bool Send(QuaxelUiChange& change)
    {
        for child : Content {
            if ?child..Apply(change) { return true }
        }
        return false
    }

    // Each of these finds the element whose Id matches and returns false if none does.
    bool SetText(string id, string text)
    {
        QuaxelUiChange change
        change.Id = id
        change.Kind = QuaxelUiChangeKind.SetText
        change.Text = text
        return Send(change)
    }

    bool SetValue(string id, float value)
    {
        QuaxelUiChange change
        change.Id = id
        change.Kind = QuaxelUiChangeKind.SetValue
        change.Value = value
        return Send(change)
    }

    bool SetVisible(string id, bool visible)
    {
        QuaxelUiChange change
        change.Id = id
        change.Kind = QuaxelUiChangeKind.SetVisible
        change.Visible = visible
        return Send(change)
    }

    // True once for each completed click on the button.
    bool TakeClick(string id)
    {
        QuaxelUiChange change
        change.Id = id
        change.Kind = QuaxelUiChangeKind.TakeClick
        return Send(change) && change.Clicked
    }
}
@{
    CommandCount: (int)Canvas.Commands.Len
    AtlasDirty: AtlasChanged
    AtlasWords: (int)AtlasTexels.Len
}
#{
    string FormatInt(int value)
    {
        long remaining = value < 0 ? -(long)value | (long)value
        string digits = ""
        do {
            digits = (string)char(48 + (int)(remaining % 10)) + digits
            remaining /= 10
        } while remaining > 0
        return value < 0 ? "-" + digits | digits
    }
}
T{
    FormatIntHandlesSignsAndLimits()
    {
        T.AreEqual(QuaxelUi.FormatInt(0), "0")
        T.AreEqual(QuaxelUi.FormatInt(-40), "-40")
        T.AreEqual(QuaxelUi.FormatInt(int.Min), "-2147483648")
    }

    AnchorsPlaceElementsAgainstTheWindow()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel Width=100 Height=40 Color=0xFF000000 AnchorX=1.0 AnchorY=0.5 X=-10/>
        }
        ui.Layout(800, 600, 0, 0, false)
        T.AreEqual(ui.CommandCount, 1)
        QuaxelUiCommand panel = ui.GetCommand(0)
        T.AreEqual(panel.X, 690)
        T.AreEqual(panel.Y, 280)
        ui.Relayout(400, 200)
        panel = ui.GetCommand(0)
        T.AreEqual(panel.X, 290)
        T.AreEqual(panel.Y, 80)
    }

    ColumnFitsAndStacksChildren()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel Flow=QuaxelUiFlow.Column Padding=4 Spacing=2 Color=0xFF000000>
                <QuaxelUiBar Width=50 Height=6 BackColor=0xFF111111/>
                <QuaxelUiBar Width=30 Height=10 BackColor=0xFF222222/>
            </QuaxelUiPanel>
        }
        ui.Layout(800, 600, 0, 0, false)
        T.AreEqual(ui.CommandCount, 3)
        QuaxelUiCommand panel = ui.GetCommand(0)
        T.AreEqual(panel.Width, 58)
        T.AreEqual(panel.Height, 26)
        QuaxelUiCommand second = ui.GetCommand(2)
        T.AreEqual(second.X, 4)
        T.AreEqual(second.Y, 12)
    }

    RowLaysChildrenSideBySide()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel Flow=QuaxelUiFlow.Row Spacing=3 Color=0xFF000000>
                <QuaxelUiBar Width=20 Height=6 BackColor=0xFF111111/>
                <QuaxelUiBar Width=30 Height=9 BackColor=0xFF222222/>
            </QuaxelUiPanel>
        }
        ui.Layout(800, 600, 0, 0, false)
        QuaxelUiCommand panel = ui.GetCommand(0)
        T.AreEqual(panel.Width, 53)
        T.AreEqual(panel.Height, 9)
        QuaxelUiCommand second = ui.GetCommand(2)
        T.AreEqual(second.X, 23)
    }

    NestedElementsAreFoundById()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel Flow=QuaxelUiFlow.Column>
                <QuaxelUiPanel Flow=QuaxelUiFlow.Row>
                    <QuaxelUiText Id="score" Text="A"/>
                </QuaxelUiPanel>
                <QuaxelUiBar Id="health" Width=100 Height=4 Color=0xFFFF0000 BackColor=0/>
            </QuaxelUiPanel>
        }
        T.IsTrue(ui.SetText("score", "ABC"))
        T.IsTrue(ui.SetValue("health", 0.25))
        T.IsFalse(ui.SetText("missing", "x"))
        ui.Layout(800, 600, 0, 0, false)
        T.AreEqual(ui.CommandCount, 4)
        QuaxelUiCommand bar = ui.GetCommand(3)
        T.AreEqual(bar.Width, 25)
    }

    HiddenElementsLeaveTheFlow()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel Flow=QuaxelUiFlow.Column Color=0xFF000000>
                <QuaxelUiBar Id="first" Width=10 Height=5 BackColor=0xFF111111/>
                <QuaxelUiBar Width=10 Height=7 BackColor=0xFF222222/>
            </QuaxelUiPanel>
        }
        T.IsTrue(ui.SetVisible("first", false))
        ui.Layout(800, 600, 0, 0, false)
        T.AreEqual(ui.CommandCount, 2)
        QuaxelUiCommand panel = ui.GetCommand(0)
        T.AreEqual(panel.Height, 7)
    }

    ButtonClicksOnPressAndReleaseInside()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiButton Id="go" Width=40 Height=20 Text="GO"/>
        }
        ui.Layout(800, 600, 10, 10, false)
        T.IsFalse(ui.TakeClick("go"))
        ui.Layout(800, 600, 10, 10, true)
        T.IsFalse(ui.TakeClick("go"))
        ui.Layout(800, 600, 12, 12, false)
        T.IsTrue(ui.TakeClick("go"))
        T.IsFalse(ui.TakeClick("go"))
    }

    ButtonIgnoresReleaseOutsideAndPressElsewhere()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiButton Id="go" Width=40 Height=20 Text="GO"/>
        }
        ui.Layout(800, 600, 10, 10, true)
        ui.Layout(800, 600, 200, 200, false)
        T.IsFalse(ui.TakeClick("go"))
        ui.Layout(800, 600, 200, 200, true)
        ui.Layout(800, 600, 10, 10, false)
        T.IsFalse(ui.TakeClick("go"))
    }

    RelayoutCannotClick()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiButton Id="go" Width=40 Height=20 Text="GO"/>
        }
        ui.Layout(800, 600, 10, 10, true)
        ui.Relayout(700, 500)
        ui.Relayout(700, 500)
        T.IsFalse(ui.TakeClick("go"))
    }

    OverlayDrawsOverTheTreeAndClears()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel Width=10 Height=10 Color=0xFF000000/>
        }
        ui.ConfigureAtlas(8, 4)
        ui.OverlayRect(1, 2, 3, 4, 0xFFFFFFFF)
        ui.OverlaySprite(20, 30, 2, 1, 4, 3)
        ui.Layout(100, 100, 0, 0, false)
        T.AreEqual(ui.CommandCount, 3)
        QuaxelUiCommand sprite = ui.GetCommand(2)
        T.AreEqual(sprite.Width, 4)
        T.AreEqual(sprite.Height, 3)
        T.AreEqual(sprite.Cell, -1)
        T.IsTrue(sprite.GlyphFirst == (uint)10)
        T.IsTrue(sprite.GlyphLast == (uint)8)
        T.IsTrue(sprite.Color == (uint)0)
        ui.Relayout(50, 50)
        T.AreEqual(ui.CommandCount, 3)
        ui.ClearOverlay()
        ui.Layout(100, 100, 0, 0, false)
        T.AreEqual(ui.CommandCount, 1)
    }

    AnOutlinedSpriteCarriesItsOutlineColor()
    {
        QuaxelUi ui()
        ui.ConfigureAtlas(8, 4)
        ui.OverlayOutlinedSprite(20, 30, 2, 1, 4, 3, 0xFF101010)
        ui.Layout(100, 100, 0, 0, false)
        T.AreEqual(ui.CommandCount, 1)
        QuaxelUiCommand sprite = ui.GetCommand(0)
        T.AreEqual(sprite.Cell, -1)
        T.IsTrue(sprite.Color == (uint)0xFF101010)
    }

    EverythingLandsOnOnePixelGrid()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiPanel X=5 Y=3 Flow=QuaxelUiFlow.Column Padding=3 Spacing=1 Color=0xFF000000>
                <QuaxelUiText Text="AB"/>
                <QuaxelUiBar Width=7 Height=2 BackColor=0xFF111111/>
                <QuaxelUiButton Text="C"/>
            </QuaxelUiPanel>
        }
        ui.FitPixels(200, 100)
        ui.ConfigureAtlas(8, 8)
        ui.OverlayRect(1, 1, 3, 3, 0xFFFFFFFF)
        ui.OverlayText(9, 9, "D", 0xFFFFFFFF)
        ui.OverlaySprite(11, 13, 0, 0, 2, 2)
        ui.Layout(1000, 300, 0, 0, false)
        T.IsTrue(ui.CommandCount > 6)
        for i : 0; i < ui.CommandCount; i++ {
            QuaxelUiCommand command = ui.GetCommand(i)
            T.AreEqual(command.X % 3, 0)
            T.AreEqual(command.Y % 3, 0)
            T.AreEqual(command.Width % 3, 0)
            T.AreEqual(command.Height % 3, 0)
            T.IsTrue(command.Cell == 0 || command.Cell == 3 || command.Cell == -3)
        }
    }

    ScaleIsTheLargestWholeNumberThatFits()
    {
        QuaxelUi ui()
        T.AreEqual(ui.ScaleFor(4000, 4000), 1)
        ui.FitPixels(200, 270)
        T.AreEqual(ui.ScaleFor(960, 540), 2)
        T.AreEqual(ui.ScaleFor(1920, 1080), 4)
        T.AreEqual(ui.ScaleFor(399, 1080), 1)
        T.AreEqual(ui.ScaleFor(100, 100), 1)
    }

    ClicksAreReadOnTheScaledGrid()
    {
        QuaxelUi ui()
        ui.Content = {
            <QuaxelUiButton Id="go" X=10 Y=10 Width=20 Height=10 Text="GO"/>
        }
        ui.FitPixels(100, 100)
        // Scale 4: the button covers screen pixels 40..119 across.
        ui.Layout(400, 400, 44, 44, false)
        ui.Layout(400, 400, 44, 44, true)
        ui.Layout(400, 400, 44, 44, false)
        T.IsTrue(ui.TakeClick("go"))
        ui.Layout(400, 400, 20, 20, true)
        ui.Layout(400, 400, 20, 20, false)
        T.IsFalse(ui.TakeClick("go"))
    }

    AtlasTracksChangesAndIgnoresOutsideTexels()
    {
        QuaxelUi ui()
        T.IsFalse(ui.AtlasDirty)
        ui.ConfigureAtlas(4, 2)
        T.IsTrue(ui.AtlasDirty)
        T.AreEqual(ui.AtlasWords, 8)
        ui.MarkAtlasUploaded()
        T.IsFalse(ui.AtlasDirty)
        ui.SetAtlasTexel(9, 9, 0xFF112233)
        T.IsFalse(ui.AtlasDirty)
        ui.SetAtlasTexel(3, 1, 0xFF112233)
        T.IsTrue(ui.AtlasDirty)
        T.IsTrue(ui.AtlasTexel(3, 1) == 0xFF112233)
        int [8] copied
        ui.CopyAtlas(&copied[0])
        T.AreEqual(copied[7], (int)0xFF112233)
    }

    EmptyUiDrawsNothing()
    {
        QuaxelUi ui()
        ui.Layout(800, 600, 0, 0, false)
        T.AreEqual(ui.CommandCount, 0)
    }
}
