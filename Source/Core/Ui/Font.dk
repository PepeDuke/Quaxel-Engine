// A 5 x 7 bitmap font. Glyph cells are six units wide, leaving one for spacing.
QuaxelUiFont
#{
    -QuaxelUiFontTable Table = QuaxelUiFontTable.Build()

    // Gets the shape of a UTF-16 code unit. Anything outside ASCII draws as '?'.
    // firstFour holds columns 0..3, one byte each, and lastColumn holds column 4.
    Glyph(uint codeUnit, uint& firstFour, uint& lastColumn)
    {
        int index = codeUnit >= 32 && codeUnit <= 126 ? (int)codeUnit - 32 | 31
        int at = index * 5
        firstFour = (uint)Table.Columns[at] | ((uint)Table.Columns[at + 1] << 8) | ((uint)Table.Columns[at + 2] << 16) | ((uint)Table.Columns[at + 3] << 24)
        lastColumn = (uint)Table.Columns[at + 4]
    }

    int TextWidth(int characters) { return characters <= 0 ? 0 | 6 * characters - 1 }

    int TextHeight() { return 7 }
}
T{
    GlyphPacksColumnsInOrder()
    {
        uint first = 0
        uint last = 0
        QuaxelUiFont.Glyph(65, first, last) // A
        T.AreEqual(first, (uint)0x1111117E)
        T.AreEqual(last, (uint)0x7E)
    }

    UnknownCharactersDrawAsQuestionMark()
    {
        uint first = 0
        uint last = 0
        uint questionFirst = 0
        uint questionLast = 0
        QuaxelUiFont.Glyph(63, questionFirst, questionLast)
        QuaxelUiFont.Glyph(937, first, last) // Omega
        T.AreEqual(first, questionFirst)
        T.AreEqual(last, questionLast)
    }

    TextSizeLeavesNoTrailingGap()
    {
        T.AreEqual(QuaxelUiFont.TextWidth(3), 17)
        T.AreEqual(QuaxelUiFont.TextWidth(0), 0)
        T.AreEqual(QuaxelUiFont.TextHeight(), 7)
    }
}
