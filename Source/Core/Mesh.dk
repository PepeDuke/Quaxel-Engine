// Layout shared with Shaders/Mesh.vert: 24 bytes per vertex.
QuaxelVertex
{
    float X
    float Y
    float Z
    float R
    float G
    float B
}

// Fixed capacity keeps mesh data contiguous so it can be uploaded directly.
QuaxelMeshData
{
    QuaxelVertex [24] Vertices
    uint [36] Indices
    int VertexCount
    int IndexCount
    int RendererHandle = -1
    int VoxelPrimitive // 1 cube, 2 ground slab
    vec3 BaseColor

    -AddVertex(vec3 position, vec3 color)
    {
        Vertices[VertexCount].X = position.X
        Vertices[VertexCount].Y = position.Y
        Vertices[VertexCount].Z = position.Z
        Vertices[VertexCount].R = color.X
        Vertices[VertexCount].G = color.Y
        Vertices[VertexCount].B = color.Z
        VertexCount++
    }

    // Corners run counter-clockwise when seen from outside.
    -AddQuad(vec3 a, vec3 b, vec3 c, vec3 d, vec3 color)
    {
        uint first = (uint)VertexCount
        AddVertex(a, color)
        AddVertex(b, color)
        AddVertex(c, color)
        AddVertex(d, color)
        Indices[IndexCount] = first
        Indices[IndexCount + 1] = first + (uint)1
        Indices[IndexCount + 2] = first + (uint)2
        Indices[IndexCount + 3] = first
        Indices[IndexCount + 4] = first + (uint)2
        Indices[IndexCount + 5] = first + (uint)3
        IndexCount += 6
    }
}
#{
    -vec3 P(float x, float y, float z) { return vec3(x, y, z) }

    // A 1 x 1 quad on the XZ plane, centered on the origin and facing +Y.
    QuaxelMeshData Plane(vec3 color)
    {
        QuaxelMeshData mesh
        mesh.VoxelPrimitive = 2
        mesh.BaseColor = color
        mesh.AddQuad(P(-0.5, 0.0, 0.5), P(0.5, 0.0, 0.5), P(0.5, 0.0, -0.5), P(-0.5, 0.0, -0.5), color)
        return mesh
    }

    // A unit cube centered on the origin. Each face is a different shade of color.
    QuaxelMeshData Cube(vec3 color)
    {
        QuaxelMeshData mesh
        mesh.VoxelPrimitive = 1
        mesh.BaseColor = color
        mesh.AddQuad(P(-0.5, 0.5, 0.5), P(0.5, 0.5, 0.5), P(0.5, 0.5, -0.5), P(-0.5, 0.5, -0.5), color * 1.0) // +Y
        mesh.AddQuad(P(0.5, -0.5, 0.5), P(0.5, -0.5, -0.5), P(0.5, 0.5, -0.5), P(0.5, 0.5, 0.5), color * 0.68) // +X
        mesh.AddQuad(P(-0.5, -0.5, 0.5), P(0.5, -0.5, 0.5), P(0.5, 0.5, 0.5), P(-0.5, 0.5, 0.5), color * 0.42) // +Z
        mesh.AddQuad(P(-0.5, -0.5, -0.5), P(-0.5, -0.5, 0.5), P(-0.5, 0.5, 0.5), P(-0.5, 0.5, -0.5), color * 0.55) // -X
        mesh.AddQuad(P(0.5, -0.5, -0.5), P(-0.5, -0.5, -0.5), P(-0.5, 0.5, -0.5), P(0.5, 0.5, -0.5), color * 0.32) // -Z
        mesh.AddQuad(P(-0.5, -0.5, -0.5), P(0.5, -0.5, -0.5), P(0.5, -0.5, 0.5), P(-0.5, -0.5, 0.5), color * 0.2) // -Y
        return mesh
    }
}
T{
    PlaneIsOneQuadAtZeroHeight()
    {
        QuaxelMeshData mesh = QuaxelMeshData.Plane(vec3(1.0, 1.0, 1.0))
        T.AreEqual(mesh.VertexCount, 4)
        T.AreEqual(mesh.IndexCount, 6)
        for i : 0; i < mesh.VertexCount; i++ {
            T.AreEqual(mesh.Vertices[i].Y, 0.0)
        }
    }

    CubeIsUnitSizedWithSixShades()
    {
        QuaxelMeshData mesh = QuaxelMeshData.Cube(vec3(1.0, 1.0, 1.0))
        T.AreEqual(mesh.VertexCount, 24)
        T.AreEqual(mesh.IndexCount, 36)
        for face : 0; face < 6; face++ {
            for other : face + 1; other < 6; other++ {
                T.AreNotEqual(mesh.Vertices[face * 4].R, mesh.Vertices[other * 4].R)
            }
        }
        for i : 0; i < mesh.VertexCount; i++ {
            T.AreEqual(Math.Abs(mesh.Vertices[i].X), 0.5)
            T.AreEqual(Math.Abs(mesh.Vertices[i].Y), 0.5)
            T.AreEqual(Math.Abs(mesh.Vertices[i].Z), 0.5)
        }
    }
}
