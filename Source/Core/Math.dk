// Right-handed world space: Y is height and XZ is the ground plane.
QuaxelRotation
#{
    // Degrees, by the right-hand rule. Roll about Z applies first, then pitch
    // about X, then yaw about Y.
    quat FromDegrees(float yaw, float pitch, float roll)
    {
        float toRadians = 0.0174532925
        return quat.FromEuler(pitch * toRadians, yaw * toRadians, roll * toRadians)
    }
}
T{
    CrossFollowsRightHandRule()
    {
        vec3 result = Math.Cross(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
        T.AreEqual(result.Z, 1.0)
    }

    NormalizeHandlesZero()
    {
        T.AreEqual(Math.Normalize(vec3(0.0, 0.0, 0.0)).Length(), 0.0)
        vec3 normalized = Math.Normalize(vec3(3.0, 0.0, 4.0))
        T.AreEqual(normalized.X, 0.6)
    }

    DefaultQuatLeavesVectorsExactlyAlone()
    {
        quat none
        vec3 result = none.Rotate(vec3(1.0, 2.0, 3.0))
        T.AreEqual(result.X, 1.0)
        T.AreEqual(result.Y, 2.0)
        T.AreEqual(result.Z, 3.0)
    }

    EulerAnglesFollowTheRightHandRule()
    {
        vec3 forward = vec3(0.0, 0.0, 1.0)
        vec3 up = vec3(0.0, 1.0, 0.0)
        // Yaw turns +Z toward +X, pitch turns +Y toward +Z.
        vec3 yawed = QuaxelRotation.FromDegrees(90.0, 0.0, 0.0).Rotate(forward)
        T.IsTrue(Math.Abs(yawed.X - 1.0) < 0.0001)
        vec3 pitched = QuaxelRotation.FromDegrees(0.0, 90.0, 0.0).Rotate(up)
        T.IsTrue(Math.Abs(pitched.Z - 1.0) < 0.0001)
        vec3 rolled = QuaxelRotation.FromDegrees(0.0, 0.0, 90.0).Rotate(up)
        T.IsTrue(Math.Abs(rolled.X + 1.0) < 0.0001)
    }

    EulerAppliesRollThenPitchThenYaw()
    {
        // Roll takes +Y to -X. Pitch leaves -X alone. Yaw takes -X to +Z.
        vec3 result = QuaxelRotation.FromDegrees(90.0, 90.0, 90.0).Rotate(vec3(0.0, 1.0, 0.0))
        T.IsTrue(Math.Abs(result.Z - 1.0) < 0.0001)
    }

    InverseUndoesARotation()
    {
        quat turn = QuaxelRotation.FromDegrees(30.0, 40.0, 50.0)
        vec3 back = (turn.Inverse() * turn).Rotate(vec3(1.0, 0.0, 0.0))
        T.IsTrue(Math.Abs(back.X - 1.0) < 0.0001)
    }
}

// Builders for the transforms the renderer pushes to shaders. mat4 itself is
// column-major, matching GLSL.
QuaxelMat4
#{
    mat4 Translation(vec3 offset)
    {
        mat4 result = mat4.Identity()
        result[3] = vec4(offset, 1.0)
        return result
    }

    mat4 Scaling(vec3 factors)
    {
        mat4 result = mat4.Identity()
        result[0][0] = factors.X
        result[1][1] = factors.Y
        result[2][2] = factors.Z
        return result
    }

    mat4 LookAt(vec3 eye, vec3 target, vec3 up)
    {
        vec3 forward = Math.Normalize(target - eye)
        vec3 right = Math.Normalize(forward.Cross(up))
        vec3 trueUp = right.Cross(forward)
        mat4 result = mat4.Identity()
        result[0][0] = right.X
        result[1][0] = right.Y
        result[2][0] = right.Z
        result[3][0] = -right.Dot(eye)
        result[0][1] = trueUp.X
        result[1][1] = trueUp.Y
        result[2][1] = trueUp.Z
        result[3][1] = -trueUp.Dot(eye)
        result[0][2] = -forward.X
        result[1][2] = -forward.Y
        result[2][2] = -forward.Z
        result[3][2] = forward.Dot(eye)
        return result
    }

    // Vulkan clip space: X right, Y down, depth 0 at the near plane and 1 at the far plane.
    mat4 Orthographic(float left, float right, float bottom, float top, float near, float far)
    {
        mat4 result
        result[0][0] = 2.0 / (right - left)
        result[1][1] = -2.0 / (top - bottom)
        result[2][2] = -1.0 / (far - near)
        result[3][0] = -(right + left) / (right - left)
        result[3][1] = (top + bottom) / (top - bottom)
        result[3][2] = -near / (far - near)
        result[3][3] = 1.0
        return result
    }
}
T{
    MultiplyAppliesRightOperandFirst()
    {
        mat4 model = QuaxelMat4.Translation(vec3(1.0, 2.0, 3.0)) * QuaxelMat4.Scaling(vec3(2.0, 2.0, 2.0))
        vec4 point = model * vec4(1.0, 1.0, 1.0, 1.0)
        T.AreEqual(point.X, 3.0)
        T.AreEqual(point.Y, 4.0)
        T.AreEqual(point.Z, 5.0)
    }

    LookAtPlacesTargetDownNegativeZ()
    {
        mat4 view = QuaxelMat4.LookAt(vec3(0.0, 0.0, 5.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
        vec4 target = view * vec4(0.0, 0.0, 0.0, 1.0)
        T.AreEqual(target.X, 0.0)
        T.AreEqual(target.Y, 0.0)
        T.AreEqual(target.Z, -5.0)
    }

    OrthographicUsesVulkanClipSpace()
    {
        mat4 projection = QuaxelMat4.Orthographic(-2.0, 2.0, -1.0, 1.0, 1.0, 11.0)
        vec4 nearTopRight = projection * vec4(2.0, 1.0, -1.0, 1.0)
        T.AreEqual(nearTopRight.X, 1.0)
        T.AreEqual(nearTopRight.Y, -1.0)
        T.AreEqual(nearTopRight.Z, 0.0)
        vec4 farBottomLeft = projection * vec4(-2.0, -1.0, -11.0, 1.0)
        T.AreEqual(farBottomLeft.X, -1.0)
        T.AreEqual(farBottomLeft.Y, 1.0)
        T.AreEqual(farBottomLeft.Z, 1.0)
    }
}
