QuaxelComponents
#{
    #int Transform = 1
    #int MeshRenderer = 2
    #int Camera = 4
    #int Voxels = 8
    #int Animator = 16
    #int SocketFollower = 32
}

QuaxelTransform
{
    vec3 Position
    vec3 Scale
    // Horizontal unit vector that local +Z faces. The default is identity.
    float FacingX
    float FacingZ = 1.0
    // Applied before the facing turn. The default is no rotation.
    quat Rotation

    -vec3 Turn(vec3 value)
    {
        vec3 rotated = Rotation.Rotate(value)
        return vec3(
            FacingZ * rotated.X + FacingX * rotated.Z,
            rotated.Y,
            FacingZ * rotated.Z - FacingX * rotated.X)
    }

    mat4 LocalMatrix()
    {
        mat4 local = mat4.Identity()
        local[0] = vec4(Turn(vec3(1.0, 0.0, 0.0)) * Scale.X, 0.0)
        local[1] = vec4(Turn(vec3(0.0, 1.0, 0.0)) * Scale.Y, 0.0)
        local[2] = vec4(Turn(vec3(0.0, 0.0, 1.0)) * Scale.Z, 0.0)
        local[3] = vec4(Position, 1.0)
        return local
    }
}
#{
    QuaxelTransform Make(vec3 position, vec3 scale)
    {
        QuaxelTransform result
        result.Position = position
        result.Scale = scale
        return result
    }
}

QuaxelMeshRenderer
{
    int Mesh
}

// An orthographic camera. The owning node's world position is the eye, so a
// camera attached to a parent node moves with it.
QuaxelCamera
{
    vec3 Direction
    vec3 Up
    float FrameHalfWidth
    float FrameHalfHeight
    float Near
    float Far
    -float HalfWidth
    -float HalfHeight

    // Widens one axis to match the viewport, keeping the whole frame visible
    // and world units square at every window shape.
    UpdateBounds(int width, int height)
    {
        if width <= 0 || height <= 0 { return }
        float aspect = (float)width / (float)height
        HalfHeight = FrameHalfHeight
        HalfWidth = FrameHalfHeight * aspect
        if HalfWidth < FrameHalfWidth {
            HalfWidth = FrameHalfWidth
            HalfHeight = FrameHalfWidth / aspect
        }
    }

    vec3 Forward() { return Math.Normalize(Direction) }

    vec3 Right() { return Math.Normalize(Math.Cross(Forward(), Up)) }

    mat4 ViewProjection(vec3 eye)
    {
        return QuaxelMat4.Orthographic(-HalfWidth, HalfWidth, -HalfHeight, HalfHeight, Near, Far) * QuaxelMat4.LookAt(eye, eye + Direction, Up)
    }
}
@{
    BoundsHalfWidth: HalfWidth
    BoundsHalfHeight: HalfHeight
}
T{
    BoundsKeepFrameVisibleAtAnyAspect()
    {
        QuaxelCamera camera
        camera.FrameHalfWidth = 8.0
        camera.FrameHalfHeight = 4.5
        camera.UpdateBounds(1600, 900)
        T.AreEqual(camera.BoundsHalfWidth, 8.0)
        T.AreEqual(camera.BoundsHalfHeight, 4.5)
        camera.UpdateBounds(1800, 900)
        T.AreEqual(camera.BoundsHalfWidth, 9.0)
        T.AreEqual(camera.BoundsHalfHeight, 4.5)
        camera.UpdateBounds(800, 800)
        T.AreEqual(camera.BoundsHalfWidth, 8.0)
        T.AreEqual(camera.BoundsHalfHeight, 8.0)
    }

    BoundsIgnoreMinimizedViewport()
    {
        QuaxelCamera camera
        camera.FrameHalfWidth = 2.0
        camera.FrameHalfHeight = 1.0
        camera.UpdateBounds(200, 100)
        camera.UpdateBounds(0, 0)
        T.AreEqual(camera.BoundsHalfWidth, 2.0)
    }
}

// Components live inline. Mask records which ones are attached.
QuaxelNode
{
    int Id
    int Parent
    int Mask
    bool Alive
    bool Active
    bool PendingDestroy
    QuaxelTransform Transform
    int Volume
    QuaxelMeshRenderer MeshRenderer
    QuaxelCamera Camera
    QuaxelAnimator Animator
    string Socket
    bool SocketMissing
}

// Node IDs are local to one world. An ID is never reused while the world lives
// and 0 is never a valid node.
QuaxelWorld
{
    -QuaxelNode [] Nodes
    -QuaxelMeshData [] Meshes
    -QuaxelVoxelVolume [] Volumes
    -int [] VolumeHandles
    -bool [] VolumeDirty
    -int [] MeshVolumes
    -QuaxelVoxelAnimation [] Animations
    -int CameraNode
    -bool Stepping
    -bool HasPendingChanges

    bool Exists(int id) { return id >= 1 && id <= Nodes.Len && Nodes[id - 1].Alive }

    bool IsActive(int id) { return Exists(id) && Nodes[id - 1].Active }

    // A node created during a step joins queries once that step ends.
    int CreateNode()
    {
        QuaxelNode node
        node.Id = (int)Nodes.Len + 1
        node.Alive = true
        node.Active = !Stepping
        Nodes += node
        if Stepping { HasPendingChanges = true }
        return node.Id
    }

    int CreateChild(int parent)
    {
        if !Exists(parent) { return 0 }
        int id = CreateNode()
        Nodes[id - 1].Parent = parent
        return id
    }

    int ParentOf(int id) { return Exists(id) ? Nodes[id - 1].Parent | 0 }

    // Pass 0 to detach. Rejects a parent that would create a cycle. Changing the
    // parent also ends any socket attachment.
    bool SetParent(int id, int parent)
    {
        if !Exists(id) || (parent != 0 && !Exists(parent)) { return false }
        int ancestor = parent
        while ancestor != 0 {
            if ancestor == id { return false }
            ancestor = Nodes[ancestor - 1].Parent
        }
        Nodes[id - 1].Parent = parent
        if Has(id, QuaxelComponents.SocketFollower) { Nodes[id - 1].Mask -= QuaxelComponents.SocketFollower }
        Nodes[id - 1].SocketMissing = false
        return true
    }

    // During a step, the node and its descendants stay valid until the step ends.
    bool DestroyNode(int id)
    {
        if !Exists(id) { return false }
        if Stepping {
            Nodes[id - 1].PendingDestroy = true
            HasPendingChanges = true
            return true
        }
        RemoveTree(id)
        return true
    }

    -RemoveTree(int id)
    {
        for i : 0; i < Nodes.Len; i++ {
            if Nodes[i].Alive && Nodes[i].Parent == id { RemoveTree(i + 1) }
        }
        QuaxelNode empty
        empty.Id = id
        Nodes[id - 1] = empty
        if CameraNode == id { CameraNode = 0 }
    }

    BeginStep() { Stepping = true }

    // Applies changes requested during the step, keeping queries stable inside it.
    EndStep()
    {
        Stepping = false
        if !HasPendingChanges { return }
        HasPendingChanges = false
        for i : 0; i < Nodes.Len; i++ {
            if Nodes[i].Alive && Nodes[i].PendingDestroy { RemoveTree(i + 1) }
        }
        for i : 0; i < Nodes.Len; i++ {
            if Nodes[i].Alive { Nodes[i].Active = true }
        }
    }

    // Finds the next active node with every component in mask. Start with 0;
    // 0 is returned when there are no more.
    int NextWith(int after, int mask)
    {
        for i : after; i < Nodes.Len; i++ {
            if Nodes[i].Active && (Nodes[i].Mask & mask) == mask { return i + 1 }
        }
        return 0
    }

    bool Has(int id, int mask) { return Exists(id) && (Nodes[id - 1].Mask & mask) == mask }

    bool AttachTransform(int id, QuaxelTransform transform)
    {
        if !Exists(id) { return false }
        Nodes[id - 1].Transform = transform
        Nodes[id - 1].Mask |= QuaxelComponents.Transform
        return true
    }

    bool AttachMeshRenderer(int id, QuaxelMeshRenderer renderer)
    {
        if !Exists(id) || renderer.Mesh < 0 || renderer.Mesh >= MeshVolumes.Len { return false }
        if !AttachVoxels(id, MeshVolumes[renderer.Mesh]) { return false }
        Nodes[id - 1].MeshRenderer = renderer
        Nodes[id - 1].Mask |= QuaxelComponents.MeshRenderer
        return true
    }

    bool AttachCamera(int id, QuaxelCamera camera)
    {
        if !Exists(id) { return false }
        Nodes[id - 1].Camera = camera
        Nodes[id - 1].Mask |= QuaxelComponents.Camera
        return true
    }

    QuaxelTransform GetTransform(int id) { return Nodes[id - 1].Transform }

    vec3 GetPosition(int id) { return Nodes[id - 1].Transform.Position }

    SetTransform(int id, QuaxelTransform transform) { Nodes[id - 1].Transform = transform }

    int MeshOf(int id) { return Nodes[id - 1].MeshRenderer.Mesh }

    QuaxelCamera GetCamera(int id) { return Nodes[id - 1].Camera }

    SetCamera(int id, QuaxelCamera camera) { Nodes[id - 1].Camera = camera }

    bool SetActiveCamera(int id)
    {
        if !Has(id, QuaxelComponents.Camera) { return false }
        CameraNode = id
        return true
    }

    // Combines this node's transform with those of its ancestors.
    mat4 ModelMatrix(int id)
    {
        mat4 model = mat4.Identity()
        int current = id
        while current != 0 {
            if Has(current, QuaxelComponents.Transform) {
                QuaxelTransform local = Nodes[current - 1].Transform
                model = local.LocalMatrix() * model
            }
            current = Nodes[current - 1].Parent
        }
        return model
    }

    vec3 WorldPosition(int id)
    {
        mat4 model = ModelMatrix(id)
        return vec3(model * vec4(vec3(0.0, 0.0, 0.0), 1.0))
    }

    int CreateVolume(int width, int height, int depth)
    {
        Volumes++
        int index = (int)Volumes.Len - 1
        if !Volumes[index].Configure(width, height, depth) {
            Volumes--
            return -1
        }
        VolumeHandles += -1
        VolumeDirty += true
        return index
    }

    bool SetVoxel(int index, int x, int y, int z, int rgb)
    {
        if index < 0 || index >= Volumes.Len || !Volumes[index].SetVoxel(x, y, z, rgb) { return false }
        VolumeDirty[index] = true
        return true
    }

    int GetVoxel(int index, int x, int y, int z)
    {
        if index < 0 || index >= Volumes.Len { return -1 }
        return Volumes[index].GetVoxel(x, y, z)
    }

    bool NeedsVolumeUpload(int index) { return VolumeDirty[index] }

    bool AttachVoxels(int id, int volume)
    {
        if !Exists(id) || volume < 0 || volume >= Volumes.Len { return false }
        Nodes[id - 1].Volume = volume
        Nodes[id - 1].Mask |= QuaxelComponents.Voxels
        return true
    }

    int VolumeOf(int id) { return Nodes[id - 1].Volume }
    int VolumeHandle(int index) { return VolumeHandles[index] }
    SetVolumeHandle(int index, int handle)
    {
        VolumeHandles[index] = handle
        VolumeDirty[index] = false
    }
    CopyVolume(int index, void* destination) { Volumes[index].CopyTo(destination) }
    int VolumeWords(int index) { return Volumes[index].WordCount }

    mat4 VolumeModel(int id)
    {
        int index = VolumeOf(id)
        return ModelMatrix(id) * QuaxelMat4.Translation(Volumes[index].Center) * QuaxelMat4.Scaling(Volumes[index].Size)
    }

    int CreateAnimation()
    {
        Animations++
        return (int)Animations.Len - 1
    }

    bool HasAnimationClip(int animation, string clipName)
    {
        return animation >= 0 && animation < Animations.Len && Animations[animation].FindClip(clipName) >= 0
    }

    bool AddAnimationClip(int animation, string clipName, bool looping)
    {
        if animation < 0 || animation >= Animations.Len { return false }
        return Animations[animation].AddClip(clipName, looping)
    }

    // Appends to the animation's newest clip. The volume can be shared.
    bool AddAnimationFrame(int animation, int volume, int milliseconds)
    {
        if animation < 0 || animation >= Animations.Len || volume < 0 || volume >= Volumes.Len { return false }
        return Animations[animation].AddFrame(volume, milliseconds)
    }

    // Shows the first frame of the first clip, without playing it.
    bool AttachAnimator(int id, int animation)
    {
        if animation < 0 || animation >= Animations.Len { return false }
        if Animations[animation].ClipCount == 0 || Animations[animation].FrameCount(0) == 0 { return false }
        if !AttachVoxels(id, Animations[animation].FrameVolume(0, 0)) { return false }
        QuaxelAnimator animator
        animator.Animation = animation
        Nodes[id - 1].Animator = animator
        Nodes[id - 1].Mask |= QuaxelComponents.Animator
        return true
    }

    // Starts from the clip's first frame, unless that clip is already playing,
    // so a system can request the same clip on every step.
    bool PlayClip(int id, string clipName)
    {
        if !Has(id, QuaxelComponents.Animator) { return false }
        QuaxelAnimator animator = Nodes[id - 1].Animator
        int clip = Animations[animator.Animation].FindClip(clipName)
        if clip < 0 || Animations[animator.Animation].FrameCount(clip) == 0 { return false }
        if animator.Playing && animator.Clip == clip { return true }
        animator.Clip = clip
        animator.Frame = 0
        animator.Elapsed = 0.0
        animator.Playing = true
        Nodes[id - 1].Animator = animator
        Nodes[id - 1].Volume = Animations[animator.Animation].FrameVolume(clip, 0)
        return true
    }

    // Holds the current frame. The next PlayClip starts from the beginning.
    bool StopClip(int id)
    {
        if !Has(id, QuaxelComponents.Animator) { return false }
        Nodes[id - 1].Animator.Playing = false
        return true
    }

    // 1.0 is normal speed. Zero or less holds the current frame.
    bool SetAnimationSpeed(int id, float speed)
    {
        if !Has(id, QuaxelComponents.Animator) { return false }
        Nodes[id - 1].Animator.Speed = speed
        return true
    }

    QuaxelAnimator GetAnimator(int id) { return Nodes[id - 1].Animator }

    string CurrentClipName(int id)
    {
        QuaxelAnimator animator = Nodes[id - 1].Animator
        return Animations[animator.Animation].ClipName(animator.Clip)
    }

    AdvanceAnimations(float deltaSeconds)
    {
        int mask = QuaxelComponents.Voxels | QuaxelComponents.Animator
        for id : NextWith(0, mask); id != 0; id = NextWith(id, mask) {
            QuaxelAnimator animator = Nodes[id - 1].Animator
            if !animator.Playing { continue }
            Animations[animator.Animation].Advance(animator, deltaSeconds)
            Nodes[id - 1].Animator = animator
            Nodes[id - 1].Volume = Animations[animator.Animation].FrameVolume(animator.Clip, animator.Frame)
        }
        UpdateSockets()
    }

    bool AddSocket(int volume, string socketName, float x, float y, float z, quat rotation)
    {
        if volume < 0 || volume >= Volumes.Len { return false }
        return Volumes[volume].AddSocket(socketName, x, y, z, rotation)
    }

    // Makes id a child that follows the socket on whatever volume the parent is
    // showing. Id's own "grip" socket, if it has one, is the point that lines up.
    // Fails if no volume the parent can show has that socket.
    bool AttachToSocket(int id, int parent, string socket)
    {
        if !Has(parent, QuaxelComponents.Voxels) || !OffersSocket(parent, socket) { return false }
        if !SetParent(id, parent) { return false }
        if !Has(id, QuaxelComponents.Transform) {
            AttachTransform(id, QuaxelTransform.Make(vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)))
        }
        Nodes[id - 1].Socket = socket
        Nodes[id - 1].Mask |= QuaxelComponents.SocketFollower
        FollowSocket(id)
        return true
    }

    -bool OffersSocket(int id, string socket)
    {
        if Volumes[Nodes[id - 1].Volume].FindSocket(socket) >= 0 { return true }
        if !Has(id, QuaxelComponents.Animator) { return false }
        int animation = Nodes[id - 1].Animator.Animation
        for i : 0; i < Animations[animation].TotalFrames; i++ {
            if Volumes[Animations[animation].VolumeAt(i)].FindSocket(socket) >= 0 { return true }
        }
        return false
    }

    // The transform depends only on the parent's volume, not on its pose, so
    // followers can update in any order.
    -FollowSocket(int id)
    {
        int parentVolume = Nodes[Nodes[id - 1].Parent - 1].Volume
        int index = Volumes[parentVolume].FindSocket(Nodes[id - 1].Socket)
        Nodes[id - 1].SocketMissing = index < 0
        if index < 0 { return }
        QuaxelVoxelSocket socket = Volumes[parentVolume].SocketAt(index)
        QuaxelTransform transform = Nodes[id - 1].Transform
        vec3 gripOffset = vec3(0.0, 0.0, 0.0)
        quat rotation = socket.Rotation
        if Has(id, QuaxelComponents.Voxels) {
            int grip = Volumes[Nodes[id - 1].Volume].FindSocket("grip")
            if grip >= 0 {
                QuaxelVoxelSocket held = Volumes[Nodes[id - 1].Volume].SocketAt(grip)
                rotation = socket.Rotation * held.Rotation.Inverse()
                gripOffset = vec3(
                    held.Position.X * transform.Scale.X,
                    held.Position.Y * transform.Scale.Y,
                    held.Position.Z * transform.Scale.Z)
            }
        }
        transform.Rotation = rotation
        transform.FacingX = 0.0
        transform.FacingZ = 1.0
        transform.Position = socket.Position - rotation.Rotate(gripOffset)
        Nodes[id - 1].Transform = transform
    }

    // Runs after every animation advance and after the game's FixedStep, so a
    // PlayClip during the step moves attached items before the frame is drawn.
    UpdateSockets()
    {
        for id : NextWith(0, QuaxelComponents.SocketFollower); id != 0; id = NextWith(id, QuaxelComponents.SocketFollower) {
            FollowSocket(id)
        }
    }

    // True while this node or an ancestor follows a socket its parent's current
    // frame does not define.
    bool IsHidden(int id)
    {
        int current = id
        while current != 0 {
            if Nodes[current - 1].SocketMissing { return true }
            current = Nodes[current - 1].Parent
        }
        return false
    }

    // The socket's pose in world space, from the node's current volume. Returns
    // false if that volume has no such socket.
    bool GetSocketMatrix(int id, string socket, mat4& matrix)
    {
        if !Has(id, QuaxelComponents.Voxels) { return false }
        int index = Volumes[Nodes[id - 1].Volume].FindSocket(socket)
        if index < 0 { return false }
        QuaxelVoxelSocket found = Volumes[Nodes[id - 1].Volume].SocketAt(index)
        QuaxelTransform local = QuaxelTransform.Make(found.Position, vec3(1.0, 1.0, 1.0))
        local.Rotation = found.Rotation
        matrix = ModelMatrix(id) * local.LocalMatrix()
        return true
    }

    // Brightness of the faces whose normals are the volume's X, Y and Z axes.
    // Rotation tilts the faces. Facing does not, so a character keeps its
    // shading as it turns.
    vec3 FaceLights(int id)
    {
        quat rotation
        int current = id
        while current != 0 {
            rotation = Nodes[current - 1].Transform.Rotation * rotation
            current = Nodes[current - 1].Parent
        }
        return vec3(
            AxisLight(rotation.Rotate(vec3(1.0, 0.0, 0.0))),
            AxisLight(rotation.Rotate(vec3(0.0, 1.0, 0.0))),
            AxisLight(rotation.Rotate(vec3(0.0, 0.0, 1.0))))
    }

    -float AxisLight(vec3 normal)
    {
        return normal.Y * normal.Y + 0.68 * normal.X * normal.X + 0.42 * normal.Z * normal.Z
    }

    int AddMesh(QuaxelMeshData mesh)
    {
        int volumeIndex = -1
        if mesh.VoxelPrimitive != 0 {
            volumeIndex = CreateVolume(1, 1, 1)
            if mesh.VoxelPrimitive == 2 {
                Volumes[volumeIndex].Size.Y = 0.0625
                Volumes[volumeIndex].Center.Y = -0.03125
            }
            int red = (int)(Math.Clamp(mesh.BaseColor.X, 0.0, 1.0) * 255.0)
            int green = (int)(Math.Clamp(mesh.BaseColor.Y, 0.0, 1.0) * 255.0)
            int blue = (int)(Math.Clamp(mesh.BaseColor.Z, 0.0, 1.0) * 255.0)
            Volumes[volumeIndex].SetVoxel(0, 0, 0, (red << 16) | (green << 8) | blue)
        }
        MeshVolumes += volumeIndex
        Meshes += mesh
        return (int)Meshes.Len - 1
    }

    QuaxelMeshData GetMesh(int index) { return Meshes[index] }

    SetMeshRendererHandle(int index, int handle) { Meshes[index].RendererHandle = handle }

    int MeshRendererHandle(int index) { return Meshes[index].RendererHandle }

    // Releases every node and component. All node IDs from this world expire.
    Release()
    {
        Nodes.Clear()
        Meshes.Clear()
        MeshVolumes.Clear()
        Volumes.Clear()
        VolumeHandles.Clear()
        VolumeDirty.Clear()
        Animations.Clear()
        CameraNode = 0
        Stepping = false
        HasPendingChanges = false
    }
}
@{
    ActiveCamera: CameraNode
    NodeCount: (int)Nodes.Len
    MeshCount: (int)Meshes.Len
}
T{
    IdsAreLocalAndStartAtOne()
    {
        QuaxelWorld first()
        QuaxelWorld second()
        T.AreEqual(first.CreateNode(), 1)
        T.AreEqual(first.CreateNode(), 2)
        T.AreEqual(second.CreateNode(), 1)
        T.IsFalse(first.Exists(0))
        T.IsFalse(first.Exists(3))
    }

    AttachedComponentsAreQueryable()
    {
        QuaxelWorld world()
        int bare = world.CreateNode()
        int drawn = world.CreateNode()
        QuaxelTransform transform = QuaxelTransform.Make(vec3(1.0, 2.0, 3.0), vec3(1.0, 1.0, 1.0))
        T.IsTrue(world.AttachTransform(bare, transform))
        T.IsTrue(world.AttachTransform(drawn, transform))
        QuaxelMeshRenderer renderer
        renderer.Mesh = world.AddMesh(QuaxelMeshData.Cube(vec3(0.5, 0.5, 0.5)))
        T.IsTrue(world.AttachMeshRenderer(drawn, renderer))
        int mask = QuaxelComponents.Transform | QuaxelComponents.MeshRenderer
        T.AreEqual(world.NextWith(0, mask), drawn)
        T.AreEqual(world.NextWith(drawn, mask), 0)
        T.AreEqual(world.MeshOf(drawn), renderer.Mesh)
        T.IsTrue(world.Has(drawn, QuaxelComponents.Voxels))
        vec3 position = world.GetPosition(bare)
        T.AreEqual(position.Y, 2.0)
    }

    ChangesDuringAStepApplyAfterIt()
    {
        QuaxelWorld world()
        int kept = world.CreateNode()
        int doomed = world.CreateNode()
        world.BeginStep()
        int added = world.CreateNode()
        T.IsFalse(world.IsActive(added))
        T.IsTrue(world.DestroyNode(doomed))
        T.IsTrue(world.IsActive(doomed))
        world.EndStep()
        T.IsTrue(world.IsActive(kept))
        T.IsTrue(world.IsActive(added))
        T.IsFalse(world.Exists(doomed))
    }

    DestroyRemovesDescendants()
    {
        QuaxelWorld world()
        int parent = world.CreateNode()
        int child = world.CreateChild(parent)
        int grandchild = world.CreateChild(child)
        int other = world.CreateNode()
        T.IsTrue(world.DestroyNode(parent))
        T.IsFalse(world.Exists(child))
        T.IsFalse(world.Exists(grandchild))
        T.IsTrue(world.Exists(other))
    }

    SetParentRejectsCycles()
    {
        QuaxelWorld world()
        int a = world.CreateNode()
        int b = world.CreateChild(a)
        T.IsFalse(world.SetParent(a, b))
        T.IsFalse(world.SetParent(a, a))
        T.IsTrue(world.SetParent(b, 0))
        T.AreEqual(world.ParentOf(b), 0)
        T.IsTrue(world.SetParent(a, b))
    }

    ModelMatrixFollowsParents()
    {
        QuaxelWorld world()
        int parent = world.CreateNode()
        int child = world.CreateChild(parent)
        world.AttachTransform(parent, QuaxelTransform.Make(vec3(10.0, 0.0, 0.0), vec3(2.0, 2.0, 2.0)))
        world.AttachTransform(child, QuaxelTransform.Make(vec3(1.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)))
        mat4 model = world.ModelMatrix(child)
        vec3 origin = vec3(model * vec4(vec3(0.0, 0.0, 0.0), 1.0))
        T.AreEqual(origin.X, 12.0)
    }

    WorldPositionFollowsParent()
    {
        QuaxelWorld world()
        int parent = world.CreateNode()
        int child = world.CreateChild(parent)
        world.AttachTransform(parent, QuaxelTransform.Make(vec3(3.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)))
        world.AttachTransform(child, QuaxelTransform.Make(vec3(0.0, 2.0, 0.0), vec3(1.0, 1.0, 1.0)))
        vec3 first = world.WorldPosition(child)
        T.AreEqual(first.X, 3.0)
        T.AreEqual(first.Y, 2.0)
        world.SetTransform(parent, QuaxelTransform.Make(vec3(-1.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)))
        vec3 second = world.WorldPosition(child)
        T.AreEqual(second.X, -1.0)
    }

    ReleaseExpiresNodes()
    {
        QuaxelWorld world()
        int id = world.CreateNode()
        QuaxelCamera camera
        T.IsTrue(world.AttachCamera(id, camera))
        T.IsTrue(world.SetActiveCamera(id))
        world.Release()
        T.IsFalse(world.Exists(id))
        T.AreEqual(world.ActiveCamera, 0)
        T.AreEqual(world.NodeCount, 0)
    }

    RotationAppliesBeforeFacingAndLeavesIdentityExact()
    {
        QuaxelTransform plain = QuaxelTransform.Make(vec3(1.0, 2.0, 3.0), vec3(2.0, 3.0, 4.0))
        mat4 matrix = plain.LocalMatrix()
        T.AreEqual(matrix[0][0], 2.0)
        T.AreEqual(matrix[1][1], 3.0)
        T.AreEqual(matrix[2][2], 4.0)
        T.AreEqual(matrix[3][0], 1.0)
        QuaxelTransform turned = QuaxelTransform.Make(vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
        // Pitch sends +Y to +Z, then facing +X sends +Z to +X.
        turned.Rotation = QuaxelRotation.FromDegrees(0.0, 90.0, 0.0)
        turned.FacingX = 1.0
        turned.FacingZ = 0.0
        mat4 model = turned.LocalMatrix()
        vec3 up = vec3(model * vec4(vec3(0.0, 1.0, 0.0), 1.0))
        T.IsTrue(Math.Abs(up.X - 1.0) < 0.0001)
    }

    SocketRotationAndPositionMoveTheChild()
    {
        QuaxelWorld world()
        int bodyVolume = world.CreateVolume(4, 4, 4)
        // Cell (3, 1, 1) has its center at (1.5, -0.5, -0.5) in a 4^3 grid.
        T.IsTrue(world.AddSocket(bodyVolume, "hand", 3.0, 1.0, 1.0, QuaxelRotation.FromDegrees(0.0, 90.0, 0.0)))
        T.IsFalse(world.AddSocket(bodyVolume, "hand", 0.0, 0.0, 0.0, QuaxelRotation.FromDegrees(0.0, 0.0, 0.0)))
        int body = world.CreateNode()
        world.AttachTransform(body, QuaxelTransform.Make(vec3(10.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)))
        world.AttachVoxels(body, bodyVolume)
        int itemVolume = world.CreateVolume(1, 5, 1)
        // The grip is the bottom cell, 2 units below the item's center.
        world.AddSocket(itemVolume, "grip", 0.0, 0.0, 0.0, QuaxelRotation.FromDegrees(0.0, 0.0, 0.0))
        int item = world.CreateNode()
        world.AttachVoxels(item, itemVolume)
        T.IsTrue(world.AttachToSocket(item, body, "hand"))
        T.AreEqual(world.ParentOf(item), body)
        vec3 center = world.WorldPosition(item)
        // Pitch points the item's +Y along +Z, so its center lies 2 past the hand.
        T.IsTrue(Math.Abs(center.X - 11.5) < 0.0001)
        T.IsTrue(Math.Abs(center.Y + 0.5) < 0.0001)
        T.IsTrue(Math.Abs(center.Z - 1.5) < 0.0001)
    }

    GripRotationIsUndoneAndChildScaleIsRespected()
    {
        QuaxelWorld world()
        int bodyVolume = world.CreateVolume(1, 1, 1)
        world.AddSocket(bodyVolume, "hand", 0.0, 0.0, 0.0, QuaxelRotation.FromDegrees(90.0, 0.0, 0.0))
        int body = world.CreateNode()
        world.AttachVoxels(body, bodyVolume)
        int itemVolume = world.CreateVolume(1, 5, 1)
        world.AddSocket(itemVolume, "grip", 0.0, 0.0, 0.0, QuaxelRotation.FromDegrees(90.0, 0.0, 0.0))
        int item = world.CreateNode()
        world.AttachTransform(item, QuaxelTransform.Make(vec3(0.0, 0.0, 0.0), vec3(2.0, 2.0, 2.0)))
        world.AttachVoxels(item, itemVolume)
        T.IsTrue(world.AttachToSocket(item, body, "hand"))
        // Socket and grip rotations cancel. The grip is 2 cells of 2 units below center.
        vec3 center = world.WorldPosition(item)
        T.IsTrue(Math.Abs(center.Y - 4.0) < 0.0001)
        T.IsTrue(Math.Abs(center.X) < 0.0001)
    }

    SocketPosesChangeWithEachAnimationFrame()
    {
        QuaxelWorld world()
        int animation = world.CreateAnimation()
        world.AddAnimationClip(animation, "swing", true)
        int first = world.CreateVolume(5, 1, 1)
        int second = world.CreateVolume(5, 1, 1)
        world.AddAnimationFrame(animation, first, 250)
        world.AddAnimationFrame(animation, second, 250)
        world.AddSocket(first, "hand", 0.0, 0.0, 0.0, QuaxelRotation.FromDegrees(0.0, 0.0, 0.0))
        world.AddSocket(second, "hand", 4.0, 0.0, 0.0, QuaxelRotation.FromDegrees(90.0, 0.0, 0.0))
        int body = world.CreateNode()
        world.AttachAnimator(body, animation)
        int item = world.CreateNode()
        T.IsTrue(world.AttachToSocket(item, body, "hand"))
        QuaxelTransform pose = world.GetTransform(item)
        T.AreEqual(pose.Position.X, -2.0)
        world.PlayClip(body, "swing")
        world.AdvanceAnimations(0.25)
        pose = world.GetTransform(item)
        T.AreEqual(pose.Position.X, 2.0)
        T.IsTrue(Math.Abs(pose.Rotation.Y - 0.70710678) < 0.0001)
    }

    FramesWithoutTheSocketHideTheChildAndItsChildren()
    {
        QuaxelWorld world()
        int animation = world.CreateAnimation()
        world.AddAnimationClip(animation, "swing", true)
        int first = world.CreateVolume(1, 1, 1)
        int second = world.CreateVolume(1, 1, 1)
        world.AddAnimationFrame(animation, first, 250)
        world.AddAnimationFrame(animation, second, 250)
        world.AddSocket(second, "hand", 0.0, 0.0, 0.0, QuaxelRotation.FromDegrees(0.0, 0.0, 0.0))
        int body = world.CreateNode()
        world.AttachAnimator(body, animation)
        int item = world.CreateNode()
        int gem = world.CreateChild(item)
        // Accepted because a later frame of the animation has the socket.
        T.IsTrue(world.AttachToSocket(item, body, "hand"))
        T.IsTrue(world.IsHidden(item))
        T.IsTrue(world.IsHidden(gem))
        T.IsFalse(world.IsHidden(body))
        world.PlayClip(body, "swing")
        world.AdvanceAnimations(0.25)
        T.IsFalse(world.IsHidden(item))
        T.IsFalse(world.IsHidden(gem))
    }

    AttachToSocketRejectsNamesNoFrameDefines()
    {
        QuaxelWorld world()
        int volume = world.CreateVolume(1, 1, 1)
        int body = world.CreateNode()
        world.AttachVoxels(body, volume)
        int item = world.CreateNode()
        T.IsFalse(world.AttachToSocket(item, body, "typo"))
        T.AreEqual(world.ParentOf(item), 0)
    }

    ChangingTheParentEndsTheAttachment()
    {
        QuaxelWorld world()
        int volume = world.CreateVolume(1, 1, 1)
        world.AddSocket(volume, "hand", 0.0, 0.0, 0.0, QuaxelRotation.FromDegrees(0.0, 0.0, 0.0))
        int body = world.CreateNode()
        world.AttachVoxels(body, volume)
        int item = world.CreateNode()
        world.AttachToSocket(item, body, "hand")
        T.IsTrue(world.SetParent(item, 0))
        T.IsFalse(world.Has(item, QuaxelComponents.SocketFollower))
        world.UpdateSockets()
        T.AreEqual(world.ParentOf(item), 0)
    }

    GetSocketMatrixReportsWorldPose()
    {
        QuaxelWorld world()
        int volume = world.CreateVolume(2, 2, 2)
        world.AddSocket(volume, "tip", 1.0, 1.0, 1.0, QuaxelRotation.FromDegrees(0.0, 90.0, 0.0))
        int node = world.CreateNode()
        world.AttachTransform(node, QuaxelTransform.Make(vec3(5.0, 0.0, 0.0), vec3(2.0, 2.0, 2.0)))
        world.AttachVoxels(node, volume)
        mat4 matrix = mat4.Identity()
        T.IsTrue(world.GetSocketMatrix(node, "tip", matrix))
        vec3 origin = vec3(matrix * vec4(vec3(0.0, 0.0, 0.0), 1.0))
        T.AreEqual(origin.X, 6.0)
        T.IsFalse(world.GetSocketMatrix(node, "none", matrix))
    }

    FaceLightsFollowRotationButNotFacing()
    {
        QuaxelWorld world()
        int node = world.CreateNode()
        QuaxelTransform pose = QuaxelTransform.Make(vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
        pose.FacingX = 0.70710678
        pose.FacingZ = 0.70710678
        world.AttachTransform(node, pose)
        vec3 lights = world.FaceLights(node)
        T.AreEqual(lights.X, 0.68)
        T.AreEqual(lights.Y, 1.0)
        T.AreEqual(lights.Z, 0.42)
        // Rolling 90 degrees swaps which local axes face up and sideways.
        pose.Rotation = QuaxelRotation.FromDegrees(0.0, 0.0, 90.0)
        world.SetTransform(node, pose)
        lights = world.FaceLights(node)
        T.IsTrue(Math.Abs(lights.X - 1.0) < 0.0001)
        T.IsTrue(Math.Abs(lights.Y - 0.68) < 0.0001)
    }

    DestroyingActiveCameraClearsIt()
    {
        QuaxelWorld world()
        int id = world.CreateNode()
        QuaxelCamera camera
        world.AttachCamera(id, camera)
        world.SetActiveCamera(id)
        world.DestroyNode(id)
        T.AreEqual(world.ActiveCamera, 0)
    }
}

// The game derives from this and overrides what it needs. It outlives its worlds.
QuaxelGameInstance
{
    string WindowTitle() { return "Quaxel" }

    int WindowWidth() { return 960 }

    int WindowHeight() { return 540 }

    // Steps to simulate when no window is available, as there is nothing to close.
    int HeadlessSteps() { return 3 }

    // Builds the initial world before it is activated. Return false to abort startup.
    bool Prepare(QuaxelWorld& world) { return true }

    // Runs once per fixed simulation step.
    FixedStep(QuaxelWorld& world, QuaxelInputState& input, float deltaSeconds) {}

    // Builds the UI once at startup, using Duck markup. The engine owns the result.
    markup BuildUi()
    {
        markup none
        return none
    }

    // Runs once per frame, after fixed steps and before the UI is drawn.
    UpdateUi(QuaxelUi& ui, QuaxelWorld& world) {}

    // Runs after the world has been released.
    Stopped() {}
}
