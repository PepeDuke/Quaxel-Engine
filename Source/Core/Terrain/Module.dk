// Unloaded marks a column whose chunk is not resident.
QuaxelTerrainKind : int
#@{
    Unloaded: -1,
    Open,
    Mountain,
    Water,
    Structure
}

// Games may add their own IDs from Custom upward and color them in SurfaceColor.
QuaxelTerrainSurface
#{
    #int Grass = 0
    #int Rock = 1
    #int Water = 2
    #int Bridge = 3
    #int Yard = 4
    #int Path = 5
    #int Custom = 16
}

// Everything SurfaceColor needs to color one voxel.
QuaxelTerrainCell
{
    int Surface
    int Column
    int Row
    int Y
    int Height
    bool Top
    int Hash
    // 0 in the open, rising to 1 against the foot of a mountain.
    float Wall
}

// One column being generated. Height is the number of solid cells.
QuaxelTerrainColumn
{
    int Floor
    int Height
    int Surface
    QuaxelTerrainKind Kind

    MakeWater(int depth)
    {
        Height = Floor - depth
        Surface = QuaxelTerrainSurface.Water
        Kind = QuaxelTerrainKind.Water
    }

    // Blocks the column at a height above the floor.
    MakeBlocked(int rise, int surface)
    {
        Height = Floor + rise
        Surface = surface
        Kind = QuaxelTerrainKind.Structure
    }
}

// What a module needs from a clearing. Plain data, read by the router.
QuaxelTerrainModuleRules
{
    float MinRadius
    int MinPorts = 1
    int MaxPorts = 4
    // The clearing must not overlap any other.
    bool Isolated
    // The fraction of clearings wanted, from 0 to 1.
    float Share
    int MaxCount = 1000000
}

// A voxel model a module would like in its clearing.
QuaxelTerrainOffer
{
    int Group
    int Volume
    float X
    float Z
    int Half
    int Height
    // How tall a model counts when working out what it hides.
    int Sight
    // World size of one model voxel.
    float VoxelSize = 0.125
    // A prop blocks only its footprint, leaves the ground as it is and may hide
    // what is behind it, as a thin dead tree barely does.
    bool Prop
    // Baked firelight. The offset is in columns from the model's center.
    int LightX
    int LightZ
    int LightRadius
}

// Collects a module's placement requests. The generator accepts at most one
// offer per group, the first that passes its checks.
QuaxelTerrainPlacer
{
    QuaxelTerrainOffer [] Offers

    // X and Z are layout-space offsets from the clearing center. Half and Height
    // are in columns; the model's footprint is Half * 2 square.
    Offer(int group, int volume, float x, float z, int half, int height)
    {
        OfferModel(group, volume, x, z, half, height, height, 0.125, false)
    }

    // A building whose voxels are finer than a terrain column. Sight may be lower
    // than Height when only a slim part, such as a bell tower, rises above the rest.
    OfferBuilding(int group, int volume, float x, float z, int half, int height, int sight, float voxelSize)
    {
        OfferModel(group, volume, x, z, half, height, sight, voxelSize, false)
    }

    OfferProp(int group, int volume, float x, float z, int half, int height, float voxelSize)
    {
        OfferModel(group, volume, x, z, half, height, 0, voxelSize, true)
    }

    // Gives the most recent offer a warm light baked into the ground around it.
    AddLight(int offsetX, int offsetZ, int radius)
    {
        int last = (int)Offers.Len - 1
        Offers[last].LightX = offsetX
        Offers[last].LightZ = offsetZ
        Offers[last].LightRadius = radius
    }

    -OfferModel(int group, int volume, float x, float z, int half, int height, int sight, float voxelSize, bool prop)
    {
        QuaxelTerrainOffer offer
        offer.Group = group
        offer.Volume = volume
        offer.X = x
        offer.Z = z
        offer.Half = half
        offer.Height = height
        offer.Sight = sight
        offer.VoxelSize = voxelSize
        offer.Prop = prop
        Offers += offer
    }
}

// The base module holds the rules and the defaults, which give a plain valley.
// A variant overrides only what differs. A module must be a pure function of the
// site and position, taking randomness only from site.Seed.
QuaxelTerrainModule
{
    QuaxelTerrainModuleRules Rules()
    {
        QuaxelTerrainModuleRules rules
        return rules
    }

    // Edits one column of this module's clearing. X and Z are layout-space
    // offsets from the clearing center.
    Column(QuaxelTerrainSite site, float x, float z, QuaxelTerrainColumn& column) {}

    // Requests voxel models, once per clearing.
    Place(QuaxelTerrainSite site, QuaxelTerrainPlacer& placer) {}
}
