QuaxelAudioSource
{
    float InnerRadius = 1.0
    float OuterRadius = 20.0
}

// The room a world's reverb imitates. All values range from 0 to 1.
QuaxelReverbSettings
{
    // Small rooms die away quickly; large halls ring for seconds.
    float RoomSize = 0.5
    // How much soft furnishings swallow the high end of the tail.
    float Damping = 0.5
    // Level of the reverb added to the dry mix.
    float Wet = 0.3
}

// A Freeverb-style reverb: four parallel damped comb filters into two
// allpass filters per channel, the right channel's delays slightly longer to
// widen the tail. It runs on 48 kHz mono input and writes stereo.
QuaxelReverb
{
    QuaxelReverbSettings Settings
    // Every filter's delay line, one after another.
    -float [] Lines
    -int [12] Start
    -int [12] Length
    -int [12] Cursor
    // The low-pass memory of each comb filter.
    -float [8] Store

    -Allocate()
    {
        // Freeverb's tunings, scaled from 44.1 to 48 kHz. Combs come first,
        // left then right, then the allpasses.
        int [6] tuning = {1214, 1293, 1390, 1476, 605, 480}
        int offset = 0
        for side : 0; side < 2; side++ {
            for k : 0; k < 6; k++ {
                int filter = k < 4 ? side * 4 + k | 8 + side * 2 + (k - 4)
                Start[filter] = offset
                Length[filter] = tuning[k] + side * 23
                Cursor[filter] = 0
                offset += Length[filter]
            }
        }
        for i : 0; i < offset; i++ { Lines += 0.0 }
    }

    // Adds the reverb of one block of send to the stereo mix.
    Process(float [800]& send, float [1600]& mix)
    {
        if Lines.Len == 0 { Allocate() }
        float feedback = 0.7 + 0.28 * Math.Clamp(Settings.RoomSize, 0.0, 1.0)
        float damp = 0.4 * Math.Clamp(Settings.Damping, 0.0, 1.0)
        float wet = 3.0 * Math.Clamp(Settings.Wet, 0.0, 1.0)
        for i : 0; i < 800; i++ {
            float input = send[i] * 0.03
            for side : 0; side < 2; side++ {
                float sum = 0.0
                for k : 0; k < 4; k++ {
                    int c = side * 4 + k
                    int at = Start[c] + Cursor[c]
                    float echo = Lines[at]
                    Store[c] = echo * (1.0 - damp) + Store[c] * damp
                    Lines[at] = input + Store[c] * feedback
                    Cursor[c]++
                    if Cursor[c] == Length[c] { Cursor[c] = 0 }
                    sum += echo
                }
                for k : 0; k < 2; k++ {
                    int a = 8 + side * 2 + k
                    int at = Start[a] + Cursor[a]
                    float delayed = Lines[at]
                    Lines[at] = sum + delayed * 0.5
                    sum = delayed - sum
                    Cursor[a]++
                    if Cursor[a] == Length[a] { Cursor[a] = 0 }
                }
                mix[2 * i + side] += sum * wet
            }
        }
    }

    // Silences the tail without changing the settings.
    Clear()
    {
        for i : 0; i < Lines.Len; i++ { Lines[i] = 0.0 }
        for c : 0; c < 8; c++ { Store[c] = 0.0 }
    }
}

// Interchangeable clips, such as footsteps. Each play picks one at random,
// never the one played just before, and varies its pitch and gain.
QuaxelSoundGroup
{
    // Clip handles, from LoadSound or AddSound.
    int [] Clips
    // A fraction: 0.06 plays from 0.94 to 1.06 times the clip's speed.
    float PitchJitter
    // A fraction: 0.2 takes up to a fifth off the gain.
    float GainJitter
    // Index into Clips of the last pick, or -1.
    int Last = -1
}

QuaxelSoundClip
{
    int Rate
    int Channels
    int16 [] Samples

    // Send is the share of the voice also fed to the reverb, as mono.
    MixVoice(QuaxelVoice& voice, float left, float right, float [1600]& mix, float send, float [800]& reverb)
    {
        int channels = Channels
        int frames = (int)Samples.Len / channels
        for i : 0; i < 800; i++ {
            int next = voice.Frame + 1
            if next == frames { next = voice.Looping ? 0 | voice.Frame }
            int a = voice.Frame * channels
            int b = next * channels
            float blend = (float)voice.Phase / 48000.0
            float l = (float)Samples[a] + blend * ((float)Samples[b] - (float)Samples[a])
            float r = l
            if channels == 2 {
                r = (float)Samples[a + 1] + blend * ((float)Samples[b + 1] - (float)Samples[a + 1])
                if voice.Node != 0 {
                    l = (l + r) * 0.5
                    r = l
                }
            }
            mix[2 * i] += l * left
            mix[2 * i + 1] += r * right
            if send > 0.0 { reverb[i] += (l * left + r * right) * 0.5 * send }
            voice.Phase += voice.Step
            voice.Frame += voice.Phase / 48000
            voice.Phase %= 48000
            if voice.Frame >= frames {
                if !voice.Looping {
                    voice.Id = 0
                    return
                }
                voice.Frame %= frames
            }
        }
    }
}

QuaxelVoice
{
    long Id
    int Clip
    int Node
    int Frame
    int Phase
    // Source frames per output second: the clip's rate times the pitch.
    int Step
    float Gain
    // From 0 to 1, how much of the voice goes to the world's reverb.
    float ReverbSend
    bool Looping
}

QuaxelWorld
{
    -QuaxelSoundClip [] Sounds
    -QuaxelVoice [] Voices
    -long LastVoice
    -QuaxelSoundGroup [] SoundGroups
    -QuaxelRandom SoundRandom
    -bool SoundRandomSeeded
    -QuaxelReverb Reverb
    // True from the first send until the reverb is cleared, so the tail rings out.
    -bool ReverbActive
    // Every sound effect's level, from 0 (silent) to 1, as a game's options
    // set it. The music has its own, Music.Volume.
    float EffectsVolume = 1.0

    // Clip handles start at one. Samples are signed interleaved PCM.
    int AddSound(QuaxelSoundClip& clip)
    {
        if clip.Channels != 1 && clip.Channels != 2 { return 0 }
        if clip.Rate <= 0 || clip.Rate > 384000 || clip.Samples.Len == 0 || clip.Samples.Len > 2147483640 || clip.Samples.Len % clip.Channels != 0 { return 0 }
        Sounds++
        int index = (int)Sounds.Len - 1
        Sounds[index].Rate = clip.Rate
        Sounds[index].Channels = clip.Channels
        for sample : clip.Samples { Sounds[index].Samples += sample }
        return (int)Sounds.Len
    }

    int LoadSound(string path)
    {
        uint8 [] bytes
        if !QuaxelFiles.ReadBytes(path, bytes) { return 0 }
        Sounds++
        int index = (int)Sounds.Len - 1
        if !Sounds[index].DecodeWave(bytes) {
            Sounds--
            return 0
        }
        return index + 1
    }

    bool SetAudioSource(int node, QuaxelAudioSource source)
    {
        if !Has(node, QuaxelComponents.Transform) || !(source.InnerRadius >= 0.0 && source.OuterRadius > source.InnerRadius) { return false }
        Nodes[node - 1].AudioSource = source
        Nodes[node - 1].Mask |= QuaxelComponents.AudioSource
        return true
    }

    // Sets the room every voice's reverb send plays into. A tail already ringing
    // carries on into the new room.
    bool SetReverb(QuaxelReverbSettings settings)
    {
        if !(settings.RoomSize >= 0.0 && settings.RoomSize <= 1.0) || !(settings.Damping >= 0.0 && settings.Damping <= 1.0) || !(settings.Wet >= 0.0 && settings.Wet <= 1.0) { return false }
        Reverb.Settings = settings
        return true
    }

    QuaxelReverbSettings GetReverb() { return Reverb.Settings }

    // Stops the reverb tail at once, as when cutting to another place.
    ClearReverb()
    {
        Reverb.Clear()
        ReverbActive = false
    }

    // Sends part of a playing voice to the reverb, from 0 (dry) to 1. Call it
    // right after PlaySound or PlaySoundGroup, with the handle they gave.
    bool SetVoiceReverb(long voice, float send)
    {
        if voice <= 0 || !(send >= 0.0 && send <= 1.0) { return false }
        for i : 0; i < Voices.Len; i++ {
            if Voices[i].Id == voice {
                Voices[i].ReverbSend = send
                return true
            }
        }
        return false
    }

    // Group handles start at one. Jitters are fractions from 0 to 0.5.
    int CreateSoundGroup(float pitchJitter, float gainJitter)
    {
        if !(pitchJitter >= 0.0 && pitchJitter <= 0.5) || !(gainJitter >= 0.0 && gainJitter <= 0.5) { return 0 }
        SoundGroups++
        int index = (int)SoundGroups.Len - 1
        SoundGroups[index].PitchJitter = pitchJitter
        SoundGroups[index].GainJitter = gainJitter
        return index + 1
    }

    bool AddToSoundGroup(int group, int clip)
    {
        if group <= 0 || group > SoundGroups.Len || clip <= 0 || clip > Sounds.Len { return false }
        SoundGroups[group - 1].Clips += clip
        return true
    }

    // Loads each file into a new group. Files that fail to load are left out,
    // and the group is zero only when none loads.
    int LoadSoundGroup(string []& paths, float pitchJitter, float gainJitter)
    {
        int group = CreateSoundGroup(pitchJitter, gainJitter)
        if group == 0 { return 0 }
        for path : paths {
            int clip = LoadSound(path)
            if clip > 0 { AddToSoundGroup(group, clip) }
        }
        if SoundGroups[group - 1].Clips.Len > 0 { return group }
        SoundGroups--
        return 0
    }

    int SoundGroupSize(int group)
    {
        if group <= 0 || group > SoundGroups.Len { return 0 }
        return (int)SoundGroups[group - 1].Clips.Len
    }

    // Makes the group picks and jitter repeat from the same seed.
    SeedSoundRandom(uint seed)
    {
        SoundRandom.Begin(seed)
        SoundRandomSeeded = true
    }

    // Plays one of the group's clips, as PlaySound does.
    long PlaySoundGroup(int group, int node, float gain, bool looping)
    {
        return PlaySoundGroupPitched(group, node, gain, looping, 1.0)
    }

    // As PlaySoundGroup, around a base pitch from 0.25 to 4, so one group can
    // voice a small creature high and a big one low. The jitter applies on top.
    long PlaySoundGroupPitched(int group, int node, float gain, bool looping, float basePitch)
    {
        if !(basePitch >= 0.25 && basePitch <= 4.0) { return 0 }
        if group <= 0 || group > SoundGroups.Len || !(gain >= 0.0 && gain <= 1.0) { return 0 }
        int count = (int)SoundGroups[group - 1].Clips.Len
        if count == 0 { return 0 }
        if !SoundRandomSeeded { SeedSoundRandom((uint)0x51ED) }
        int last = SoundGroups[group - 1].Last
        int pick = 0
        if count > 1 {
            if last < 0 || last >= count { pick = SoundRandom.Below(count) }
            else {
                // One of the others, evenly.
                pick = SoundRandom.Below(count - 1)
                if pick >= last { pick++ }
            }
        }
        SoundGroups[group - 1].Last = pick
        float pitchJitter = SoundGroups[group - 1].PitchJitter
        float pitch = Math.Clamp(basePitch * SoundRandom.Range(1.0 - pitchJitter, 1.0 + pitchJitter), 0.25, 4.0)
        float scaled = gain * (1.0 - SoundGroups[group - 1].GainJitter * SoundRandom.Unit())
        return PlayVoice(SoundGroups[group - 1].Clips[pick], node, scaled, looping, pitch)
    }

    // Node zero plays in stereo independently of the camera.
    long PlaySound(int clip, int node, float gain, bool looping)
    {
        return PlayVoice(clip, node, gain, looping, 1.0)
    }

    // Pitch scales the playback speed; 2.0 plays an octave up in half the time.
    long PlaySoundPitched(int clip, int node, float gain, bool looping, float pitch)
    {
        if !(pitch >= 0.25 && pitch <= 4.0) { return 0 }
        return PlayVoice(clip, node, gain, looping, pitch)
    }

    -long PlayVoice(int clip, int node, float gain, bool looping, float pitch)
    {
        if clip <= 0 || clip > Sounds.Len || !(gain >= 0.0 && gain <= 1.0) { return 0 }
        if node != 0 && !Has(node, QuaxelComponents.AudioSource) { return 0 }
        int slot = 0
        while slot < Voices.Len && Voices[slot].Id != 0 { slot++ }
        if slot == 128 { return 0 }
        if slot == Voices.Len { Voices++ }
        QuaxelVoice voice
        LastVoice++
        voice.Id = LastVoice
        voice.Clip = clip - 1
        voice.Step = Math.Max(1, (int)((float)Sounds[clip - 1].Rate * pitch + 0.5))
        voice.Node = node
        voice.Gain = gain
        voice.Looping = looping
        Voices[slot] = voice
        return voice.Id
    }

    bool StopSound(long voice)
    {
        if voice <= 0 { return false }
        for i : 0; i < Voices.Len; i++ {
            if Voices[i].Id == voice {
                Voices[i].Id = 0
                return true
            }
        }
        return false
    }

    // 1/60 second of interleaved 48 kHz stereo per block: the sound effects
    // and the music.
    MixAudio(int16 [1600]& output)
    {
        float [1600] mix
        MixEffects(mix)
        Music.Mix(mix)
        for i : 0; i < 1600; i++ { output[i] = (int16)Math.Clamp(mix[i], -32768.0, 32767.0) }
    }

    // Adds one block of the sound effects alone, with their reverb, to mix in
    // sample units. With an audio thread the main thread mixes these each
    // step and the thread adds the music; see QuaxelMusic.Exchange.
    MixEffects(float [1600]& mix)
    {
        float [800] send
        vec3 eye
        vec3 right
        bool listener = Has(CameraNode, QuaxelComponents.Transform)
        if listener {
            eye = WorldPosition(CameraNode)
            right = Nodes[CameraNode - 1].Camera.Right()
        }
        for i : 0; i < Voices.Len; i++ {
            QuaxelVoice voice = Voices[i]
            if voice.Id == 0 { continue }
            float level = voice.Gain * Math.Clamp(EffectsVolume, 0.0, 1.0)
            float left = level
            float r = level
            if voice.Node != 0 {
                if !Has(voice.Node, QuaxelComponents.AudioSource) {
                    Voices[i].Id = 0
                    continue
                }
                QuaxelAudioSource source = Nodes[voice.Node - 1].AudioSource
                vec3 offset = WorldPosition(voice.Node) - eye
                float distance = offset.Length()
                float t = Math.Clamp((distance - source.InnerRadius) / (source.OuterRadius - source.InnerRadius), 0.0, 1.0)
                float volume = listener ? level * (1.0 - t * t * (3.0 - 2.0 * t)) | 0.0
                float pan = distance > 0.00001 ? Math.Clamp(Math.Dot(offset, right) / distance, -1.0, 1.0) | 0.0
                left = volume * Math.Sqrt(0.5 * (1.0 - pan))
                r = volume * Math.Sqrt(0.5 * (1.0 + pan))
            }
            if voice.ReverbSend > 0.0 { ReverbActive = true }
            Sounds[voice.Clip].MixVoice(voice, left, r, mix, voice.ReverbSend, send)
            Voices[i] = voice
        }
        if ReverbActive { Reverb.Process(send, mix) }
    }

}
T{
    ReverbSendLeavesATailThatRingsOutAndClears()
    {
        QuaxelWorld world()
        QuaxelSoundClip clip
        clip.Rate = 48000
        clip.Channels = 1
        clip.Samples += (int16)20000
        int sound = world.AddSound(clip)
        QuaxelReverbSettings room
        room.RoomSize = 0.8
        room.Wet = 1.0
        T.IsTrue(world.SetReverb(room))
        long voice = world.PlaySound(sound, 0, 1.0, false)
        T.IsTrue(world.SetVoiceReverb(voice, 1.0))
        int16 [1600] block
        world.MixAudio(block)
        // The dry impulse alone, since the shortest comb is 1214 frames long.
        T.AreEqual((int)block[0], 20000)
        for i : 2; i < 1600; i++ { T.AreEqual((int)block[i], 0) }
        world.MixAudio(block)
        bool echoed = false
        for i : 0; i < 1600; i++ { if block[i] != (int16)0 { echoed = true } }
        T.IsTrue(echoed)
        // Still ringing a few blocks later, with no voice playing.
        for b : 0; b < 5; b++ { world.MixAudio(block) }
        bool ringing = false
        for i : 0; i < 1600; i++ { if block[i] != (int16)0 { ringing = true } }
        T.IsTrue(ringing)
        world.ClearReverb()
        world.MixAudio(block)
        for i : 0; i < 1600; i++ { T.AreEqual((int)block[i], 0) }
    }

    DryVoicesGetNoReverb()
    {
        QuaxelWorld world()
        QuaxelSoundClip clip
        clip.Rate = 48000
        clip.Channels = 1
        clip.Samples += (int16)20000
        int sound = world.AddSound(clip)
        QuaxelReverbSettings room
        room.Wet = 1.0
        world.SetReverb(room)
        world.PlaySound(sound, 0, 1.0, false)
        int16 [1600] block
        world.MixAudio(block)
        for i : 2; i < 1600; i++ { T.AreEqual((int)block[i], 0) }
    }

    ReverbRejectsBadValues()
    {
        QuaxelWorld world()
        QuaxelReverbSettings room
        room.Wet = 1.5
        T.IsFalse(world.SetReverb(room))
        QuaxelReverbSettings kept = world.GetReverb()
        T.AreEqual(kept.Wet, 0.3)
        T.IsFalse(world.SetVoiceReverb(0, 0.5))
        T.IsFalse(world.SetVoiceReverb(99, 0.5))
        QuaxelSoundClip clip
        clip.Rate = 48000
        clip.Channels = 1
        clip.Samples += (int16)1
        long voice = world.PlaySound(world.AddSound(clip), 0, 1.0, true)
        T.IsFalse(world.SetVoiceReverb(voice, -0.1))
        T.IsTrue(world.SetVoiceReverb(voice, 0.0))
    }

    GroupNeverRepeatsItsLastPick()
    {
        QuaxelWorld world()
        int group = world.CreateSoundGroup(0.0, 0.0)
        for value : 1...3 {
            QuaxelSoundClip clip
            clip.Rate = 48000
            clip.Channels = 1
            clip.Samples += (int16)(value * 1000)
            T.IsTrue(world.AddToSoundGroup(group, world.AddSound(clip)))
        }
        T.AreEqual(world.SoundGroupSize(group), 3)
        world.SeedSoundRandom((uint)7)
        int previous = 0
        int [4] seen
        for i : 0; i < 30; i++ {
            T.IsTrue(world.PlaySoundGroup(group, 0, 1.0, false) > 0)
            int16 [1600] block
            world.MixAudio(block)
            int value = (int)block[0]
            T.IsTrue(value != previous)
            seen[value / 1000] += 1
            previous = value
        }
        T.IsTrue(seen[1] > 0 && seen[2] > 0 && seen[3] > 0)
    }

    GroupGainJitterOnlyLowers()
    {
        QuaxelWorld world()
        QuaxelSoundClip clip
        clip.Rate = 48000
        clip.Channels = 1
        clip.Samples += (int16)10000
        int group = world.CreateSoundGroup(0.0, 0.5)
        world.AddToSoundGroup(group, world.AddSound(clip))
        for i : 0; i < 10; i++ {
            world.PlaySoundGroup(group, 0, 1.0, false)
            int16 [1600] block
            world.MixAudio(block)
            T.IsTrue(block[0] >= (int16)5000 && block[0] <= (int16)10000)
        }
    }

    BadGroupsAndMissingFilesGiveZero()
    {
        QuaxelWorld world()
        T.AreEqual(world.CreateSoundGroup(0.6, 0.0), 0)
        T.AreEqual(world.PlaySoundGroup(1, 0, 1.0, false), (long)0)
        int empty = world.CreateSoundGroup(0.0, 0.0)
        T.AreEqual(world.PlaySoundGroup(empty, 0, 1.0, false), (long)0)
        T.IsFalse(world.AddToSoundGroup(empty, 1))
        string [] paths = {"Missing/one.wav", "Missing/two.wav"}
        T.AreEqual(world.LoadSoundGroup(paths, 0.0, 0.0), 0)
        T.AreEqual(world.SoundGroupSize(empty), 0)
    }

    GroupBasePitchSetsTheSpeed()
    {
        QuaxelWorld world()
        QuaxelSoundClip clip
        clip.Rate = 48000
        clip.Channels = 1
        clip.Samples += (int16)0
        clip.Samples += (int16)1000
        int group = world.CreateSoundGroup(0.0, 0.0)
        world.AddToSoundGroup(group, world.AddSound(clip))
        T.AreEqual(world.PlaySoundGroupPitched(group, 0, 1.0, false, 5.0), (long)0)
        T.IsTrue(world.PlaySoundGroupPitched(group, 0, 1.0, false, 0.5) > 0)
        int16 [1600] block
        world.MixAudio(block)
        T.AreEqual((int)block[2], 500)
    }

    HalfPitchPlaysAtHalfSpeed()
    {
        QuaxelWorld world()
        QuaxelSoundClip clip
        clip.Rate = 48000
        clip.Channels = 1
        clip.Samples += (int16)0
        clip.Samples += (int16)1000
        int sound = world.AddSound(clip)
        T.AreEqual(world.PlaySoundPitched(sound, 0, 1.0, false, 5.0), (long)0)
        T.IsTrue(world.PlaySoundPitched(sound, 0, 1.0, false, 0.5) > 0)
        int16 [1600] block
        world.MixAudio(block)
        T.AreEqual((int)block[0], 0)
        T.AreEqual((int)block[2], 500)
        T.AreEqual((int)block[4], 1000)
    }

    OverlapLoopStopAndReuse()
    {
        QuaxelWorld world()
        QuaxelSoundClip clip
        clip.Rate = 24000
        clip.Channels = 2
        clip.Samples += (int16)22000
        clip.Samples += (int16)-22000
        int sound = world.AddSound(clip)
        long first = world.PlaySound(sound, 0, 1.0, true)
        long second = world.PlaySound(sound, 0, 1.0, false)
        T.IsTrue(first > 0 && second > first)
        int16 [1600] block
        world.MixAudio(block)
        T.AreEqual((int)block[0], 32767)
        T.AreEqual((int)block[1], -32768)
        T.AreEqual((int)block[4], 22000)
        T.IsFalse(world.StopSound(second))
        T.IsTrue(world.StopSound(first))
        long replacement = world.PlaySound(sound, 0, 0.5, true)
        T.IsFalse(world.StopSound(first))
        world.MixAudio(block)
        T.AreEqual((int)block[1599], -11000)
        T.IsTrue(world.StopSound(replacement))
    }

    MovingParentChangesPanAndFalloff()
    {
        QuaxelWorld world()
        QuaxelSoundClip clip
        clip.Rate = 48000
        clip.Channels = 1
        clip.Samples += (int16)1000
        int sound = world.AddSound(clip)
        vec3 unit = vec3(1.0, 1.0, 1.0)
        QuaxelTransform origin = QuaxelTransform.Make(vec3(0.0, 0.0, 0.0), unit)
        int listener = world.CreateNode()
        world.AttachTransform(listener, origin)
        QuaxelCamera camera
        camera.Direction = vec3(0.0, 0.0, -1.0)
        camera.Up = vec3(0.0, 1.0, 0.0)
        world.AttachCamera(listener, camera)
        world.SetActiveCamera(listener)
        int parent = world.CreateNode()
        int emitter = world.CreateChild(parent)
        world.AttachTransform(emitter, origin)
        world.AttachTransform(parent, QuaxelTransform.Make(vec3(1.0, 0.0, 0.0), unit))
        QuaxelAudioSource source
        source.InnerRadius = 1.0
        source.OuterRadius = 3.0
        T.IsTrue(world.SetAudioSource(emitter, source))
        long voice = world.PlaySound(sound, emitter, 1.0, true)
        int16 [1600] block
        world.MixAudio(block)
        T.AreEqual((int)block[0], 0)
        T.AreEqual((int)block[1], 1000)
        world.SetTransform(parent, QuaxelTransform.Make(vec3(-2.0, 0.0, 0.0), unit))
        world.MixAudio(block)
        T.AreEqual((int)block[0], 500)
        T.AreEqual((int)block[1], 0)
        world.SetTransform(parent, QuaxelTransform.Make(vec3(-3.0, 0.0, 0.0), unit))
        world.MixAudio(block)
        T.AreEqual((int)block[0], 0)
        world.DestroyNode(parent)
        world.MixAudio(block)
        T.IsFalse(world.StopSound(voice))
    }
}
