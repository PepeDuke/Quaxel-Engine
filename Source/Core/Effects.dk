        style.SpeedMax = 0.8
        style.Spread = 20.0
        style.Gravity = 2.5
        style.Drag = 1.6
        style.Wander = 2.5
        style.LifeMin = 0.35
        style.LifeMax = 0.8
        style.SizeStart = 2.4
        style.SizeEnd = 0.4
        style.DensityStart = 0.95
        style.DensityEnd = 0.45
        style.ColorStart = 0xfff3a8
        style.ColorMiddle = 0xff8c1a
        style.ColorEnd = 0x8a1c08
        style.MiddleAt = 0.35
        style.Shade = 0.12
        style.Flicker = true
        style.Contact = QuaxelEffectContact.Slide
        return style
    }

    // Rising smoke until StopEffect. Pairs with Fire at the same origin.
    QuaxelEffectStyle Smoke()
    {
        QuaxelEffectStyle style
        style.Width = 48
        style.Height = 96
        style.Depth = 48
