// Voxel effects: blood, smoke, fire and the like. The CPU only records how an
// effect starts and when it stops. Particles, collisions, stains and drawing
// all run on the GPU, in a fixed 64^3 slot of a persistent page buffer, and the
// voxel renderer traces each slot like any other volume. See Docs/Effects.md.

// What a particle does when it reaches a solid voxel of another volume.
QuaxelEffectContact : int
#@{
    // Ignores other volumes. The cheapest choice.
    Pass,
    // Vanishes.
    Die,
    // Ends and leaves a stain on the surface it hit.
    Stick,
    // Rebounds, losing speed by Bounciness.
    Bounce,
    // Loses the speed into the surface and keeps moving along it.
    Slide
}

// Everything that sets the look of an effect. Distances are world units, times
// are seconds and colors are 0xRRGGBB. Start from a preset and change fields, or
// fill one from scratch with an initializer.
QuaxelEffectStyle
{
    // World size of one effect voxel. Every effect has a 64^3 grid, so this
    // also sets how far it reaches: 64 cells across. Particles that leave end.
    float VoxelSize = 0.05
    // Where the origin sits in the grid's height, from 0 (bottom) to 1 (top).
    // X and Z are always centered.
    float Floor = 0.5
    // At most 1024.
    int MaxParticles = 600

    // Particles released when the effect starts.
    int Burst
    // Particles per second, for EmitSeconds. A negative EmitSeconds emits until
    // StopEffect. A particle is only emitted into a free particle slot.
    float Rate
    float EmitSeconds
    // Particles start this far from the origin at most. Flat keeps them level
    // with it, as a disc.
    float SpawnRadius
    bool SpawnFlat

    // Launch speed, and the cone around the start direction in degrees
    // (0 is straight along it, 180 is every direction).
    float SpeedMin = 1.0
    float SpeedMax = 1.0
    float Spread = 30.0
    // Vertical acceleration. Negative falls, positive rises like hot air.
    float Gravity
    // Fraction of speed lost per second.
    float Drag
    // Random horizontal push, in units per second squared.
    float Wander
    float LifeMin = 1.0
    float LifeMax = 1.0

    // Particle radius in voxels at birth and at death. Below 0.5 is one voxel.
    float SizeStart
    float SizeEnd
    // Fraction of a particle's voxels drawn at birth and at death. Lower values
    // stipple it, which reads as thin smoke.
    float DensityStart = 1.0
    float DensityEnd = 1.0
    // Colors over a particle's life, through Middle at MiddleAt.
    int ColorStart = 0xffffff
    int ColorMiddle = 0xffffff
    int ColorEnd = 0xffffff
    float MiddleAt = 0.5
    // Random brightness change per voxel, from 0 to 1.
    float Shade = 0.1
    // Picks new random voxels every step instead of keeping them, as flames do.
    bool Flicker
    // Trailing voxels per unit of speed, behind fast particles.
    float Streak

    QuaxelEffectContact Contact
    // Share of speed kept off a surface when bouncing.
    float Bounciness = 0.3
    // Stick: stain radius in voxels, before impact speed widens it.
    float StainRadius = 1.5
    // Stains dry from StainColor to StainDryColor, then thin out and end.
    float StainSeconds = 8.0
    int StainColor = 0x7a0909
    int StainDryColor = 0x3e0505
}
#{
    // A light hit: a spray of small drops that spot the ground.
    QuaxelEffectStyle BloodSplash()
    {
        QuaxelEffectStyle style
        style.VoxelSize = 0.04
        style.Floor = 0.35
        style.Burst = 28
        style.SpawnRadius = 0.05
        style.SpeedMin = 1.2
        style.SpeedMax = 3.2
        style.Spread = 45.0
        style.Gravity = -9.8
        style.Drag = 0.4
        style.LifeMin = 1.2
        style.LifeMax = 2.0
        style.ColorStart = 0xb01414
        style.ColorMiddle = 0x8e0c0c
        style.ColorEnd = 0x700808
        style.Shade = 0.15
        style.Streak = 0.5
        style.Contact = QuaxelEffectContact.Stick
        style.StainRadius = 1.1
        style.StainSeconds = 10.0
        return style
    }

    // A heavy hit: thick drops flung wide that leave pools.
    QuaxelEffectStyle BloodSplatter()
    {
        QuaxelEffectStyle style = BloodSplash()
        style.VoxelSize = 0.05
        style.Floor = 0.3
        style.Burst = 60
        style.SpeedMin = 2.0
        style.SpeedMax = 5.0
        style.Spread = 70.0
        style.SizeStart = 0.8
        style.SizeEnd = 0.5
        style.Streak = 0.7
        style.StainRadius = 2.2
        style.StainSeconds = 14.0
        return style
    }

    // A flame that burns until StopEffect. Put the origin on the surface it burns.
    QuaxelEffectStyle Fire()
    {
        QuaxelEffectStyle style
        style.VoxelSize = 0.04
        style.Floor = 0.1
        style.MaxParticles = 160
        style.Rate = 70.0
        style.EmitSeconds = -1.0
        style.SpawnRadius = 0.14
        style.SpawnFlat = true
        style.SpeedMin = 0.3
        style.SpeedMax = 0.8
        style.Spread = 20.0
        style.Gravity = 2.5
        style.Drag = 1.6
        style.Wander = 2.5
        style.LifeMin = 0.35
        style.LifeMax = 0.8
        style.SizeStart = 2.4
        style.SizeEnd = 0.4
        style.DensityStart = 0.95
        style.DensityEnd = 0.45
        style.ColorStart = 0xfff3a8
        style.ColorMiddle = 0xff8c1a
        style.ColorEnd = 0x8a1c08
        style.MiddleAt = 0.35
        style.Shade = 0.12
        style.Flicker = true
        style.Contact = QuaxelEffectContact.Slide
        return style
    }

    // Rising smoke until StopEffect. Pairs with Fire at the same origin.
    QuaxelEffectStyle Smoke()
    {
        QuaxelEffectStyle style
        style.VoxelSize = 0.06
        style.Floor = 0.05
        style.MaxParticles = 120
        style.Rate = 12.0
        style.EmitSeconds = -1.0
        style.SpawnRadius = 0.1
        style.SpawnFlat = true
        style.SpeedMin = 0.4
        style.SpeedMax = 0.8
        style.Spread = 15.0
        style.Gravity = 0.6
        style.Drag = 0.7
        style.Wander = 1.0
        style.LifeMin = 2.2
        style.LifeMax = 3.4
        style.SizeStart = 1.4
        style.SizeEnd = 4.5
        style.DensityStart = 0.8
        style.DensityEnd = 0.08
        style.ColorStart = 0x4a4643
        style.ColorMiddle = 0x6c6864
        style.ColorEnd = 0x8c8986
        style.Shade = 0.06
        style.Contact = QuaxelEffectContact.Slide
        return style
    }

    // A puff kicked up by a landing or a dash.
    QuaxelEffectStyle Dust()
    {
        QuaxelEffectStyle style
        style.VoxelSize = 0.05
        style.Floor = 0.15
        style.Burst = 16
        style.SpawnRadius = 0.2
        style.SpawnFlat = true
        style.SpeedMin = 0.4
        style.SpeedMax = 1.1
        style.Spread = 80.0
        style.Gravity = -0.6
        style.Drag = 2.5
        style.LifeMin = 0.6
        style.LifeMax = 1.1
        style.SizeStart = 1.5
        style.SizeEnd = 2.8
        style.DensityStart = 0.7
        style.DensityEnd = 0.05
        style.ColorStart = 0x9a8466
        style.ColorMiddle = 0x8a785e
        style.ColorEnd = 0x7a6c58
        style.Contact = QuaxelEffectContact.Slide
        return style
    }

    // Bright chips that bounce off whatever they hit.
    QuaxelEffectStyle Sparks()
    {
        QuaxelEffectStyle style
        style.VoxelSize = 0.03
        style.Floor = 0.3
        style.Burst = 24
        style.SpeedMin = 2.0
        style.SpeedMax = 4.5
        style.Spread = 60.0
        style.Gravity = -9.8
        style.Drag = 0.6
        style.LifeMin = 0.4
        style.LifeMax = 0.9
        style.ColorStart = 0xfffbe0
        style.ColorMiddle = 0xffc040
        style.ColorEnd = 0xa03a10
        style.MiddleAt = 0.4
        style.Streak = 0.6
        style.Contact = QuaxelEffectContact.Bounce
        style.Bounciness = 0.45
        return style
    }
}


// The params block of a slot, as the GPU reads it. Every field is four bytes
// and the order must match the P_ indexes in Shaders/EffectCommon.glsl.
QuaxelEffectParams
{
    float OriginX
    float OriginY
    float OriginZ
    float DirectionX
    float DirectionY
    float DirectionZ
    float VoxelSize
    float Floor
    int Burst
    float Rate
    // The first step that emits nothing.
    int StopStep
    float SpawnRadius
    int SpawnFlat
    float SpeedMin
    float SpeedMax
    float Spread
    float Gravity
    float Drag
    float Wander
    float LifeMin
    float LifeMax
    float SizeStart
    float SizeEnd
    float DensityStart
    float DensityEnd
    int ColorStart
    int ColorMiddle
    int ColorEnd
    float MiddleAt
    float Shade
    int Flicker
    float Streak
    int Contact
    float Bounciness
    float StainRadius
    float StainSeconds
    int StainColor
    int StainDryColor
    int Seed
    int MaxParticles
}
#{
    // Bytes in the block.
    #int Size = 160
}

// A volume that effects can hit, with its world bounds for a quick reject.
QuaxelEffectCollider
{
    int Node
    int Volume
    vec3 Min
    vec3 Max
    mat4 Model
    mat4 Inverse
    bool Inverted
    int CellsX
    int CellsY
    int CellsZ
}

// The CPU's record of one slot. Step counts fixed steps since the start, and
// Simulated how many of them the GPU has run.
QuaxelEffect
{
    int Id
    bool Active
    QuaxelEffectStyle Style
    vec3 Origin
    vec3 Direction
    int Ignore
    int Seed
    int Step
    int Simulated
    int StopStep
    int EndStep
    // Waits for the GPU to empty the slot and bake its collisions.
    bool Fresh
    bool ParamsChanged
}

QuaxelWorld
{
    -QuaxelEffect [] Effects
    -int EffectPages
    -QuaxelEffectCollider [] EffectColliders
    // Indexes into EffectColliders near the effect being baked.
    -int [] EffectNear
    -int NextEffectId

    // Starts an effect at a world position. Direction aims the particles: up for
    // fire, the hit direction for blood. Returns an ID for the other effect
    // calls, or 0 if the style is invalid or 64 effects are already playing.
    int StartEffect(QuaxelEffectStyle style, vec3 origin, vec3 direction)
    {
        return StartEffectIgnoring(style, origin, direction, 0)
    }

    // As StartEffect, but the node and its descendants do not catch the
    // particles, so a wounded creature does not stop its own blood.
    int StartEffectIgnoring(QuaxelEffectStyle style, vec3 origin, vec3 direction, int ignoreNode)
    {
        if style.VoxelSize <= 0.0 || style.MaxParticles < 1 { return 0 }
        int slot = -1
        for i : 0; i < Effects.Len; i++ {
            if !Effects[i].Active && slot < 0 { slot = i }
        }
        if slot < 0 {
            // Every slot is busy, so add a page of the same size.
            if EffectPages >= MaxEffectPages { return 0 }
            slot = (int)Effects.Len
            EffectPages++
            for i : 0; i < EffectSlotsPerPage; i++ { Effects++ }
        }
        NextEffectId++
        float step = (float)Quaxel.FixedDeltaSeconds()
        int stop = 0
        if style.Rate > 0.0 && style.EmitSeconds < 0.0 { stop = 1000000000 }
        else if style.Rate > 0.0 && style.EmitSeconds > 0.0 { stop = (int)Math.Ceil(style.EmitSeconds / step) }
        Effects[slot].Id = NextEffectId
        Effects[slot].Active = true
        Effects[slot].Style = style
        Effects[slot].Origin = origin
        Effects[slot].Direction = direction
        Effects[slot].Ignore = ignoreNode
        Effects[slot].Seed = (int)QuaxelEffectMath.Hash((uint)NextEffectId * (uint)2654435761)
        Effects[slot].Step = 0
        Effects[slot].Simulated = 0
        Effects[slot].Fresh = true
        Effects[slot].ParamsChanged = true
        SetEffectStop(slot, stop)
        return NextEffectId
    }

    // Stops emitting. Particles in the air and stains play out, then it ends.
    bool StopEffect(int effect)
    {
        int slot = EffectSlot(effect)
        if slot < 0 { return false }
        if Effects[slot].Step < Effects[slot].StopStep { SetEffectStop(slot, Effects[slot].Step) }
        return true
    }

    // Removes the effect at once, stains included.
    bool EndEffect(int effect)
    {
        int slot = EffectSlot(effect)
        if slot < 0 { return false }
        Effects[slot].Active = false
        return true
    }

    // True until the effect has nothing left to show.
    bool IsEffectPlaying(int effect) { return EffectSlot(effect) >= 0 }

    int PlayingEffectCount()
    {
        int count = 0
        for i : 0; i < Effects.Len; i++ {
            if Effects[i].Active { count++ }
        }
        return count
    }

    // By default every voxel node stops effect particles. Pass false to let them
    // through this node and its descendants, for moving things such as creatures.
    bool SetCatchesEffects(int id, bool catches)
    {
        if !Exists(id) { return false }
        Nodes[id - 1].IgnoresEffects = !catches
        return true
    }

    // True if a visible voxel of a node that catches effects covers the point.
    bool IsSolidAt(vec3 point)
    {
        RefreshEffectColliders()
        GatherEffectColliders(point, point, 0)
        return EffectSolidAt(point)
    }

    // Counts fixed steps and ends effects whose last stain has faded. The
    // engine calls this once per fixed step, after the game's FixedStep.
    AdvanceEffects(float deltaSeconds)
    {
        for i : 0; i < Effects.Len; i++ {
            if !Effects[i].Active { continue }
            Effects[i].Step++
            if Effects[i].Step >= Effects[i].EndStep { Effects[i].Active = false }
        }
    }

    // What the renderer needs, by slot. Slots are the GPU's page slots, in order.
    int EffectPageCount() { return EffectPages }
    int EffectSlotCount() { return (int)Effects.Len }
    bool IsEffectSlotPlaying(int slot) { return slot >= 0 && slot < Effects.Len && Effects[slot].Active }
    bool EffectNeedsReset(int slot) { return Effects[slot].Fresh }
    bool EffectParamsChanged(int slot) { return Effects[slot].ParamsChanged }
    int EffectStep(int slot) { return Effects[slot].Step }
    int EffectSimulated(int slot) { return Effects[slot].Simulated }
    SetEffectSimulated(int slot, int steps) { Effects[slot].Simulated = steps }

    // Called once the GPU has the slot's current params, and its reset and bake.
    MarkEffectUploaded(int slot)
    {
        Effects[slot].Fresh = false
        Effects[slot].ParamsChanged = false
    }

    QuaxelEffectParams EffectParams(int slot)
    {
        QuaxelEffectStyle style = Effects[slot].Style
        QuaxelEffectParams p
        p.OriginX = Effects[slot].Origin.X
        p.OriginY = Effects[slot].Origin.Y
        p.OriginZ = Effects[slot].Origin.Z
        p.DirectionX = Effects[slot].Direction.X
        p.DirectionY = Effects[slot].Direction.Y
        p.DirectionZ = Effects[slot].Direction.Z
        p.VoxelSize = style.VoxelSize
        p.Floor = Math.Clamp(style.Floor, 0.0, 1.0)
        p.Burst = style.Burst
        p.Rate = style.Rate
        p.StopStep = Effects[slot].StopStep
        p.SpawnRadius = style.SpawnRadius
        p.SpawnFlat = style.SpawnFlat ? 1 | 0
        p.SpeedMin = style.SpeedMin
        p.SpeedMax = style.SpeedMax
        p.Spread = style.Spread
        p.Gravity = style.Gravity
        p.Drag = style.Drag
        p.Wander = style.Wander
        p.LifeMin = style.LifeMin
        p.LifeMax = style.LifeMax
        p.SizeStart = style.SizeStart
        p.SizeEnd = style.SizeEnd
        p.DensityStart = style.DensityStart
        p.DensityEnd = style.DensityEnd
        p.ColorStart = style.ColorStart
        p.ColorMiddle = style.ColorMiddle
        p.ColorEnd = style.ColorEnd
        p.MiddleAt = style.MiddleAt
        p.Shade = style.Shade
        p.Flicker = style.Flicker ? 1 | 0
        p.Streak = style.Streak
        p.Contact = style.Contact.Value
        p.Bounciness = style.Bounciness
        p.StainRadius = style.StainRadius
        p.StainSeconds = style.StainSeconds
        p.StainColor = style.StainColor
        p.StainDryColor = style.StainDryColor
        p.Seed = Effects[slot].Seed
        p.MaxParticles = Math.Clamp(style.MaxParticles, 1, 1024)
        return p
    }

    // Maps the unit box of the slot's grid to the world, for tracing.
    mat4 EffectModel(int slot)
    {
        float size = (float)EffectCells * Effects[slot].Style.VoxelSize
        float floor = Math.Clamp(Effects[slot].Style.Floor, 0.0, 1.0)
        vec3 center = Effects[slot].Origin + vec3(0.0, (0.5 - floor) * size, 0.0)
        return QuaxelMat4.Translation(center) * QuaxelMat4.Scaling(vec3(size, size, size))
    }

    // Lists the visible volumes that overlap the slot and catch its particles.
    // Returns how many. Read them with EffectBakeVolume and EffectBakeMatrix.
    int GatherEffectBake(int slot)
    {
        RefreshEffectColliders()
        mat4 model = EffectModel(slot)
        vec3 half = vec3(model[0][0], model[1][1], model[2][2]) * 0.5
        vec3 center = vec3(model[3][0], model[3][1], model[3][2])
        GatherEffectColliders(center - half, center + half, Effects[slot].Ignore)
        return (int)EffectNear.Len
    }

    int EffectBakeVolume(int k) { return EffectColliders[EffectNear[k]].Volume }

    int EffectBakeCells(int k, int axis)
    {
        if axis == 0 { return EffectColliders[EffectNear[k]].CellsX }
        if axis == 1 { return EffectColliders[EffectNear[k]].CellsY }
        return EffectColliders[EffectNear[k]].CellsZ
    }

    // Maps slot cell coordinates to the grid coordinates of the k-th gathered volume.
    mat4 EffectBakeMatrix(int slot, int k)
    {
        int index = EffectNear[k]
        if !EffectColliders[index].Inverted {
            EffectColliders[index].Inverse = EffectColliders[index].Model.Inverse()
            EffectColliders[index].Inverted = true
        }
        float size = Effects[slot].Style.VoxelSize
        float cells = (float)EffectCells
        vec3 low = Effects[slot].Origin - vec3(cells * 0.5, cells * Math.Clamp(Effects[slot].Style.Floor, 0.0, 1.0), cells * 0.5) * size
        mat4 world = QuaxelMat4.Translation(low) * QuaxelMat4.Scaling(vec3(size, size, size))
        vec3 dims = vec3((float)EffectColliders[index].CellsX, (float)EffectColliders[index].CellsY, (float)EffectColliders[index].CellsZ)
        return QuaxelMat4.Scaling(dims) * QuaxelMat4.Translation(vec3(0.5, 0.5, 0.5)) * EffectColliders[index].Inverse * world
    }

    -int EffectSlot(int effect)
    {
        if effect <= 0 { return -1 }
        for i : 0; i < Effects.Len; i++ {
            if Effects[i].Active && Effects[i].Id == effect { return i }
        }
        return -1
    }

    // The last particle can be born just before the stop and lives at most
    // LifeMax, then StainSeconds more as a stain.
    -SetEffectStop(int slot, int stop)
    {
        QuaxelEffectStyle style = Effects[slot].Style
        float step = (float)Quaxel.FixedDeltaSeconds()
        float tail = style.LifeMax
        if style.Contact == QuaxelEffectContact.Stick { tail += style.StainSeconds }
        Effects[slot].StopStep = stop
        Effects[slot].EndStep = Math.Min(stop, 1000000000) + (int)Math.Ceil(tail / step) + 2
        Effects[slot].ParamsChanged = true
    }

    // Lists every visible voxel node that catches effects, with world bounds.
    -RefreshEffectColliders()
    {
        EffectColliders.Clear()
        int mask = QuaxelComponents.Transform | QuaxelComponents.Voxels
        for id : NextWith(0, mask); id != 0; id = NextWith(id, mask) {
            if !CatchesEffects(id, 0) || IsHidden(id) { continue }
            mat4 model = VolumeModel(id)
            if model.Determinant() (0.0)== 0.0 { continue }
            QuaxelEffectCollider collider
            collider.Node = id
            collider.Volume = Nodes[id - 1].Volume
            collider.CellsX = Volumes[collider.Volume].Cells(0)
            collider.CellsY = Volumes[collider.Volume].Cells(1)
            collider.CellsZ = Volumes[collider.Volume].Cells(2)
            vec3 center = vec3(model[3][0], model[3][1], model[3][2])
            vec3 half = vec3(
                Math.Abs(model[0][0]) + Math.Abs(model[1][0]) + Math.Abs(model[2][0]),
                Math.Abs(model[0][1]) + Math.Abs(model[1][1]) + Math.Abs(model[2][1]),
                Math.Abs(model[0][2]) + Math.Abs(model[1][2]) + Math.Abs(model[2][2])) * 0.5
            collider.Min = center - half
            collider.Max = center + half
            collider.Model = model
            EffectColliders += collider
        }
    }

    -bool CatchesEffects(int id, int ignore)
    {
        int current = id
        while current != 0 {
            if current == ignore || Nodes[current - 1].IgnoresEffects { return false }
            current = Nodes[current - 1].Parent
        }
        return true
    }

    -GatherEffectColliders(vec3 low, vec3 high, int ignore)
    {
        EffectNear.Clear()
        for k : 0; k < EffectColliders.Len; k++ {
            if EffectColliders[k].Max.X < low.X || EffectColliders[k].Min.X > high.X { continue }
            if EffectColliders[k].Max.Y < low.Y || EffectColliders[k].Min.Y > high.Y { continue }
            if EffectColliders[k].Max.Z < low.Z || EffectColliders[k].Min.Z > high.Z { continue }
            if ignore != 0 && !CatchesEffects(EffectColliders[k].Node, ignore) { continue }
            EffectNear += k
        }
    }

    -bool EffectSolidAt(vec3 point)
    {
        for k : EffectNear {
            if point.X < EffectColliders[k].Min.X || point.X > EffectColliders[k].Max.X { continue }
            if point.Y < EffectColliders[k].Min.Y || point.Y > EffectColliders[k].Max.Y { continue }
            if point.Z < EffectColliders[k].Min.Z || point.Z > EffectColliders[k].Max.Z { continue }
            if !EffectColliders[k].Inverted {
                EffectColliders[k].Inverse = EffectColliders[k].Model.Inverse()
                EffectColliders[k].Inverted = true
            }
            vec4 box = EffectColliders[k].Inverse * vec4(point, 1.0)
            float fx = (box.X + 0.5) * (float)EffectColliders[k].CellsX
            float fy = (box.Y + 0.5) * (float)EffectColliders[k].CellsY
            float fz = (box.Z + 0.5) * (float)EffectColliders[k].CellsZ
            if fx < 0.0 || fy < 0.0 || fz < 0.0 { continue }
            if fx >= (float)EffectColliders[k].CellsX || fy >= (float)EffectColliders[k].CellsY || fz >= (float)EffectColliders[k].CellsZ { continue }
            if Volumes[EffectColliders[k].Volume].GetVoxel((int)fx, (int)fy, (int)fz) >= 0 { return true }
        }
        return false
    }
}
#{
    // Cells along each side of a slot, slots per page and the most pages.
    #int EffectCells = 64
    #int EffectSlotsPerPage = 8
    #int MaxEffectPages = 8
}

QuaxelEffectMath
#{
    uint Hash(uint value)
    {
        uint x = value
        x = x ^ (x >> 16)
        x = x * (uint)0x7feb352d
        x = x ^ (x >> 15)
        x = x * (uint)0x846ca68b
        x = x ^ (x >> 16)
        return x
    }
}

// Scenes shared by the effect tests.
QuaxelEffectFixtures
#{
    // A slab whose top face is at y = 0, `cells` wide in X and Z.
    int MakeGround(QuaxelWorld& world, int cells)
    {
        int volume = world.CreateVolume(cells, 4, cells)
        for x : 0; x < cells; x++ {
            for z : 0; z < cells; z++ {
                for y : 0; y < 4; y++ { world.SetVoxel(volume, x, y, z, 0x406020) }
            }
        }
        int node = world.CreateNode()
        world.AttachTransform(node, QuaxelTransform.Make(vec3(0.0, -0.25, 0.0), vec3(0.125, 0.125, 0.125)))
        world.AttachVoxels(node, volume)
        return node
    }

    extern "C" void* memcpy(void* target, void* source, long byteCount)

    Run(QuaxelWorld& world, int steps)
    {
        for i : 0; i < steps; i++ { world.AdvanceEffects(1.0 / 60.0) }
    }
}
T{
    SolidQueriesSeeVoxelsAndSkipIgnoredNodes()
    {
        QuaxelWorld world()
        int ground = QuaxelEffectFixtures.MakeGround(world, 16)
        T.IsTrue(world.IsSolidAt(vec3(0.3, -0.1, 0.2)))
        T.IsFalse(world.IsSolidAt(vec3(0.3, 0.05, 0.2)))
        T.IsFalse(world.IsSolidAt(vec3(1.1, -0.1, 0.0)))
        world.SetCatchesEffects(ground, false)
        T.IsFalse(world.IsSolidAt(vec3(0.3, -0.1, 0.2)))
    }

    BurstsEndAfterTheirLongestLifeAndStains()
    {
        QuaxelWorld world()
        QuaxelEffectStyle style = QuaxelEffectStyle.BloodSplash()
        int effect = world.StartEffect(style, vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
        T.IsTrue(effect > 0)
        int seconds = (int)Math.Ceil(style.LifeMax + style.StainSeconds)
        QuaxelEffectFixtures.Run(world, seconds * 60 - 10)
        T.IsTrue(world.IsEffectPlaying(effect))
        QuaxelEffectFixtures.Run(world, 80)
        T.IsFalse(world.IsEffectPlaying(effect))
    }

    EmittersPlayUntilStoppedThenFade()
    {
        QuaxelWorld world()
        int fire = world.StartEffect(QuaxelEffectStyle.Fire(), vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
        QuaxelEffectFixtures.Run(world, 6000)
        T.IsTrue(world.IsEffectPlaying(fire))
        T.IsTrue(world.StopEffect(fire))
        QuaxelEffectFixtures.Run(world, 30)
        T.IsTrue(world.IsEffectPlaying(fire))
        QuaxelEffectFixtures.Run(world, 30)
        T.IsFalse(world.IsEffectPlaying(fire))
        T.IsFalse(world.StopEffect(fire))
    }

    PagesGrowWhenEverySlotIsBusy()
    {
        QuaxelWorld world()
        T.AreEqual(world.EffectPageCount(), 0)
        int [] ids
        for i : 0; i < 8; i++ { ids += world.StartEffect(QuaxelEffectStyle.Fire(), vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0)) }
        T.AreEqual(world.EffectPageCount(), 1)
        T.AreEqual(world.EffectSlotCount(), 8)
        ids += world.StartEffect(QuaxelEffectStyle.Fire(), vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
        T.AreEqual(world.EffectPageCount(), 2)
        T.AreEqual(world.EffectSlotCount(), 16)
        // A freed slot is reused before any new page.
        T.IsTrue(world.EndEffect(ids[3]))
        int again = world.StartEffect(QuaxelEffectStyle.Dust(), vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
        T.AreEqual(world.EffectPageCount(), 2)
        T.IsTrue(world.IsEffectSlotPlaying(3))
        T.IsTrue(again > ids[8])
        T.IsFalse(world.IsEffectPlaying(ids[3]))
    }

    SixtyFourEffectsAtMost()
    {
        QuaxelWorld world()
        for i : 0; i < 64; i++ { T.IsTrue(world.StartEffect(QuaxelEffectStyle.Fire(), vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0)) > 0) }
        T.AreEqual(world.StartEffect(QuaxelEffectStyle.Fire(), vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0)), 0)
        T.AreEqual(world.EffectPageCount(), 8)
    }

    BakeFindsTheGroundUnderAnEffect()
    {
        QuaxelWorld world()
        int ground = QuaxelEffectFixtures.MakeGround(world, 64)
        world.StartEffect(QuaxelEffectStyle.BloodSplash(), vec3(0.0, 0.4, 0.0), vec3(0.0, 1.0, 0.0))
        T.AreEqual(world.GatherEffectBake(0), 1)
        T.AreEqual(world.EffectBakeCells(0, 0), 64)
        // The slot cell at the origin's column, just under y = 0, is ground cell (32, 3, 32).
        QuaxelEffectStyle style = QuaxelEffectStyle.BloodSplash()
        float underY = 64.0 * style.Floor - 0.4 / style.VoxelSize - 0.5
        vec4 cell = world.EffectBakeMatrix(0, 0) * vec4(vec3(32.0, underY, 32.0), 1.0)
        T.IsTrue(Math.Abs(cell.X - 32.0) < 0.01)
        T.IsTrue(cell.Y > 3.0 && cell.Y < 4.0)
        int ignored = world.StartEffectIgnoring(QuaxelEffectStyle.BloodSplash(), vec3(0.0, 0.4, 0.0), vec3(0.0, 1.0, 0.0), ground)
        T.IsTrue(ignored > 0)
        T.AreEqual(world.GatherEffectBake(1), 0)
    }

    ParamsMatchTheShaderLayout()
    {
        QuaxelWorld world()
        QuaxelEffectStyle style = QuaxelEffectStyle.Smoke()
        world.StartEffect(style, vec3(1.0, 2.0, 3.0), vec3(0.0, 1.0, 0.0))
        QuaxelEffectParams params = world.EffectParams(0)
        // The block is 40 four-byte words; the shader reads MaxParticles at 39.
        int [40] words
        QuaxelEffectFixtures.memcpy(&words[0], &params, (long)QuaxelEffectParams.Size)
        T.AreEqual(words[39], style.MaxParticles)
        T.AreEqual(words[38], params.Seed)
        T.AreEqual(words[32], QuaxelEffectContact.Slide + 0)
        T.AreEqual(words[10], 1000000000)
    }
}

