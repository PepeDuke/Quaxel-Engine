// Voxel effects: blood, smoke, fire and the like. Each effect simulates its
// particles in world space and redraws them every fixed step into a volume of
// its own, so effects stay voxels and use the ordinary voxel renderer. Particles
// collide with the voxels of other volumes, which is how blood stains the ground.

// What a particle does when it reaches a solid voxel of another volume.
QuaxelEffectContact : int
#@{
    // Ignores other volumes. The cheapest choice.
    Pass,
    // Vanishes.
    Die,
    // Ends and leaves a stain on the surface it hit.
    Stick,
    // Rebounds, losing speed by Bounciness.
    Bounce,
    // Loses the speed into the surface and keeps moving along it.
    Slide
}

// Everything that sets the look of an effect. Distances are world units, times
// are seconds and colors are 0xRRGGBB. Start from a preset and change fields, or
// fill one from scratch with an initializer.
QuaxelEffectStyle
{
    // The effect's own grid, in cells. Particles that leave it end.
    int Width = 48
    int Height = 48
    int Depth = 48
    // World size of one effect voxel.
    float VoxelSize = 0.05
    // Where the origin sits in the grid's height, from 0 (bottom) to 1 (top).
    // X and Z are always centered.
    float Floor = 0.5
    int MaxParticles = 600
    int MaxStainCells = 4000

    // Particles released when the effect starts.
    int Burst
    // Particles per second, for EmitSeconds. A negative EmitSeconds emits until
    // StopEffect.
    float Rate
    float EmitSeconds
    // Particles start this far from the origin at most. Flat keeps them level
    // with it, as a disc.
    float SpawnRadius
    bool SpawnFlat

    // Launch speed, and the cone around the start direction in degrees
    // (0 is straight along it, 180 is every direction).
    float SpeedMin = 1.0
    float SpeedMax = 1.0
    float Spread = 30.0
    // Vertical acceleration. Negative falls, positive rises like hot air.
    float Gravity
    // Fraction of speed lost per second.
    float Drag
    // Random horizontal push, in units per second squared.
    float Wander
    float LifeMin = 1.0
    float LifeMax = 1.0

    // Particle radius in voxels at birth and at death. Below 0.5 is one voxel.
    float SizeStart
    float SizeEnd
    // Fraction of a particle's voxels drawn at birth and at death. Lower values
    // stipple it, which reads as thin smoke.
    float DensityStart = 1.0
    float DensityEnd = 1.0
    // Colors over a particle's life, through Middle at MiddleAt.
    int ColorStart = 0xffffff
    int ColorMiddle = 0xffffff
    int ColorEnd = 0xffffff
    float MiddleAt = 0.5
    // Random brightness change per voxel, from 0 to 1.
    float Shade = 0.1
    // Picks new random voxels every step instead of keeping them, as flames do.
    bool Flicker
    // Trailing voxels per unit of speed, behind fast particles.
    float Streak

    QuaxelEffectContact Contact
    // Share of speed kept off a surface when bouncing.
    float Bounciness = 0.3
    // Stick: stain radius in voxels, before impact speed widens it.
    float StainRadius = 1.5
    // Stains dry from StainColor to StainDryColor, then thin out and end.
    float StainSeconds = 8.0
    int StainColor = 0x7a0909
    int StainDryColor = 0x3e0505
}
#{
    // A light hit: a spray of small drops that spot the ground.
    QuaxelEffectStyle BloodSplash()
    {
        QuaxelEffectStyle style
        style.Width = 64
        style.Height = 40
        style.Depth = 64
        style.VoxelSize = 0.04
        style.Floor = 0.35
        style.Burst = 28
        style.SpawnRadius = 0.05
        style.SpeedMin = 1.2
        style.SpeedMax = 3.2
        style.Spread = 45.0
        style.Gravity = -9.8
        style.Drag = 0.4
        style.LifeMin = 1.2
        style.LifeMax = 2.0
        style.ColorStart = 0xb01414
        style.ColorMiddle = 0x8e0c0c
        style.ColorEnd = 0x700808
        style.Shade = 0.15
        style.Streak = 0.5
        style.Contact = QuaxelEffectContact.Stick
        style.StainRadius = 1.1
        style.StainSeconds = 10.0
