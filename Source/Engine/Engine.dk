// Owns the main loop: startup, message pumping, fixed updates, rendering, teardown.
QuaxelEngine
#{
    // Live resize runs inside the window system's modal loop, so the redraw
    // handler finds the world here. Set only while the world is being rendered.
    -void* RenderedWorld
    -void* RenderedUi
    -bool RedrawFailed

    // Frames slower than this many steps drop the excess instead of catching up.
    -int MaxStepsPerFrame() { return 5 }

    // Runs the game to completion. Returns false if startup or rendering failed.
    bool Run(QuaxelGameInstance& game)
    {
        QuaxelWorld world()
        QuaxelUi ui()
        bool success = game.Prepare(world)
        if !success { Print("Failed to prepare the initial world") }
        if success {
            ui.Content = game.BuildUi()
            game.ConfigureUi(ui)
            if QuaxelPlatform.SupportsWindowing() {
                success = RunWindowed(game, world, ui)
            } else {
                RunHeadless(game, world, ui)
            }
        }
        world.Release()
        game.Stopped()
        return success
    }

    -Step(QuaxelGameInstance& game, QuaxelWorld& world, QuaxelInputState& input)
    {
        world.BeginStep()
        // First, so a clip the game starts holds its first frame for its full time.
        world.AdvanceAnimations((float)Quaxel.FixedDeltaSeconds())
        game.FixedStep(world, input, (float)Quaxel.FixedDeltaSeconds())
        world.UpdateSockets()
        world.EndStep()
    }

    -RunHeadless(QuaxelGameInstance& game, QuaxelWorld& world, QuaxelUi& ui)
    {
        QuaxelInputState input
        QuaxelSession session()
        session.Begin()
        int total = game.HeadlessSteps()
        while session.Running && session.Frame < total {
            SampleInput(input)
            Step(game, world, input)
            game.UpdateUi(ui, world)
            session.Advance()
        }
        session.Stop()
    }

    -bool RunWindowed(QuaxelGameInstance& game, QuaxelWorld& world, QuaxelUi& ui)
    {
        if !QuaxelPlatform.OpenWindow(game.WindowTitle(), game.WindowWidth(), game.WindowHeight(), true) {
            Print("Failed to open the window")
            return false
        }
        bool success = QuaxelRenderer.Start()
        if !success { Print("Failed to start the renderer") }
        if success { success = RunLoop(game, world, ui) }
        QuaxelRenderer.Stop()
        QuaxelPlatform.CloseWindow()
        return success
    }


    -SampleInput(QuaxelInputState& input)
    {
        for key : 0; key < input.Down.Len; key++ {
            input.Down[key] = QuaxelPlatform.IsKeyDown(key)
        }
    }

    -bool RunLoop(QuaxelGameInstance& game, QuaxelWorld& world, QuaxelUi& ui)
    {
        long frequency = 0
        long now = 0
        if !QuaxelPlatform.GetClockFrequency(frequency) || !QuaxelPlatform.ReadClock(now) {
            Print("The platform clock is unavailable")
            return false
        }
        QuaxelFixedStepper stepper
        stepper.Configure(frequency, Quaxel.FixedDeltaSeconds())
        stepper.Reset(now)
        RenderedWorld = &world
        RenderedUi = &ui
        RedrawFailed = false
        QuaxelPlatform.SetRedrawHandler(RedrawDuringResize)
        QuaxelPlatform.ConsumeWindowStall()

        bool success = true
        bool minimized = false
        QuaxelInputState input
        while QuaxelPlatform.PumpWindow(minimized) {
            int width = 0
            int height = 0
            if !QuaxelPlatform.GetWindowSize(width, height) { break }
            if width == 0 || height == 0 {
                minimized = true
                continue
            }
            if !QuaxelPlatform.ReadClock(now) {
                success = false
                break
            }
            if QuaxelPlatform.ConsumeWindowStall() || minimized { stepper.Reset(now) }
            minimized = false

            SampleInput(input)
            int steps = stepper.Advance(now, MaxStepsPerFrame())
            for i : 0; i < steps; i++ { Step(game, world, input) }

            game.UpdateUi(ui, world)
            int mouseX = 0
            int mouseY = 0
            QuaxelPlatform.GetMousePosition(mouseX, mouseY)
            ui.Layout(width, height, mouseX, mouseY, QuaxelPlatform.IsMouseButtonDown())

            if RedrawFailed || !Render(world, ui, width, height) {
                Print("Rendering failed")
                success = false
                break
            }
        }
        QuaxelPlatform.ClearRedrawHandler()
        RenderedWorld = null
        RenderedUi = null
        return success
    }

    -RedrawDuringResize()
    {
        if RenderedWorld == null || RenderedUi == null || RedrawFailed { return }
        int width = 0
        int height = 0
        if !QuaxelPlatform.GetWindowSize(width, height) || width == 0 || height == 0 { return }
        QuaxelWorld* world = (QuaxelWorld*)RenderedWorld
        QuaxelUi* ui = (QuaxelUi*)RenderedUi
        ui.Relayout(width, height)
        if !Render(*world, *ui, width, height) { RedrawFailed = true }
    }

    -bool Render(QuaxelWorld& world, QuaxelUi& ui, int width, int height)
    {
        mat4 viewProjection = mat4.Identity()
        int cameraNode = world.ActiveCamera
        if cameraNode != 0 && world.Has(cameraNode, QuaxelComponents.Transform) {
            QuaxelCamera camera = world.GetCamera(cameraNode)
            camera.UpdateBounds(width, height)
            world.SetCamera(cameraNode, camera)
            viewProjection = camera.ViewProjection(world.WorldPosition(cameraNode))
        }
        int mask = QuaxelComponents.Transform | QuaxelComponents.Voxels
        for id : world.NextWith(0, mask); id != 0; id = world.NextWith(id, mask) {
            int volume = world.VolumeOf(id)
            if world.NeedsVolumeUpload(volume) {
                void* mapped = null
                int handle = QuaxelRenderer.MapVolume(world.VolumeHandle(volume), world.VolumeWords(volume), mapped)
                if handle < 0 { return false }
                world.CopyVolume(volume, mapped)
                QuaxelRenderer.UnmapVolume(handle)
                world.SetVolumeHandle(volume, handle)
            }
        }
        if ui.AtlasDirty {
            void* mappedAtlas = null
            if !QuaxelRenderer.MapUiAtlas(ui.AtlasWords, mappedAtlas) { return false }
            ui.CopyAtlas(mappedAtlas)
            QuaxelRenderer.UnmapUiAtlas()
            ui.MarkAtlasUploaded()
        }
        if !QuaxelRenderer.BeginVoxelFrame() { return false }
        for id : world.NextWith(0, mask); id != 0; id = world.NextWith(id, mask) {
            if world.IsHidden(id) { continue }
            mat4 model = world.VolumeModel(id)
            mat4 clip = viewProjection * model
            float rx = (Math.Abs(clip[0][0]) + Math.Abs(clip[1][0]) + Math.Abs(clip[2][0])) * 0.5
            float ry = (Math.Abs(clip[0][1]) + Math.Abs(clip[1][1]) + Math.Abs(clip[2][1])) * 0.5
            float left = Math.Clamp((clip[3][0] - rx + 1.0) * 0.5, 0.0, 1.0)
            float right = Math.Clamp((clip[3][0] + rx + 1.0) * 0.5, 0.0, 1.0)
            float top = Math.Clamp((clip[3][1] - ry + 1.0) * 0.5, 0.0, 1.0)
            float bottom = Math.Clamp((clip[3][1] + ry + 1.0) * 0.5, 0.0, 1.0)
            if left >= right || top >= bottom { continue }
            if clip.Determinant() == 0.0 { continue }
            mat4 boxFromClip = clip.Inverse()
            vec3 lights = world.FaceLights(id)
            if !QuaxelRenderer.TraceVolume(world.VolumeHandle(world.VolumeOf(id)), &boxFromClip, left, top, right, bottom, lights.X, lights.Y, lights.Z) { return false }
        }
        for i : 0; i < ui.CommandCount; i++ {
            QuaxelUiCommand command = ui.GetCommand(i)
            if !QuaxelRenderer.DrawUi(command.X, command.Y, command.Width, command.Height, command.Color, command.GlyphFirst, command.GlyphLast, command.Cell) { return false }
        }
        return QuaxelRenderer.EndFrame()
    }
}
