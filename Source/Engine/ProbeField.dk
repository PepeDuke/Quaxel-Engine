// Two rolling 8x4x8 windows of world-space octree roots, at 16 and 64 voxels per side.
// Refresh resident geometry before shading. Stream newly exposed roots separately.
QuaxelGiRoot
{
    ivec3 Key
    uint Signature
    uint StaticSignature
    bool StaticReady
    int Count
    int Waiting
    bool Ready
}
QuaxelGiInstance
{
    ivec3 Low
    ivec3 High
    bool Moving
    int Node
    bool Mesh
}
QuaxelGiMotion
{
    uint Stamp
    bool Seen
    bool Moving
}
QuaxelEngine
#{
    -QuaxelGiRoot [512] GiRoots
    -QuaxelGiInstance [] GiInstances
    -QuaxelGiMotion [] GiMotion
    -uint8 [2097152] GiStaticOccupancy
    -uint8 [2097152] GiLastOccupancy
    -uint [512] StaticSignatures
    -uint [512] Signatures
    -int [2052] GiWindow
    -int ProbeEpoch
    -extern "C" void* memcpy(void* dst, void* src, long bytes)

    -extern "C" int memcmp(void* a, void* b, long bytes)

    -int GiSlot(ivec3 r) { return (r.X & 7) + 8*(r.Z & 7) + 64*(r.Y & 3) }

    -AccumulateGiBounds(ivec3 first,int level,float width, vec3 center, vec3 half, uint stamp, int id, bool mesh)
    {
        ivec3 lo
        ivec3 hi
        for k : 0; k < 3; k++ {
            lo[k] = Math.Max(first[k],(int)Math.Floor((center[k]-half[k])/width))
            hi[k] = Math.Min(first[k]+(k == 1 ? 3 | 7),(int)Math.Floor((center[k]+half[k])/width))
        }
        if lo.X > hi.X || lo.Y > hi.Y || lo.Z > hi.Z { return }
        QuaxelGiInstance instance
        int key = id*2 + (mesh ? 1 | 0)
        while GiMotion.Len <= key {
            QuaxelGiMotion motion
            GiMotion += motion
        }
        if GiMotion[key].Seen && GiMotion[key].Stamp != stamp { GiMotion[key].Moving = true }
        GiMotion[key].Seen = true
        GiMotion[key].Stamp = stamp
        instance.Moving = GiMotion[key].Moving
        instance.Node = id
        instance.Low = lo
        instance.High = hi
        instance.Mesh = mesh
        GiInstances += instance
        for y : lo.Y; y <= hi.Y; y++ | z : lo.Z; z <= hi.Z; z++ | x : lo.X; x <= hi.X; x++ {
            int s = level*256 + GiSlot(ivec3(x,y,z))
            if !instance.Moving { StaticSignatures[s] = (StaticSignatures[s] ^ stamp) * (uint)16777619 }
            Signatures[s] = (Signatures[s] ^ stamp) * (uint)16777619
        }
    }

    -uint HashProbeModel(mat4 model, int id, int asset, int revision)
    {
        uint [16] bits
        memcpy(&bits[0],&model,64)
        uint h = ((uint)id * (uint)16777619 ^ (uint)asset) * (uint)16777619 ^ (uint)revision
        for k : 0; k < 16; k++ { h = (h ^ bits[k]) * (uint)16777619 }
        return h
    }

    -PrepareProbes(QuaxelWorld& world, mat4 vp)
    {
        int epoch = QuaxelRenderer.BeginProbeField(world.UniformProbeUpdates)
        if epoch == 0 { return }
        mat4 inverse = vp.Inverse()
        vec3 focus = vec3(inverse[3])
        if Math.Abs(inverse[2][1]) > 0.0001 { focus += vec3(inverse[2]) * Math.Clamp(-focus.Y/inverse[2][1],0.0,1.0) }
        int parent = world.ActiveCamera != 0 ? world.ParentOf(world.ActiveCamera) | 0
        if parent != 0 { focus = world.WorldPosition(parent) }
        if ProbeEpoch != epoch { GiMotion.Clear() }
        BuildProbeLevel(world,focus,epoch,0,2.0)
        BuildProbeLevel(world,focus,epoch,1,8.0)
        ProbeEpoch = epoch
        for s : 0; s < 512; s++ {
            GiWindow[s*4] = GiRoots[s].Key.X
            GiWindow[s*4+1] = GiRoots[s].Key.Y
            GiWindow[s*4+2] = GiRoots[s].Key.Z
            GiWindow[s*4+3] = GiRoots[s].Count
        }
        float [4] center = {focus.X,focus.Y,focus.Z,0.0}
        memcpy(&GiWindow[2048],&center[0],16)
        QuaxelRenderer.WriteProbeWindow(&GiWindow[0])
    }

    -BuildProbeLevel(QuaxelWorld& world,vec3 focus,int epoch,int level,float width)
    {
        int base = level*256
        ivec3 first = ivec3((int)Math.Floor(focus.X/width)-4,(int)Math.Floor(focus.Y/width)-1,(int)Math.Floor(focus.Z/width)-4)
        for s : base; s < base+256; s++ {
            Signatures[s] = (uint)2166136261
            StaticSignatures[s] = (uint)2166136261
        }
        GiInstances.Clear()
        for item : TraceOrder {
            if item.Handle < 0 { continue }
            int volume = world.VolumeOf(item.Node)
            AccumulateGiBounds(first,level,width,item.BoundsCenter,item.BoundsHalf,HashProbeModel(item.BoxFromWorld,item.Node,volume,world.VolumeUploadRevision(volume)),item.Node,false)
        }
        int mask = QuaxelComponents.Transform | QuaxelComponents.MeshRenderer
        for id : world.NextWith(0,mask); id != 0; id = world.NextWith(id,mask) {
            if world.IsHidden(id) { continue }
            int index = world.MeshOf(id)
            QuaxelMeshData mesh = world.GetMesh(index)
            if mesh.VoxelPrimitive != 0 || mesh.VertexCount == 0 { continue }
            mat4 model = world.ModelMatrix(id)
            vec3 lo
            vec3 hi
            for v : 0; v < mesh.VertexCount; v++ {
                QuaxelVertex vertex = mesh.Vertices[v]
                vec3 p = vec3(model*vec4(vertex.X,vertex.Y,vertex.Z,1.0))
                for k : 0; k < 3; k++ {
                    if v == 0 || p[k] < lo[k] { lo[k] = p[k] }
                    if v == 0 || p[k] > hi[k] { hi[k] = p[k] }
                }
            }
            AccumulateGiBounds(first,level,width,(hi+lo)*0.5,(hi-lo)*0.5,HashProbeModel(model,id,index,0),id,true)
        }
        for y : 0; y < 4; y++ | z : 0; z < 8; z++ | x : 0; x < 8; x++ {
            ivec3 r = ivec3(first.X+x,first.Y+y,first.Z+z)
            int s = base + GiSlot(r)
            ivec3 old = GiRoots[s].Key
            bool resident = ProbeEpoch == epoch && old.X == r.X && old.Y == r.Y && old.Z == r.Z
            if !resident || GiRoots[s].Signature != Signatures[s] {
                bool refresh = resident && GiRoots[s].Ready
                GiRoots[s].Key = r
                GiRoots[s].Signature = Signatures[s]
                GiRoots[s].Ready = false
                if !resident {
                    GiRoots[s].Count = 0
                    GiRoots[s].StaticReady = false
                }
                if refresh { BuildProbeRoot(world,s,true) }
            }
            if !GiRoots[s].Ready { GiRoots[s].Waiting++ }
        }
        for job : 0; job < 2; job++ {
            int best = -1
            float priority = -1.0
            for s : base; s < base+256; s++ {
                if GiRoots[s].Ready { continue }
                ivec3 r = GiRoots[s].Key
                vec3 delta = (vec3((float)r.X,(float)r.Y,(float)r.Z)+vec3(0.5,0.5,0.5))*width-focus
                float score = (float)GiRoots[s].Waiting / (1.0+delta.Dot(delta))
                if score > priority {
                    priority = score
                    best = s
                }
            }
            if best < 0 { break }
            BuildProbeRoot(world,best,false)
            // Spread new geometry-bearing roots across frames as the window scrolls.
            if Signatures[best] != (uint)2166136261 { break }
        }

    }

    -BuildProbeRoot(QuaxelWorld& world,int slot,bool refresh)
    {
        QuaxelProbeTree Placement()
        int level = slot / 256
        int scale = level == 0 ? 1 | 4
        Placement.BeginLevel(GiRoots[slot].Key,scale)
        ivec3 r = GiRoots[slot].Key
        // Cache the union of stationary geometry; overlay actors at their current poses.
        int offset = slot*4096
        if !GiRoots[slot].StaticReady || GiRoots[slot].StaticSignature != StaticSignatures[slot] {
            RasterGiInstances(world,Placement,r,false)
            memcpy(&GiStaticOccupancy[offset],&Placement.Occupancy[0],4096)
            GiRoots[slot].StaticSignature = StaticSignatures[slot]
            GiRoots[slot].StaticReady = true
        } else { memcpy(&Placement.Occupancy[0],&GiStaticOccupancy[offset],4096) }
        RasterGiInstances(world,Placement,r,true)
        if refresh && memcmp(&Placement.Occupancy[0],&GiLastOccupancy[offset],4096) == 0 {
            GiRoots[slot].Ready = true
            return
        }
        memcpy(&GiLastOccupancy[offset],&Placement.Occupancy[0],4096)
        Placement.FinishTree(0.125*(float)scale,true)
        int [512] cells
        float [2048] positions
        for node : Placement.Cells {
            if node.Probe < 0 { continue }
            int id = node.Probe
            vec3 p = Placement.Probes[id]
            positions[id*4] = p.X
            positions[id*4+1] = p.Y
            positions[id*4+2] = p.Z
            positions[id*4+3] = (float)node.Side * 0.125*(float)scale
            ivec3 low = node.Origin
            for z : low.Z; z < low.Z+node.Side; z+=2 | y : low.Y; y < low.Y+node.Side; y+=2 | x : low.X; x < low.X+node.Side; x+=2 {
                cells[x/2 + 8*(y/2) + 64*(z/2)] = id+1
            }
        }
        int count = (int)Placement.Probes.Len
        QuaxelRenderer.WriteProbeRoot(slot,count,&cells[0],&positions[0])
        GiRoots[slot].Count = count
        GiRoots[slot].Waiting = 0
        GiRoots[slot].Ready = true
    }

    -RasterGiInstances(QuaxelWorld& world, QuaxelProbeTree& Placement, ivec3 r, bool moving)
    {
        for instance : GiInstances {
            if instance.Moving != moving { continue }
            if r.X < instance.Low.X || r.Y < instance.Low.Y || r.Z < instance.Low.Z || r.X > instance.High.X || r.Y > instance.High.Y || r.Z > instance.High.Z { continue }
            if instance.Mesh {
                QuaxelMeshData mesh = world.GetMesh(world.MeshOf(instance.Node))
                Placement.AddMesh(mesh,world.ModelMatrix(instance.Node))
            } else { Placement.AddVolume(world,instance.Node) }
        }
    }
}
