// Two rolling 8x4x8 windows of world-space octree roots, at 16 and 64 voxels per side.
// Static placement and motion-driven lighting updates have separate budgets.
QuaxelGiRoot
{
    ivec3 Key
    uint Signature
    uint MotionSignature
    int WakeFrames
    int Count
    int Waiting
    bool Ready
}
QuaxelGiInstance
{
    ivec3 Low
    ivec3 High
    int Node
    bool Mesh
}
QuaxelGiMotion
{
    uint Stamp
    bool Seen
    int LastMoved
}
QuaxelEngine
#{
    -QuaxelGiRoot [512] GiRoots
    -QuaxelGiInstance [] GiInstances
    -QuaxelGiMotion [] GiMotion
    -int GiTick
    -uint [512] MotionSignatures
    -uint [512] Signatures
    -int [2052] GiWindow
    -int ProbeEpoch
    -extern "C" void* memcpy(void* dst, void* src, long bytes)

    -int GiSlot(ivec3 r) { return (r.X & 7) + 8*(r.Z & 7) + 64*(r.Y & 3) }

    -bool ActorGeometry(QuaxelWorld& world,int node,int player)
    {
        while node != 0 {
            if node == player || world.Has(node,QuaxelComponents.Animator) { return true }
            node = world.ParentOf(node)
        }
        return false
    }

    -AccumulateGiBounds(ivec3 first,int level,float width,vec3 center,vec3 half,uint pose,uint stamp,int id,bool mesh,bool actor)
    {
        int key = id*2 + (mesh ? 1 | 0)
        while GiMotion.Len <= key {
            QuaxelGiMotion motion
            GiMotion += motion
        }
        if GiMotion[key].Seen && GiMotion[key].Stamp != pose { GiMotion[key].LastMoved = GiTick }
        GiMotion[key].Seen = true
        GiMotion[key].Stamp = pose
        bool dynamic = actor || (GiMotion[key].LastMoved > 0 && GiTick-GiMotion[key].LastMoved < 60)
        // One receiver cell of padding wakes probes on both sides of a moving surface.
        if dynamic { half += vec3(0.25,0.25,0.25)*width }
        ivec3 lo
        ivec3 hi
        for k : 0; k < 3; k++ {
            lo[k] = Math.Max(first[k],(int)Math.Floor((center[k]-half[k])/width))
            hi[k] = Math.Min(first[k]+(k == 1 ? 3 | 7),(int)Math.Floor((center[k]+half[k])/width))
        }
        if lo.X > hi.X || lo.Y > hi.Y || lo.Z > hi.Z { return }
        QuaxelGiInstance instance
        instance.Node = id
        instance.Low = lo
        instance.High = hi
        instance.Mesh = mesh
        if !dynamic { GiInstances += instance }
        for y : lo.Y; y <= hi.Y; y++ | z : lo.Z; z <= hi.Z; z++ | x : lo.X; x <= hi.X; x++ {
            int s = level*256 + GiSlot(ivec3(x,y,z))
            if dynamic { MotionSignatures[s] = (MotionSignatures[s] ^ stamp) * (uint)16777619 }
            else { Signatures[s] = (Signatures[s] ^ stamp) * (uint)16777619 }
        }
    }

    -uint HashProbeModel(mat4 model, int id)
    {
        uint [16] bits
        memcpy(&bits[0],&model,64)
        uint h = (uint)id * (uint)16777619
        for k : 0; k < 16; k++ { h = (h ^ bits[k]) * (uint)16777619 }
        return h
    }

    -PrepareProbes(QuaxelWorld& world, mat4 vp)
    {
        int epoch = QuaxelRenderer.BeginProbeField(world.UniformProbeUpdates)
        if epoch == 0 { return }
        mat4 inverse = vp.Inverse()
        vec3 focus = vec3(inverse[3])
        if Math.Abs(inverse[2][1]) > 0.0001 { focus += vec3(inverse[2]) * Math.Clamp(-focus.Y/inverse[2][1],0.0,1.0) }
        int parent = world.ActiveCamera != 0 ? world.ParentOf(world.ActiveCamera) | 0
        if parent != 0 { focus = world.WorldPosition(parent) }
        if ProbeEpoch != epoch { GiMotion.Clear() }
        GiTick++
        BuildProbeLevel(world,focus,parent,epoch,0,2.0)
        BuildProbeLevel(world,focus,parent,epoch,1,8.0)
        ProbeEpoch = epoch
        for s : 0; s < 512; s++ {
            GiWindow[s*4] = GiRoots[s].Key.X
            GiWindow[s*4+1] = GiRoots[s].Key.Y
            GiWindow[s*4+2] = GiRoots[s].Key.Z
            GiWindow[s*4+3] = GiRoots[s].Count
            if GiRoots[s].Count > 0 && GiRoots[s].WakeFrames > 0 { GiWindow[s*4+3] |= 1024 }
        }
        float debugMode = world.DebugProbePositions ? 2.0 | (world.DebugProbeCoverage ? 1.0 | 0.0)
        if world.DebugProbeWeights { debugMode = 3.0 }
        float [4] center = {focus.X,focus.Y,focus.Z,debugMode}
        memcpy(&GiWindow[2048],&center[0],16)
        QuaxelRenderer.WriteProbeWindow(&GiWindow[0])
    }

    -BuildProbeLevel(QuaxelWorld& world,vec3 focus,int player,int epoch,int level,float width)
    {
        int base = level*256
        ivec3 first = ivec3((int)Math.Floor(focus.X/width)-4,(int)Math.Floor(focus.Y/width)-1,(int)Math.Floor(focus.Z/width)-4)
        for s : base; s < base+256; s++ {
            Signatures[s] = (uint)2166136261
            MotionSignatures[s] = (uint)2166136261
        }
        GiInstances.Clear()
        for item : TraceOrder {
            if item.Handle < 0 { continue }
            int volume = world.VolumeOf(item.Node)
            uint pose = HashProbeModel(item.BoxFromWorld,item.Node)
            uint stamp = (pose ^ (uint)volume)*(uint)16777619 ^ (uint)world.VolumeUploadRevision(volume)
            AccumulateGiBounds(first,level,width,item.BoundsCenter,item.BoundsHalf,pose,stamp,item.Node,false,ActorGeometry(world,item.Node,player))
        }
        int mask = QuaxelComponents.Transform | QuaxelComponents.MeshRenderer
        for id : world.NextWith(0,mask); id != 0; id = world.NextWith(id,mask) {
            if world.IsHidden(id) { continue }
            int index = world.MeshOf(id)
            QuaxelMeshData mesh = world.GetMesh(index)
            if mesh.VoxelPrimitive != 0 || mesh.VertexCount == 0 { continue }
            mat4 model = world.ModelMatrix(id)
            vec3 lo
            vec3 hi
            for v : 0; v < mesh.VertexCount; v++ {
                QuaxelVertex vertex = mesh.Vertices[v]
                vec3 p = vec3(model*vec4(vertex.X,vertex.Y,vertex.Z,1.0))
                for k : 0; k < 3; k++ {
                    if v == 0 || p[k] < lo[k] { lo[k] = p[k] }
                    if v == 0 || p[k] > hi[k] { hi[k] = p[k] }
                }
            }
            uint pose = HashProbeModel(model,id)
            AccumulateGiBounds(first,level,width,(hi+lo)*0.5,(hi-lo)*0.5,pose,pose ^ (uint)index,id,true,ActorGeometry(world,id,player))
        }
        for y : 0; y < 4; y++ | z : 0; z < 8; z++ | x : 0; x < 8; x++ {
            ivec3 r = ivec3(first.X+x,first.Y+y,first.Z+z)
            int s = base + GiSlot(r)
            ivec3 old = GiRoots[s].Key
            bool resident = ProbeEpoch == epoch && old.X == r.X && old.Y == r.Y && old.Z == r.Z
            if !resident { GiRoots[s].WakeFrames = 0 }
            else if MotionSignatures[s] != GiRoots[s].MotionSignature { GiRoots[s].WakeFrames = 16 }
            else if GiRoots[s].WakeFrames > 0 { GiRoots[s].WakeFrames-- }
            GiRoots[s].MotionSignature = MotionSignatures[s]
            if !resident || GiRoots[s].Signature != Signatures[s] {
                GiRoots[s].Key = r
                GiRoots[s].Signature = Signatures[s]
                GiRoots[s].Ready = false
                GiRoots[s].Count = 0
            }
            if !GiRoots[s].Ready { GiRoots[s].Waiting++ }
        }
        for job : 0; job < 2; job++ {
            int best = -1
            float priority = -1.0
            for s : base; s < base+256; s++ {
                if GiRoots[s].Ready { continue }
                ivec3 r = GiRoots[s].Key
                vec3 delta = (vec3((float)r.X,(float)r.Y,(float)r.Z)+vec3(0.5,0.5,0.5))*width-focus
                float score = (float)GiRoots[s].Waiting / (1.0+delta.Dot(delta))
                if score > priority {
                    priority = score
                    best = s
                }
            }
            if best < 0 { break }
            BuildProbeRoot(world,best)
            // Spread new geometry-bearing roots across frames as the window scrolls.
            if Signatures[best] != (uint)2166136261 { break }
        }

    }

    -BuildProbeRoot(QuaxelWorld& world,int slot)
    {
        QuaxelProbeTree Placement()
        int level = slot / 256
        int scale = level == 0 ? 1 | 4
        Placement.BeginLevel(GiRoots[slot].Key,scale)
        ivec3 r = GiRoots[slot].Key
        RasterGiInstances(world,Placement,r)
        Placement.FinishTree(0.125*(float)scale,true)
        int [512] cells
        float [2048] positions
        for node : Placement.Cells {
            if node.Probe < 0 { continue }
            int id = node.Probe
            vec3 p = Placement.Probes[id]
            positions[id*4] = p.X
            positions[id*4+1] = p.Y
            positions[id*4+2] = p.Z
            positions[id*4+3] = (float)node.Side * 0.125*(float)scale
            ivec3 low = node.Origin
            for z : low.Z; z < low.Z+node.Side; z+=2 | y : low.Y; y < low.Y+node.Side; y+=2 | x : low.X; x < low.X+node.Side; x+=2 {
                cells[x/2 + 8*(y/2) + 64*(z/2)] = id+1
            }
        }
        int count = (int)Placement.Probes.Len
        QuaxelRenderer.WriteProbeRoot(slot,count,&cells[0],&positions[0])
        GiRoots[slot].Count = count
        GiRoots[slot].Waiting = 0
        GiRoots[slot].Ready = true
    }

    -RasterGiInstances(QuaxelWorld& world, QuaxelProbeTree& Placement, ivec3 r)
    {
        for instance : GiInstances {
            if r.X < instance.Low.X || r.Y < instance.Low.Y || r.Z < instance.Low.Z || r.X > instance.High.X || r.Y > instance.High.Y || r.Z > instance.High.Z { continue }
            if instance.Mesh {
                QuaxelMeshData mesh = world.GetMesh(world.MeshOf(instance.Node))
                Placement.AddMesh(mesh,world.ModelMatrix(instance.Node))
            } else { Placement.AddVolume(world,instance.Node) }
        }
    }
}
T{
    ActorCrossesRootsWithoutChangingPlacement()
    {
        QuaxelWorld world()
        int actor = world.CreateNode()
        int child = world.CreateChild(actor)
        T.IsTrue(ActorGeometry(world,child,actor))
        ivec3 first = ivec3(0,0,0)
        vec3 half = vec3(0.1,0.1,0.1)
        uint initial = (uint)2166136261
        GiMotion.Clear()
        for step : 0; step < 2; step++ {
            GiInstances.Clear()
            for s : 0; s < 256; s++ {
                Signatures[s] = initial
                MotionSignatures[s] = initial
            }
            vec3 center = vec3(1.0+2.0*(float)step,1.0,1.0)
            AccumulateGiBounds(first,0,2.0,center,half,(uint)step,(uint)step,child,false,true)
            T.AreEqual((int)GiInstances.Len,0)
            for s : 0; s < 2; s++ {
                T.IsTrue(Signatures[s] == initial)
                T.AreEqual(MotionSignatures[s] != initial,s == step)
            }
        }
        GiMotion.Clear()
    }
}
