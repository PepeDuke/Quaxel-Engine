QuaxelPlatform
#{}
T{
    NativeFilesRead()
    {
        uint8 [4] bytes
        file source
        T.IsTrue(source.Open("Tests/Fixtures/Small.qvox"))
        T.AreEqual(source.Read(bytes), (long)4)
        T.AreEqual((int)bytes[0], 113) // q
        T.AreEqual((int)bytes[3], 120) // x
        source.Close()
        file missing
        T.IsFalse(missing.Open("Tests/Fixtures/Missing.qvox"))
    }

    HeadlessServicesAreUnavailable()
    {
        T.IsFalse(QuaxelPlatform.SupportsWindowing())
        T.IsFalse(QuaxelRenderer.Start())
        T.AreEqual(QuaxelRenderer.CreateMesh(null, 0, null, 0), -1)
        T.IsFalse(QuaxelRenderer.BeginFrame(null))
        T.IsFalse(QuaxelRenderer.DrawMesh(0, null))
        T.IsFalse(QuaxelRenderer.EndFrame())
        T.IsFalse(QuaxelPlatform.IsKeyDown(87))
        T.IsFalse(QuaxelPlatform.IsKeyDown(-1))
        T.IsFalse(QuaxelPlatform.IsKeyDown(256))
        T.IsFalse(QuaxelPlatform.ConsumeWindowStall())
        T.IsFalse(QuaxelRenderer.DrawUi(0, 0, 1, 1, 0xFFFFFFFF, 0, 0, 0))
        T.IsFalse(QuaxelPlatform.IsMouseButtonDown())
        int mouseX = 99
        int mouseY = 99
        T.IsFalse(QuaxelPlatform.GetMousePosition(mouseX, mouseY))
        T.AreEqual(mouseX, 0)
        T.AreEqual(mouseY, 0)
        QuaxelRenderer.Stop()
        T.IsFalse(QuaxelPlatform.OpenWindow("Headless", 400, 250, false))
        T.IsFalse(QuaxelPlatform.PumpWindow(true))
        int width = 99
        int height = 99
        T.IsFalse(QuaxelPlatform.GetWindowSize(width, height))
        T.AreEqual(width, 0)
        T.AreEqual(height, 0)
        long frequency = 99
        long ticks = 99
        T.IsFalse(QuaxelPlatform.GetClockFrequency(frequency))
        T.AreEqual(frequency, 0)
        T.IsFalse(QuaxelPlatform.ReadClock(ticks))
        T.AreEqual(ticks, 0)
    }
}
