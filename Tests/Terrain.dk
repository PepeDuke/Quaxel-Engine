// Floods every column it is given, which is the worst a module can do to a map.
QuaxelTerrainFloodModule : QuaxelTerrainModule
{
    QuaxelTerrainModuleRules Rules()
    {
        QuaxelTerrainModuleRules rules
        rules.Share = 1.0
        return rules
    }

    Column(QuaxelTerrainSite site, float x, float z, QuaxelTerrainColumn& column) { column.MakeWater(3) }
}

// Picky about the clearings it accepts, to exercise the router.
QuaxelTerrainPickyModule : QuaxelTerrainModule
{
    QuaxelTerrainModuleRules Rules()
    {
        QuaxelTerrainModuleRules rules
        rules.MinRadius = 16.0
        rules.MinPorts = 3
        rules.Isolated = true
        rules.Share = 0.5
        return rules
    }
}

// Offers one spot on the reserved path, which must be refused, then one beside it.
QuaxelTerrainPlacingModule : QuaxelTerrainModule
{
    int Volume

    QuaxelTerrainModuleRules Rules()
    {
        QuaxelTerrainModuleRules rules
        rules.MinRadius = 15.0
        rules.Isolated = true
        rules.Share = 1.0
        return rules
    }

    Place(QuaxelTerrainSite site, QuaxelTerrainPlacer& placer)
    {
        placer.Offer(0, Volume, 0.0, 0.0, 8, 8)
        placer.Offer(1, Volume, -site.PortZ[0] * 9.0, site.PortX[0] * 9.0, 8, 8)
    }
}

QuaxelTerrainTestRouter : QuaxelTerrain
{
    int Selected
    QuaxelTerrainModule Plain
    QuaxelTerrainFloodModule Flood
    QuaxelTerrainPickyModule Picky
    QuaxelTerrainPlacingModule Placing

    int ModuleCount() { return Selected == 0 ? 1 | 2 }

    QuaxelTerrainModuleRules ModuleRules(int id)
    {
        if id == 0 { return Plain.Rules() }
        if Selected == 1 { return Flood.Rules() }
        if Selected == 2 { return Picky.Rules() }
        return Placing.Rules()
    }

    ModuleColumn(int id, QuaxelTerrainSite site, float x, float z, QuaxelTerrainColumn& column)
    {
        if id == 1 && Selected == 1 { Flood.Column(site, x, z, column) }
    }

    ModulePlace(int id, QuaxelTerrainSite site, QuaxelTerrainPlacer& placer)
    {
        if id == 1 && Selected == 3 { Placing.Place(site, placer) }
    }

    vec3 FirstRoutedSite()
    {
        for i : 0; i < Layout.Sites.Len; i++ {
            if Layout.Sites[i].Module == 1 { return WorldPoint(Layout.Sites[i].X, Layout.Sites[i].Z) }
        }
        return vec3(0.0, 0.0, 0.0)
    }
}
T{
    RouterHonorsEveryRuleAndKeepsSpawnPlain()
    {
        for seed : 1; seed <= 6; seed++ {
            QuaxelTerrainConfig config
            config.Seed = (uint)seed
            QuaxelTerrainTestRouter terrain()
            terrain.Selected = 2
            T.IsTrue(terrain.Configure(config))
            T.AreEqual(terrain.Layout.Sites[terrain.SpawnSiteIndex].Module, 0)
            for i : 0; i < terrain.Layout.Sites.Len; i++ {
                if terrain.Layout.Sites[i].Module != 1 { continue }
                T.IsTrue(terrain.Layout.Sites[i].PortCount >= 3)
                T.IsTrue(terrain.Layout.Sites[i].Radius >= 16.0)
                for other : 0; other < terrain.Layout.Sites.Len; other++ {
                    if other == i { continue }
                    float gap = Math.Hypot(terrain.Layout.Sites[other].X - terrain.Layout.Sites[i].X, terrain.Layout.Sites[other].Z - terrain.Layout.Sites[i].Z)
                    T.IsTrue(gap >= terrain.Layout.Sites[i].Radius + terrain.Layout.Sites[other].Radius - 0.001)
                }
            }
        }
    }

    AChunkIsTheSameWhicheverOrderItIsBuiltIn()
    {
        QuaxelTerrainConfig config
        config.Seed = (uint)4
        QuaxelWorld firstWorld()
        QuaxelWorld secondWorld()
        QuaxelTerrain first()
        QuaxelTerrain second()
        T.IsTrue(first.Configure(config) && second.Configure(config))
        T.IsTrue(first.Start(firstWorld, vec3(0.0, 0.0, 0.0)))
        // Column 200 is chunk 1, second-nearest here and third-ring there.
        T.IsTrue(second.Start(secondWorld, vec3(40.0, 0.0, 16.0)))
        for column : 128; column < 256; column++ {
            for row : 0; row < 128; row++ {
                T.AreEqual(first.ColumnHeight(column, row), second.ColumnHeight(column, row))
                T.AreEqual(first.ColumnKind(column, row), second.ColumnKind(column, row))
            }
        }
    }

    MountainsNeverRiseAboveTheLipOverOpenGround()
    {
        QuaxelTerrainConfig config
        config.Seed = (uint)2
        QuaxelWorld world()
        QuaxelTerrain terrain()
        T.IsTrue(terrain.Configure(config) && terrain.Start(world, vec3(0.0, 0.0, 0.0)))
        int open = 0
        for column : -128; column < 128; column += 2 {
            for row : -128; row < 128; row += 2 {
                if terrain.ColumnKind(column, row) != QuaxelTerrainKind.Open { continue }
                open++
                int height = terrain.ColumnHeight(column, row)
                for k : 1; k <= 80; k++ {
                    if terrain.ColumnKind(column + k, row + k) == QuaxelTerrainKind.Mountain {
                        T.IsTrue(terrain.ColumnHeight(column + k, row + k) - k <= height + config.Lip)
                    }
                }
            }
        }
        T.IsTrue(open > 1000)
    }

    BlockedColumnsLookBlocked()
    {
        QuaxelTerrainConfig config
        QuaxelWorld world()
        QuaxelTerrain terrain()
        T.IsTrue(terrain.Configure(config) && terrain.Start(world, vec3(0.0, 0.0, 0.0)))
        // Next to open ground a mountain column must stand above it by the lip,
        // apart from columns the view ceiling pulled down.
        int walls = 0
        for column : -300; column < 380; column++ {
            for row : -300; row < 380; row++ {
                if terrain.ColumnKind(column, row) != QuaxelTerrainKind.Mountain { continue }
                if terrain.ColumnKind(column + 1, row) == QuaxelTerrainKind.Open {
                    T.IsTrue(terrain.ColumnHeight(column, row) >= terrain.ColumnHeight(column + 1, row) + config.Lip - 2)
                    walls++
                }
            }
        }
        T.IsTrue(walls > 10)
    }

    ReservedPathsSurviveAModuleThatFloodsEverything()
    {
        QuaxelTerrainConfig config
        config.Seed = (uint)3
        QuaxelWorld world()
        QuaxelTerrainTestRouter terrain()
        terrain.Selected = 1
        T.IsTrue(terrain.Configure(config))
        T.IsTrue(terrain.Start(world, terrain.FirstRoutedSite()))
        int checked = 0
        for p : 0; p < terrain.Layout.Passes.Len; p++ {
            QuaxelTerrainPass pass = terrain.Layout.Passes[p]
            for t : 0; t <= 40; t++ {
                float share = (float)t / 40.0
                vec3 point = terrain.WorldPoint(Math.Lerp(pass.AX, pass.BX, share), Math.Lerp(pass.AZ, pass.BZ, share))
                kind : terrain.ColumnKind(terrain.ColumnAt(point.X), terrain.ColumnAt(point.Z))
                if kind == QuaxelTerrainKind.Unloaded { continue }
                T.AreEqual(kind, QuaxelTerrainKind.Open)
                checked++
            }
        }
        T.IsTrue(checked > 20)
        int water = 0
        vec3 center = terrain.FirstRoutedSite()
        for column : -120; column < 120; column++ {
            int a = terrain.ColumnAt(center.X) + column
            int b = terrain.ColumnAt(center.Z)
            if terrain.ColumnKind(a, b) == QuaxelTerrainKind.Water { water++ }
        }
        T.IsTrue(water > 20)
    }

    PlacementsAreRefusedOnReservedPathsAndBlockTheirFootprint()
    {
        QuaxelTerrainConfig config
        config.Seed = (uint)6
        QuaxelWorld world()
        QuaxelTerrainTestRouter terrain()
        terrain.Selected = 3
        terrain.Placing.Volume = world.CreateVolume(16, 8, 16)
        T.IsTrue(terrain.Configure(config))
        T.IsTrue(terrain.Placements.Len > 0)
        vec3 focus = terrain.FirstRoutedSite()
        T.IsTrue(terrain.Start(world, focus))
        for i : 0; i < terrain.Placements.Len; i++ {
            int site = terrain.Placements[i].Site
            T.AreEqual(terrain.Layout.Sites[site].Module, 1)
            // The offer at the center sits on every reserved path, so only the second may pass.
            vec3 center = terrain.WorldPoint(terrain.Layout.Sites[site].X, terrain.Layout.Sites[site].Z)
            vec3 placed = terrain.PlacementPosition(i)
            T.IsTrue(Math.Hypot(placed.X - center.X, placed.Z - center.Z) > 5.0)
        }
        int structures = 0
        for column : -320; column < 320; column++ {
            int offset = terrain.ColumnAt(focus.X) + column
            for row : -320; row < 320; row += 8 {
                if terrain.ColumnKind(offset, terrain.ColumnAt(focus.Z) + row) == QuaxelTerrainKind.Structure { structures++ }
            }
        }
        T.IsTrue(structures > 0)
    }

    WalkersStopAtMountainsAndSlideAlongThem()
    {
        QuaxelTerrainConfig config
        QuaxelWorld world()
        QuaxelTerrain terrain()
        T.IsTrue(terrain.Configure(config) && terrain.Start(world, vec3(0.0, 0.0, 0.0)))
        vec3 position = vec3(0.0, 0.0, 0.0)
        T.IsFalse(terrain.CircleBlocked(0.0, 0.0, 0.5))
        for i : 0; i < 4000; i++ { position = terrain.MoveCircle(position, vec3(0.0667, 0.0, 0.0), 0.5) }
        T.IsTrue(position.X > 5.0)
        T.IsFalse(terrain.CircleBlocked(position.X, position.Z, 0.5))
        vec3 again = terrain.MoveCircle(position, vec3(0.0667, 0.0, 0.0), 0.5)
        T.AreEqual(again.X, position.X)
        vec3 up = terrain.MoveCircle(position, vec3(0.0667, 0.0, 0.0667), 0.5)
        vec3 down = terrain.MoveCircle(position, vec3(0.0667, 0.0, -0.0667), 0.5)
        T.IsTrue(up.Z != position.Z || down.Z != position.Z)
    }

    TheSpawnSitsAtTheWorldOriginOnGroundLevel()
    {
        for seed : 1; seed <= 4; seed++ {
            QuaxelTerrainConfig config
            config.Seed = (uint)seed
            QuaxelWorld world()
            QuaxelTerrain terrain()
            T.IsTrue(terrain.Configure(config) && terrain.Start(world, vec3(0.0, 0.0, 0.0)))
            T.AreEqual(terrain.ColumnKind(0, 0), QuaxelTerrainKind.Open)
            T.IsTrue(Math.Abs(terrain.GroundY(0.0, 0.0)) <= 0.25)
        }
    }

    UnbuiltGroundIsBlocked()
    {
        QuaxelTerrainConfig config
        QuaxelWorld world()
        QuaxelTerrain terrain()
        T.IsTrue(terrain.Configure(config) && terrain.Start(world, vec3(0.0, 0.0, 0.0)))
        T.AreEqual(terrain.ColumnKind(100000, 0), QuaxelTerrainKind.Unloaded)
        T.IsTrue(terrain.IsBlocked(5000.0, 0.0))
        T.AreEqual(terrain.GroundY(5000.0, 0.0), 0.0)
    }

    StreamingFollowsTheFocusWithoutGrowingThePool()
    {
        QuaxelTerrainConfig config
        QuaxelWorld world()
        QuaxelTerrain terrain()
        T.IsTrue(terrain.Configure(config) && terrain.Start(world, vec3(0.0, 0.0, 0.0)))
        int nodes = world.NodeCount
        vec3 focus = vec3(16.0, 0.0, 0.0)
        T.IsFalse(terrain.IsReady(focus))
        int calls = 0
        while !terrain.IsReady(focus) && calls < 100000 {
            T.IsTrue(terrain.Stream(world, focus, 4000))
            calls++
        }
        T.IsTrue(terrain.IsReady(focus))
        T.IsTrue(calls > 3)
        T.AreEqual(terrain.ChunkCount, QuaxelTerrain.ResidentChunks)
        T.AreEqual(world.NodeCount, nodes)
        // Chunk 3 arrived and chunk -2 made room for it.
        T.AreNotEqual(terrain.ColumnKind(3 * 128, 0), QuaxelTerrainKind.Unloaded)
        T.AreEqual(terrain.ColumnKind(-2 * 128, 0), QuaxelTerrainKind.Unloaded)
    }
}
