version = 1
references = ["Quaxel.dkp"]

[project]
name = "QuaxelHeadless"
kind = "library"
build_dir = ".duck/build/headless"

[modules.quaxel_platform]
sources = ["Source/Platform/Api/**/*.dk", "Tests/Headless.dk"]
depends = ["quaxel_platform_backend"]

[modules.quaxel_engine]
sources = ["Source/Engine/**/*.dk", "Tests/HeadlessEngine.dk"]
depends = ["quaxel_core", "quaxel_platform"]

[modules.quaxel_platform_backend]
sources = ["Source/Platform/Headless/**/*.dk"]
